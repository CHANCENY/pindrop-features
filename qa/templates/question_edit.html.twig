{% extends '@qa/base.html.twig' %}
{% block content %}
<div class="qa-card" style="max-width:760px; margin:0 auto;">
    <h1>Edit Question</h1>

    <form class="qa-form" method="post" action="/questions/{{ question.id }}/edit">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="{{ question.title }}" required>
        {% if errors.title is defined %}<div class="qa-error">{{ errors.title }}</div>{% endif %}

        <label for="body">Body</label>
        <textarea id="body" name="body" rows="12" required>{{ question.body }}</textarea>
        {% if errors.body is defined %}<div class="qa-error">{{ errors.body }}</div>{% endif %}

        <label for="tags">Tags</label>
        <input type="text" id="tags" name="tags" value="{{ tag_string }}" placeholder="php, laravel, ubuntu">

        <label for="meta_description">Meta description</label>
        <input type="text" id="meta_description" name="meta_description" value="{{ question.meta_description }}" maxlength="255">

        <button type="submit" class="qa-btn qa-btn--primary" style="margin-top:18px;">Save Changes</button>
    </form>
</div>
{% endblock %}
