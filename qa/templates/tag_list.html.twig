{% extends '@qa/base.html.twig' %}
{% block content %}
<div class="qa-page-header"><h1>Tags</h1></div>
<div class="qa-card" style="display:flex; flex-wrap:wrap; gap:12px;">
    {% for tag in tags %}
        <div class="qa-card" style="width:220px;">
            <a class="qa-tag-pill" href="/tag/{{ tag.slug }}">{{ tag.name }}</a>
            <p class="qa-question-excerpt">{{ tag.description|default('No description yet.') }}</p>
            <div class="qa-meta-line">{{ tag.questions_count }} questions</div>
        </div>
    {% else %}
        <div class="qa-empty-state">No tags yet.</div>
    {% endfor %}
</div>
{% endblock %}
