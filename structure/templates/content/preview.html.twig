{% extends "templates/base.twig" %}

{% block head %}

    <link rel="stylesheet" href="/modules/structure/assets/styles.css">

{% endblock %}

{% block content %}

    <div class="drupal-node-view-container">

        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1>View {{ node.entityDefinition.name|split('.')|last|capitalize }}: <span style="color: #666;">{{ node.title }}</span></h1>
                <p style="color: #888; margin-top: 5px; font-size: 0.85rem;">
                    Created by <strong>{{ node.author.username|default('Unknown') }}</strong> on {{ node.createdAt|date('F j, Y - H:i') }}
                </p>
            </div>
            <div class="header-actions">
                <a href="{{ url('admin.content.add.node',{type: type}) }}" class="btn btn-primary"><i class="fas fa-edit"></i> Edit</a>
                <a href="{{ url('admin.content.add.node.new.submitted.preview.save',{sessionId: sessionId}) }}" class="btn"><i class="fas fa-history"></i> Save</a>
                <a href="{{ url('admin.content.add.node.preview.delete',{sessionId: sessionId}) }}" class="btn" style="color: #d9534f; border-color: #d43f3a;">Delete</a>

            </div>
        </div>

        <div class="node-view-layout">

            <!-- MAIN CONTENT AREA -->
            <div class="node-main-content">

                <!-- Main Information Section -->
                <div class="node-section">
                    <h3>Main Information</h3>
                    <div class="view-grid">
                        <div class="view-item full-width">
                            <div class="field-label">Title</div>
                            <div class="field-value title-value">{{ node.title }}</div>
                        </div>

                        {% if node.values.body is defined %}
                            <div class="view-item full-width" style="border-bottom: none;">
                                <div class="field-label">Body</div>
                                <div class="field-value">
                                    {% set body_data = node.values.body.default.value|default(node.values.body.default.values|default([])) %}
                                    {% if body_data is iterable %}
                                        {{ body_data|join('<br>')|raw }}
                                    {% else %}
                                        {{ body_data|raw }}
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Dynamic Fields Section -->
                <div class="node-section">
                    <h3>Content Fields</h3>
                    <div class="view-grid">
                        {% for field_name, field_def in node.entityDefinition.fields %}
                            {# Skip title and body as they are handled above #}
                            {% if field_name != 'title' and field_name != 'body' %}
                                <div class="view-item {{ loop.index is odd ? 'half-width' : 'half-width' }}">
                                    <div class="field-label">{{ field_def.label|default(field_name|capitalize) }}</div>
                                    <div class="field-value">
                                        {% set field_data = node.values[field_name].default|default(null) %}
                                        {% if field_data %}
                                            {% if field_data.values is defined %}
                                                <ul>
                                                    {% for val in field_data.values %}
                                                        <li>{{ val }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% elseif field_data.value is defined %}
                                                {{ field_data.value }}
                                            {% else %}
                                                <span style="color: #999; font-style: italic;">No value</span>
                                            {% endif %}
                                        {% else %}
                                            <span style="color: #999; font-style: italic;">No value</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

            </div>

            <!-- SIDEBAR AREA -->
            <div class="node-sidebar">

                <!-- Publishing Information -->
                <div class="node-section">
                    <h3>Publishing Status</h3>
                    <div class="view-grid" style="grid-template-columns: 1fr;">
                        <div class="view-item" style="border-right: none;">
                            <div class="field-label">Status</div>
                            <div class="field-value">
                                {% if node.status %}
                                    <span class="status-badge status-published">Published</span>
                                {% else %}
                                    <span class="status-badge status-draft">Draft</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="view-item" style="border-right: none; border-bottom: none;">
                            <div class="field-label">Type</div>
                            <div class="field-value">{{ node.type|capitalize }}</div>
                        </div>
                    </div>
                </div>

                <!-- Authoring Information -->
                <div class="node-section">
                    <h3>Authoring Details</h3>
                    <div class="view-grid" style="grid-template-columns: 1fr;">
                        <div class="view-item" style="border-right: none;">
                            <div class="field-label">Authored by</div>
                            <div class="field-value">{{ node.author }}</div>
                        </div>
                        <div class="view-item" style="border-right: none; border-bottom: none;">
                            <div class="field-label">Last Updated</div>
                            <div class="field-value">{{ node.updatedAt|date('Y-m-d H:i') }}</div>
                        </div>
                    </div>
                </div>

                <!-- Metadata -->
                <div class="node-section">
                    <h3>Metadata</h3>
                    <div class="view-grid" style="grid-template-columns: 1fr;">
                        <div class="view-item" style="border-right: none;">
                            <div class="field-label">NID</div>
                            <div class="field-value">{{ node.nid }}</div>
                        </div>
                        <div class="view-item" style="border-right: none; border-bottom: none;">
                            <div class="field-label">UUID</div>
                            <div class="field-value" style="font-size: 0.75rem; word-break: break-all; color: #666;">
                                {{ node.uuid|default('N/A') }}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>

{% endblock %}

