{% extends "templates/base.twig" %}

{% block head %}

    <link rel="stylesheet" href="/modules/structure/assets/styles.css">

{% endblock %}

{% block content %}

    <!-- Admin Wrapper -->
    <div class="admin-wrapper">

        <!-- Breadcrumbs -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li>
                    <a href="{{ url('admin.home') }}">Home</a>
                    <span>/</span>
                </li>
                <li>
                    <a href="{{ url('admin.dashboard') }}">Administration</a>
                </li>
            </ol>
        </nav>

        <!-- Page Header -->
        <div class="page-header">
            <h1>Structure</h1>
        </div>

        <!-- Structure List Container -->
        <div class="structure-list-container">
            <ul>
                <!-- Content Types -->
                {% for structure in structures %}
                <li>
                    <div>
                        <a href="{{ structure.getUrl }}">{{ structure.getName }}</a>
                        <p>{{ structure.getDescription }}</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>

        <!-- Help Section -->
        <div class="help-section">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="font-medium">About Structure</p>
                    <p class="mt-1">
                        The Structure section allows you to manage all the structural components of your site, from how content is organized (Taxonomy) to how it is displayed (Views and Block Layout).
                    </p>
                </div>
            </div>
        </div>
    </div>


{% endblock %}