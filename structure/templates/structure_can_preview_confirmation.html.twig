
{#

we have variables

  string: title
  string: question
    array: links
       - confirm link
       - cancel link
    array: lists (simple array to show in li)


#}
{% extends "templates/base.twig" %}


{% block content %}
<div class="confirmation-wrapper">

    {% if title %}
        <h2 class="confirmation-title">{{ title }}</h2>
    {% endif %}

    {% if question %}
        <p class="confirmation-question">{{ question }}</p>
    {% endif %}

    {% if lists is not empty %}
        <ul class="confirmation-list">
            {% for item in lists %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if links is not empty %}
        <div class="confirmation-actions">

            {% if links.confirm is defined %}
                <a href="{{ links.confirm }}" class="btn btn-primary">
                    Preview
                </a>
            {% endif %}

            {% if links.cancel is defined %}
                <a href="{{ links.cancel }}" class="btn btn-secondary">
                    Save
                </a>
            {% endif %}

        </div>
    {% endif %}

</div>

{% endblock %}

{% block head %}

<style>
    .confirmation-wrapper {
        margin: 2rem auto;
        padding: 1.5rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        background: #ffffff;
    }

    .confirmation-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: #111827;
    }

    .confirmation-question {
        font-size: 1rem;
        color: #374151;
        margin-bottom: 1rem;
    }

    .confirmation-list {
        margin: 0 0 1.25rem 1.25rem;
        padding: 0;
        color: #4b5563;
    }

    .confirmation-list li {
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }

    .confirmation-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    /* Buttons */
    .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        border-radius: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

    /* Primary (Confirm) */
    .btn-primary {
        background-color: #2563eb;
        color: #ffffff;
    }

    .btn-primary:hover {
        background-color: #1d4ed8;
    }

    /* Secondary (Cancel) */
    .btn-secondary {
        background-color: #f3f4f6;
        color: #111827;
        border-color: #d1d5db;
    }

    .btn-secondary:hover {
        background-color: #e5e7eb;
    }
</style>
{% endblock %}