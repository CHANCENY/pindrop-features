{% extends "templates/base.twig" %}


{% block head %}

    <link rel="stylesheet" href="/modules/structure/assets/styles.css">
    <link rel="stylesheet" href="/modules/structure/assets/fields.css">
{% endblock %}


{% block content %}

    <div class="drupal-manage-fields-container">

        <!-- Breadcrumbs -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="{{ url('admin.home') }}">Home</a><span>/</span></li>
                <li><a href="{{ url('admin.dashboard') }}">Administration</a><span>/</span></li>
                <li><a href="{{ url('structure.structures') }}">Structure</a><span>/</span></li>
                <li><a href="{{ url('structure.structures.content.types') }}">Content types</a><span>/</span></li>
                <li><a href="{{ url('structure.structures.content.types.edit',{id: type.config.machine_name }) }}">Edit Content type</a></li>
            </ol>
        </nav>

        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title">
                <h1>Manage Fields</h1>
                <p>Define and organize the fields for your content type</p>
            </div>
            <div class="page-actions">
                <a href="{{ url('structure.structures.content.types.manage.fields.add',{id: type.config.machine_name }) }}" class="btn btn-primary">Add New Field</a>
            </div>
        </div>

        <!-- Existing Fields Table Section -->
        <div class="view-section">
            <h3>Existing Fields</h3>
            <div class="table-responsive">
                <table>
                    <thead>
                    <tr>
                        <th>Label</th>
                        <th>Machine Name</th>
                        <th>Field Type</th>
                        <th>Status</th>
                        <th style="text-align: right;">Operations</th>
                    </tr>
                    </thead>
                    <tbody>

                    {% for field in fields %}

                        {% if field.deleted != 1 %}
                    <tr>
                        <td style="font-weight: 700;">{{ field.config.label }}</td>
                        <td><code>{{ field.config.name }}</code></td>
                        <td><span class="badge">{{ field.config.struct_type|upper }}</span></td>
                        {% if field.config.settings.status == true %}
                        <td><span style="color: #2e7d32;">Active</span></td>
                        {% else %}
                            <td><span style="color: #7A1C0A;">Disabled</span></td>
                         {% endif %}
                        <td style="text-align: right;">
                            <a href="{{ url('structure.structures.content.types.manage.fields.add.field.setting.edit',{
                                id: type.config.machine_name,
                                type: field.config.struct_type,
                                name: field.config.name
                            }) }}" class="btn btn-sm">Edit</a>
                            <a href="{{ url('structure.structures.content.types.manage.fields.add.field.setting.delete',{
                                id: type.config.machine_name,
                                type: field.config.struct_type,
                                name: field.config.name
                            }) }}" class="btn btn-sm" style="color: #c62828;">Delete</a>
                        </td>
                    </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>


{% endblock %}