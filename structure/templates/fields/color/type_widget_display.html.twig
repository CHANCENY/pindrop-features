<div class="drupal-color-display-settings">
    <div class="form-section">
        <h3>Display Settings</h3>
        <div class="form-grid">
            <div class="form-item full-width">
                <p>Color field display settings will be rendered here when viewing content.</p>
                <p>Example: <span style="display: inline-block; width: 20px; height: 20px; background-color: {{ field.config.defaultColor|default('#000000') }}; border: 1px solid #ccc;"></span> {{ field.config.defaultColor|default('#000000') }}</p>
            </div>
        </div>
    </div>
</div>
