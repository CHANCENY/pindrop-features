<div class="drupal-detail-settings-container">

    <!-- Page Header -->
    <div class="page-header">
        <h1>Details Field Settings</h1>
        <p>Configure the specific settings for the <strong>{{ field.config.label|default('Details') }}</strong> field.</p>
    </div>

        <!-- Field Storage Settings -->
        <div class="form-section">
            <h3>Details Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Summary -->
                <div class="form-item full-width">
                    <label for="summary">Summary Text *</label>
                    <input type="text" id="summary" name="summary" value="{{ field.config.summary|default('Click to expand') }}" required>
                    <div class="help-text">The summary text that users click to expand/collapse the details.</div>
                </div>

                <!-- Row 2: Open by Default -->
                <div class="form-item half-width">
                    <label for="open">Open by Default</label>
                    <div style="display: flex; align-items: center; gap: 10px; height: 40px;">
                        <input type="checkbox" id="open" name="open" {{ field.config.open == true ? 'checked' : '' }}>
                        <span style="font-size: 0.9rem; color: #666;">Start with the details expanded.</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- Global Field Settings -->
        <div class="form-section">
            <h3>Field Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Help Text -->
                <div class="form-item full-width" style="border-bottom: none;">
                    <label for="help_text">Help Text</label>
                    <textarea id="help_text" name="help_text" rows="2" placeholder="Instructions for this details section.">{{ field.config.helpText }}</textarea>
                    <div class="help-text">This text will be displayed below the details summary on the entry form.</div>
                </div>

            </div>
        </div>
</div>
