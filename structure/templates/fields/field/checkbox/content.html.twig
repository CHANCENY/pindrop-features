{# Checkbox Field Content Template #}
{# settings: field definition settings array #}
{# values: array of one or more values #}

{% if values is not empty %}
    {% if values is iterable %}
        {# Handle multiple values #}
        {% for value in values %}
            <div class="field-value field-value-checkbox-{{ settings.name }} {% if settings.class is defined %} {{ settings.class }}{% endif %}">
                <p>
                    {% if settings.multiple is defined and settings.multiple %}
                        {# Multiple checkboxes - display label #}
                        {% set label_found = false %}
                        {% for option in settings.options %}
                            {% if option.value == value %}
                                {{ option.label|e }}
                                {% set label_found = true %}
                            {% endif %}
                        {% endfor %}
                        {% if not label_found %}
                            {{ value|e }}
                        {% endif %}
                    {% else %}
                        {# Single checkbox - display checked/unchecked status #}
                        {% if value %}
                            {% if settings.checked_label is defined %}
                                {{ settings.checked_label|e }}
                            {% else %}
                                Checked
                            {% endif %}
                        {% else %}
                            {% if settings.unchecked_label is defined %}
                                {{ settings.unchecked_label|e }}
                            {% else %}
                                Unchecked
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </p>
            </div>
        {% endfor %}
    {% endif %}
{% endif %}
