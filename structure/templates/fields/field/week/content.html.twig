{# Week Field Content Template #}
{# settings: field definition settings array #}
{# values: array of one or more values #}

{% if values is not empty %}
    {% if values is iterable %}
        {# Handle multiple values #}
        {% for value in values %}
            <div class="field-value field-value-week-{{ settings.name }} {% if settings.class is defined %} {{ settings.class }}{% endif %}">
               <p>
                   {% if value is not empty %}
                       {% if settings.date_format is defined %}
                           {{ value|date(settings.date_format) }}
                       {% else %}
                           {{ value }}
                       {% endif %}
                   {% else %}
                       &mdash;
                   {% endif %}
               </p>
            </div>
        {% endfor %}
    {% endif %}
{% endif %}
