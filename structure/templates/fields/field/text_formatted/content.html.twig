{# Text Formatted Field Content Template #}
{# settings: field definition settings array #}
{# values: array of one or more values #}
{% if values is not empty %}
    {% if values is iterable %}
        {# Handle multiple values #}
        {% for value in values %}
            <div class="field-value field-value-text-formatted{% if settings.class is defined %} {{ settings.class }}{% endif %}">
                {% if settings.settings.text_processing == 'html' %}
                    {# Allow HTML content #}
                    {{ value|raw }}
                {% else %}
                    {# Apply text formatting #}
                    {{ value }}
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
{% endif %}
