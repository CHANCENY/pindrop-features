{# Date Field Content Template #}
{# settings: field definition settings array #}
{# values: array of one or more values #}

{% if values is not empty %}
    {% if values is iterable %}
        {# Handle multiple values #}
        {% for value in values %}
            <div class="field-value field-value-date-{{ settings.name }} {% if settings.class is defined %} {{ settings.class }}{% endif %}">
                <p>
                    {% if settings.format is defined %}
                        {{ value|date(settings.format) }}
                    {% else %}
                        {{ value|date('Y-m-d') }}
                    {% endif %}
                </p>
            </div>
        {% endfor %}
    {% endif %}
{% endif %}
