<div class="drupal-reset-display-settings">
    <div class="form-section">
        <h3>Display Settings</h3>
        <div class="form-grid">
            <div class="form-item full-width">
                <p>Reset button field display settings will be rendered here when viewing content.</p>
                <p>Example: <button class="btn btn-{{ field.config.buttonStyle|default('secondary') }}">{{ field.config.buttonText|default('Reset') }}</button></p>
            </div>
        </div>
    </div>
</div>
