<div class="drupal-date-settings-container">

    <!-- Page Header -->
    <div class="page-header">
        <h1>Date Field Settings</h1>
        <p>Configure the specific settings for the <strong>{{ field.config.label|default('Date') }}</strong> field.</p>
    </div>

        <!-- Field Storage Settings -->
        <div class="form-section">
            <h3>Date Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Minimum Date -->
                <div class="form-item half-width">
                    <label for="min">Minimum Date</label>
                    <input type="date" id="min" name="min" value="{{ field.config.min|default('') }}">
                    <div class="help-text">The earliest date that can be selected.</div>
                </div>

                <!-- Row 1: Maximum Date -->
                <div class="form-item half-width">
                    <label for="max">Maximum Date</label>
                    <input type="date" id="max" name="max" value="{{ field.config.max|default('') }}">
                    <div class="help-text">The latest date that can be selected.</div>
                </div>

            </div>
        </div>

        <!-- Global Field Settings -->
        <div class="form-section">
            <h3>Field Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Required -->
                <div class="form-item half-width">
                    <label for="required">Required Field</label>
                    <div style="display: flex; align-items: center; gap: 10px; height: 40px;">
                        <input type="checkbox" id="required" name="required" {{ field.config.required == true ? 'checked' : '' }}>
                        <span style="font-size: 0.9rem; color: #666;">Users must select a date.</span>
                    </div>
                </div>

                <!-- Row 1: Default Value -->
                <div class="form-item half-width">
                    <label for="default_value">Default Value</label>
                    <input type="date" id="default_value" name="defaultValue" value="{{ field.config.defaultValue }}">
                    <div class="help-text">A date to be used if the user leaves the field empty.</div>
                </div>

                <!-- Row 2: Help Text -->
                <div class="form-item full-width" style="border-bottom: none;">
                    <label for="help_text">Help Text</label>
                    <textarea id="help_text" name="help_text" rows="2" placeholder="Instructions for the user when selecting a date.">{{ field.config.helpText }}</textarea>
                    <div class="help-text">This text will be displayed below the field on the entry form.</div>
                </div>

            </div>
        </div>
</div>
