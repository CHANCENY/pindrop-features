<div class="drupal-number-display-settings">
    <div class="form-section">
        <h3>Display Settings</h3>
        <div class="form-grid">
            <div class="form-item full-width">
                <p>Number field display settings will be rendered here when viewing content.</p>
                <p>Example: <strong>{{ field.config.prefix|default('') }}123.45{{ field.config.suffix|default('') }}</strong></p>
            </div>
        </div>
    </div>
</div>
