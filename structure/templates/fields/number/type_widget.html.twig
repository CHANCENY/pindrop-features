<div class="drupal-number-settings-container">

    <!-- Page Header -->
    <div class="page-header">
        <h1>Number Field Settings</h1>
        <p>Configure the specific settings for the <strong>{{ field.config.label|default('Number') }}</strong> field.</p>
    </div>

        <!-- Field Storage Settings -->
        <div class="form-section">
            <h3>Storage Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Minimum Value -->
                <div class="form-item half-width">
                    <label for="min">Minimum Value</label>
                    <input type="number" id="min" name="min" value="{{ field.config.min|default('') }}" step="any">
                    <div class="help-text">The minimum allowed value for this field.</div>
                </div>

                <!-- Row 1: Maximum Value -->
                <div class="form-item half-width">
                    <label for="max">Maximum Value</label>
                    <input type="number" id="max" name="max" value="{{ field.config.max|default('') }}" step="any">
                    <div class="help-text">The maximum allowed value for this field.</div>
                </div>

                <!-- Row 2: Step -->
                <div class="form-item half-width">
                    <label for="step">Step</label>
                    <input type="number" id="step" name="step" value="{{ field.config.step|default('1') }}" min="any">
                    <div class="help-text">The increment/decrement step for the field. Use "any" for decimal values.</div>
                </div>

                <!-- Row 2: Prefix -->
                <div class="form-item half-width">
                    <label for="prefix">Prefix</label>
                    <input type="text" id="prefix" name="prefix" value="{{ field.config.prefix|default('') }}" placeholder="$">
                    <div class="help-text">Text to display before the number (e.g., $, €, #).</div>
                </div>

                <!-- Row 3: Suffix -->
                <div class="form-item half-width">
                    <label for="suffix">Suffix</label>
                    <input type="text" id="suffix" name="suffix" value="{{ field.config.suffix|default('') }}" placeholder="kg">
                    <div class="help-text">Text to display after the number (e.g., kg, %, items).</div>
                </div>

                <!-- Row 3: Placeholder -->
                <div class="form-item half-width">
                    <label for="placeholder">Placeholder</label>
                    <input value="{{ field.config.placeholder }}" type="text" id="placeholder" name="placeholder" placeholder="e.g. 0.00">
                    <div class="help-text">A short hint displayed in the input field before the user enters a value.</div>
                </div>

            </div>
        </div>

        <!-- Global Field Settings -->
        <div class="form-section">
            <h3>Field Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Required -->
                <div class="form-item half-width">
                    <label for="required">Required Field</label>
                    <div style="display: flex; align-items: center; gap: 10px; height: 40px;">
                        <input type="checkbox" id="required" name="required" {{ field.config.required == true ? 'checked' : '' }}>
                        <span style="font-size: 0.9rem; color: #666;">Users must enter a value for this field.</span>
                    </div>
                </div>

                <!-- Row 1: Default Value -->
                <div class="form-item half-width">
                    <label for="default_value">Default Value</label>
                    <input type="number" id="default_value" name="default_value" value="{{ field.config.defaultValue }}" step="any">
                    <div class="help-text">A value to be used if the user leaves the field empty.</div>
                </div>

                <!-- Row 2: Help Text -->
                <div class="form-item full-width" style="border-bottom: none;">
                    <label for="help_text">Help Text</label>
                    <textarea id="help_text" name="help_text" rows="2" placeholder="Instructions for the user when entering data.">{{ field.config.helpText }}</textarea>
                    <div class="help-text">This text will be displayed below the field on the entry form.</div>
                </div>

            </div>
        </div>
</div>
