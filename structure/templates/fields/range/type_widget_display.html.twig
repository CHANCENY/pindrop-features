<div class="drupal-range-display-settings">
    <div class="form-section">
        <h3>Display Settings</h3>
        <div class="form-grid">
            <div class="form-item full-width">
                <p>Range field display settings will be rendered here when viewing content.</p>
                <p>Example: <strong>{{ field.config.defaultValue|default('50') }}</strong> (from {{ field.config.min|default('0') }} to {{ field.config.max|default('100') }})</p>
            </div>
        </div>
    </div>
</div>
