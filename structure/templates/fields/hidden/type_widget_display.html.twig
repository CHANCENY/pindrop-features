<div class="drupal-hidden-display-settings">
    <div class="form-section">
        <h3>Display Settings</h3>
        <div class="form-grid">
            <div class="form-item full-width">
                <p>Hidden field display settings will be rendered here when viewing content.</p>
                <p>Example: <strong>{{ field.config.defaultValue|default('hidden_value') }}</strong> (hidden from users)</p>
            </div>
        </div>
    </div>
</div>
