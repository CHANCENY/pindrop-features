<div class="drupal-hidden-settings-container">

    <!-- Page Header -->
    <div class="page-header">
        <h1>Hidden Field Settings</h1>
        <p>Configure the specific settings for the <strong>{{ field.config.label|default('Hidden') }}</strong> field.</p>
    </div>

        <!-- Field Storage Settings -->
        <div class="form-section">
            <h3>Hidden Field Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Default Value -->
                <div class="form-item full-width">
                    <label for="default_value">Default Value</label>
                    <input type="text" id="default_value" name="defaultValue" value="{{ field.config.defaultValue }}" placeholder="">
                    <div class="help-text">The hidden value that will be submitted with the form.</div>
                </div>

            </div>
        </div>

        <!-- Global Field Settings -->
        <div class="form-section">
            <h3>Field Settings</h3>
            <div class="form-grid">

                <!-- Row 1: Help Text -->
                <div class="form-item full-width" style="border-bottom: none;">
                    <label for="help_text">Help Text</label>
                    <textarea id="help_text" name="help_text" rows="2" placeholder="Notes about this hidden field.">{{ field.config.helpText }}</textarea>
                    <div class="help-text">This text is for administrative purposes only and will not be displayed to users.</div>
                </div>

            </div>
        </div>
</div>
