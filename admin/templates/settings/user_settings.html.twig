<div class="admin-form-group">
    <label for="login_page" class="admin-form-label">Login Page</label>
    <input type="text" id="login_page" name="login_page" value="{{ login_page }}" class="admin-form-input">
    <p class="admin-form-help">Provide the route whose controller can override login</p>
</div>

<div class="admin-form-group">
    <label for="register_page" class="admin-form-label">Register Page</label>
    <input type="text" id="register_page" name="register_page" value="{{ register_page }}" class="admin-form-input">
    <p class="admin-form-help">Provide the route whose controller can override register</p>
</div>

<div class="admin-form-group">
    <label for="forgot_password" class="admin-form-label">Forgot Password Page</label>
    <input type="text" id="forgot_password" name="forgot_password" value="{{ forgot_password }}" class="admin-form-input">
    <p class="admin-form-help">Provide the route whose controller can override forgot password</p>
</div>

