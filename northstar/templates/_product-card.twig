<article class="product-card">
    <a href="/shop/product/{{ product.slug|url_encode }}">
        <div class="product-image">
            {% if product.image_url %}
                <img src="{{ product.image_url }}" alt="{{ product.image_alt }}" loading="lazy">
            {% else %}
                <div class="product-object"></div>
            {% endif %}
        </div>
        <div class="product-info">
            <strong>{{ product.name }}<span class="price">{{ product.display_price }}</span></strong>
            <span>{{ product.category_name|default(product.brand|default('Everyday essentials')) }}</span>
        </div>
    </a>
</article>
