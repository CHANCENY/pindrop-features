{% extends '@northstar/layout.twig' %}
{% set page_title = product.name %}
{% block content %}
    <section class="container breadcrumb"><a href="/shop/all">Shop</a><span>›</span>{{ product.name }}</section>
    <section class="container product-detail">
        <div class="detail-image">
            {% if product.image_url %}
                <img src="{{ product.image_url }}" alt="{{ product.image_alt }}">
            {% else %}
                <div class="art-shape"></div>
            {% endif %}
        </div>
        <div class="detail-copy">
            <div class="eyebrow">{{ product.category_name|default(product.brand|default('Everyday essentials')) }}</div>
            <h1>{{ product.name }}</h1>
            <div class="price-large">{{ product.display_price }}</div>
            {% if product.description %}<p>{{ product.description|nl2br }}</p>{% endif %}
            {% if product.available %}
                <form action="/cart" method="post" class="northstar-form">
                    {% if csrf_token %}<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">{% endif %}
                    <input type="hidden" name="_action" value="add">
                    <fieldset class="northstar-variant-options">
                        <legend class="option-label">Choose an option</legend>
                        <div class="northstar-variant-cards">
                        {% for variant in product.variants %}
                            <label class="northstar-variant-card {{ variant.available_quantity < 1 ? 'unavailable' : '' }}">
                                <input
                                    type="radio"
                                    name="variant_id"
                                    value="{{ variant.id }}"
                                    {% if variant.id == selected_variant_id %}checked{% endif %}
                                    {% if variant.available_quantity < 1 %}disabled{% else %}required{% endif %}
                                >
                                <span class="northstar-variant-card-copy">
                                    <strong>{{ variant.option_label|default('Standard') }}</strong>
                                    <span>{{ variant.display_price }}</span>
                                    {% if variant.available_quantity < 1 %}<small>Sold out</small>{% endif %}
                                </span>
                            </label>
                        {% endfor %}
                        </div>
                    </fieldset>
                    <span class="option-label">Quantity</span>
                    <div class="northstar-product-quantity" data-quantity-stepper>
                        <button class="quantity-step" type="button" data-quantity-decrement aria-label="Decrease quantity">−</button>
                        <label class="visually-hidden" for="quantity">Quantity</label>
                        <input id="quantity" type="number" name="quantity" value="1" min="1" max="99" required>
                        <button class="quantity-step" type="button" data-quantity-increment aria-label="Increase quantity">+</button>
                    </div>
                    <button class="button clay add-button" type="submit">Add to cart</button>
                </form>
            {% else %}
                <p class="stock-note">Currently unavailable</p>
            {% endif %}
            <div class="detail-note">Free shipping over $75 · 30-day easy returns · Ships in 1–2 business days</div>
        </div>
    </section>
    <script>
    (() => {
        document.querySelectorAll('[data-quantity-stepper]').forEach(stepper => {
            const input = stepper.querySelector('input[type="number"]');
            const decrement = stepper.querySelector('[data-quantity-decrement]');
            const increment = stepper.querySelector('[data-quantity-increment]');
            if (!input || !decrement || !increment) return;

            const updateButtons = () => {
                const quantity = Number(input.value);
                decrement.disabled = quantity <= Number(input.min);
                increment.disabled = quantity >= Number(input.max);
            };
            const changeQuantity = amount => {
                const min = Number(input.min);
                const max = Number(input.max);
                const quantity = Number(input.value) || min;
                input.value = String(Math.min(max, Math.max(min, quantity + amount)));
                input.dispatchEvent(new Event('input', {bubbles: true}));
                updateButtons();
            };

            decrement.addEventListener('click', () => changeQuantity(-1));
            increment.addEventListener('click', () => changeQuantity(1));
            input.addEventListener('input', updateButtons);
            updateButtons();
        });
    })();
    </script>
{% endblock %}
