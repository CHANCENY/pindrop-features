{% extends '@northstar/layout.twig' %}
{% set page_title = product.name %}
{% block content %}
    <section class="container breadcrumb"><a href="/shop/all">Shop</a><span>›</span>{{ product.name }}</section>
    <section class="container product-detail">
        <div class="detail-image">
            {% if product.image_url %}
                <img src="{{ product.image_url }}" alt="{{ product.image_alt }}">
            {% else %}
                <div class="art-shape"></div>
            {% endif %}
        </div>
        <div class="detail-copy">
            <div class="eyebrow">{{ product.category_name|default(product.brand|default('Everyday essentials')) }}</div>
            <h1>{{ product.name }}</h1>
            <div class="price-large">{{ product.display_price }}</div>
            {% if product.description %}<p>{{ product.description|nl2br }}</p>{% endif %}
            {% if product.available %}
                <form action="/cart" method="post" class="northstar-form">
                    {% if csrf_token %}<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">{% endif %}
                    <input type="hidden" name="_action" value="add">
                    <label class="option-label" for="variant">Choose an option</label>
                    <select id="variant" name="variant_id" required>
                        {% for variant in product.variants %}
                            <option value="{{ variant.id }}" {% if variant.available_quantity < 1 %}disabled{% endif %}>
                                {{ variant.option_label|default('Standard') }} · {{ variant.display_price }}
                                {% if variant.available_quantity < 1 %}· Sold out{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    <label class="option-label" for="quantity">Quantity</label>
                    <input id="quantity" type="number" name="quantity" value="1" min="1" max="99" required>
                    <button class="button clay add-button" type="submit">Add to cart</button>
                </form>
            {% else %}
                <p class="stock-note">Currently unavailable</p>
            {% endif %}
            <div class="detail-note">Free shipping over $75 · 30-day easy returns · Ships in 1–2 business days</div>
        </div>
    </section>
{% endblock %}
