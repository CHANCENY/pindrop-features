{% extends '@northstar/layout.twig' %}
{% set page_title = 'Payment' %}
{% block content %}
    <section class="container page-title">
        <div class="eyebrow">Step 2 of 3</div>
        <h1>Payment</h1>
        <p>Choose how you’d like to pay. We’ll show your full total before placing the order.</p>
    </section>
    <section class="container northstar-checkout-progress" aria-label="Checkout progress">
        <span class="complete"><b>✓</b> Delivery</span>
        <span class="active"><b>2</b> Payment</span>
        <span><b>3</b> Review</span>
    </section>
    <section class="container form-page checkout-grid northstar-checkout-grid">
        <div class="northstar-payment-processing" role="status" aria-live="polite" aria-hidden="true" hidden>
            <div class="northstar-payment-processing-card">
                <span class="northstar-payment-spinner" aria-hidden="true"></span>
                <strong>Processing secure card payment</strong>
                <span data-processing-message>Please wait while your card details are securely tokenized.</span>
            </div>
        </div>
        <form class="form-card northstar-checkout-form" action="/checkout" method="post">
            {% if csrf_token %}<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">{% endif %}
            <input type="hidden" name="_action" value="review">
            {% if error %}<p class="northstar-message error" role="alert">{{ error }}</p>{% endif %}
            <h2>Payment method</h2>
            {% if payment_methods %}
                <div class="northstar-payment-options">
                    {% for method in payment_methods %}
                        <label class="northstar-payment-option" for="checkout-payment-{{ method.id|e('html_attr') }}">
                            <input type="radio" id="checkout-payment-{{ method.id|e('html_attr') }}" name="payment_method" value="{{ method.id }}" {% if values.payment_method|default(payment_methods[0].id) == method.id %}checked{% endif %} required>
                            <span>
                                <strong>{{ method.label }}</strong>
                                <small>
                                    {% if method.id == 'authorize_net' %}Secure card payment via Authorize.Net
                                    {% elseif method.type == 'offline' %}Payment arranged with the store
                                    {% else %}{{ method.currencies|join(', ') }}{% endif %}
                                </small>
                            </span>
                        </label>
                    {% endfor %}
                </div>
                {% for method in payment_methods %}
                    {% if method.id == 'authorize_net' %}
                        <input type="hidden" name="payment_data[opaque_data_descriptor]" value="{{ values.payment_data.opaque_data_descriptor|default('') }}">
                        <input type="hidden" name="payment_data[opaque_data_value]" value="{{ values.payment_data.opaque_data_value|default('') }}">
                    {% else %}
                        {% for field in method.payment_fields %}
                            {% if field.type != 'hidden' %}
                                <label class="northstar-payment-field" data-payment-provider="{{ method.id }}">
                                    {{ field.label }}
                                    <input type="{{ field.type == 'tel' ? 'tel' : (field.type == 'email' ? 'email' : 'text') }}" name="payment_data[{{ field.name }}]" value="{{ values.payment_data[field.name]|default('') }}" {% if field.required %}required{% endif %}>
                                </label>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                {% if authorize_client %}
                    <fieldset class="authorize-card-fields" data-payment-provider="authorize_net" data-api-login-id="{{ authorize_client.api_login_id|e('html_attr') }}" data-client-key="{{ authorize_client.client_key|e('html_attr') }}" hidden>
                        <legend>Secure card payment</legend>
                        <p>Card details are tokenized directly by Authorize.Net and are not sent to this store.</p>
                        <label>Card number<input type="text" inputmode="numeric" autocomplete="cc-number" data-card-number></label>
                        <div class="authorize-card-grid">
                            <label>Expiry month<input type="text" inputmode="numeric" autocomplete="cc-exp-month" maxlength="2" data-card-month></label>
                            <label>Expiry year<input type="text" inputmode="numeric" autocomplete="cc-exp-year" maxlength="4" data-card-year></label>
                        </div>
                        <label>Security code<input type="password" inputmode="numeric" autocomplete="cc-csc" maxlength="4" data-card-code></label>
                        <p class="authorize-card-error" role="alert" data-card-error hidden></p>
                    </fieldset>
                {% endif %}
                <button class="button clay" type="submit">Review your order</button>
            {% else %}
                <p class="empty-state">Online checkout is not available yet. Please contact the store to place an order.</p>
            {% endif %}
        </form>
        <aside class="summary">
            <h2>Delivery details</h2>
            <p><strong>{{ values.customer_first_name }} {{ values.customer_last_name }}</strong><br>{{ values.email }}</p>
            <p>{{ shipping_name }}</p>
            {% if delivery %}
                <p>{{ values.billing_line1 }}<br>{{ values.billing_city }}{% if values.billing_state %}, {{ values.billing_state }}{% endif %} {{ values.billing_postal_code }}<br>{{ values.billing_country_code }}</p>
            {% endif %}
            <div class="summary-line total"><span>Items subtotal</span><b>{{ subtotal }}</b></div>
            <p class="checkout-note">Final shipping, tax, and discounts will be shown on the next step.</p>
            <form action="/checkout" method="post">
                {% if csrf_token %}<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">{% endif %}
                <input type="hidden" name="_action" value="edit_details">
                <button class="button light" type="submit">Back to delivery details</button>
            </form>
        </aside>
    </section>
    {% if authorize_client %}
        <script src="{{ authorize_client.environment == 'production' ? 'https://js.authorize.net/v1/Accept.js' : 'https://jstest.authorize.net/v1/Accept.js' }}"></script>
        <script>
        (() => {
            const form = document.querySelector('.northstar-checkout-form');
            const provider = () => form?.querySelector('[name="payment_method"]:checked')?.value;
            const card = document.querySelector('.authorize-card-fields');
            const processingOverlay = document.querySelector('.northstar-payment-processing');
            const processingMessage = processingOverlay?.querySelector('[data-processing-message]');
            const submitButton = form?.querySelector('button[type="submit"]');
            const showProcessing = message => {
                if (!processingOverlay) return;
                if (processingMessage) processingMessage.textContent = message;
                processingOverlay.hidden = false;
                processingOverlay.setAttribute('aria-hidden', 'false');
                form?.setAttribute('aria-busy', 'true');
            };
            const hideProcessing = () => {
                if (!processingOverlay) return;
                processingOverlay.hidden = true;
                processingOverlay.setAttribute('aria-hidden', 'true');
                form?.removeAttribute('aria-busy');
            };
            const refresh = () => {
                document.querySelectorAll('.northstar-payment-field').forEach(field => {
                    field.hidden = field.dataset.paymentProvider !== provider();
                });
                if (card) card.hidden = provider() !== 'authorize_net';
            };
            form?.querySelectorAll('[name="payment_method"]').forEach(input => input.addEventListener('change', refresh));
            refresh();
            form?.addEventListener('submit', event => {
                if (provider() !== 'authorize_net') return;
                const descriptor = form.querySelector('[name="payment_data[opaque_data_descriptor]"]');
                const value = form.querySelector('[name="payment_data[opaque_data_value]"]');
                if (descriptor?.value && value?.value) return;
                event.preventDefault();
                if (form.dataset.tokenizing === 'true') return;
                const error = card?.querySelector('[data-card-error]');
                if (!window.Accept || !card?.dataset.apiLoginId || !card?.dataset.clientKey) {
                    if (error) { error.textContent = 'Card tokenization is unavailable. Contact the store.'; error.hidden = false; }
                    return;
                }
                form.dataset.tokenizing = 'true';
                if (submitButton) submitButton.disabled = true;
                if (error) error.hidden = true;
                showProcessing('Please wait while your card details are securely tokenized.');
                try {
                    window.Accept.dispatchData({
                        authData: {apiLoginID: card.dataset.apiLoginId, clientKey: card.dataset.clientKey},
                        cardData: {
                            cardNumber: card.querySelector('[data-card-number]').value.replace(/\s+/g, ''),
                            month: card.querySelector('[data-card-month]').value,
                            year: card.querySelector('[data-card-year]').value,
                            cardCode: card.querySelector('[data-card-code]').value
                        }
                    }, response => {
                        form.dataset.tokenizing = 'false';
                        if (response?.messages?.resultCode !== 'Ok' || !response.opaqueData?.dataDescriptor || !response.opaqueData?.dataValue) {
                            if (submitButton) submitButton.disabled = false;
                            hideProcessing();
                            if (error) {
                                error.textContent = (response?.messages?.message || []).map(message => message.text).filter(Boolean).join(' ')
                                    || 'Card tokenization failed. Check the card details and retry.';
                                error.hidden = false;
                            }
                            return;
                        }
                        descriptor.value = response.opaqueData.dataDescriptor;
                        value.value = response.opaqueData.dataValue;
                        card.querySelectorAll('[data-card-number], [data-card-month], [data-card-year], [data-card-code]')
                            .forEach(input => { input.value = ''; });
                        showProcessing('Your card is tokenized. Submitting the payment request securely.');
                        form.submit();
                    });
                } catch (exception) {
                    form.dataset.tokenizing = 'false';
                    if (submitButton) submitButton.disabled = false;
                    hideProcessing();
                    if (error) {
                        error.textContent = 'Authorize.Net could not start card tokenization. Please try again.';
                        error.hidden = false;
                    }
                }
            });
        })();
        </script>
    {% endif %}
{% endblock %}
