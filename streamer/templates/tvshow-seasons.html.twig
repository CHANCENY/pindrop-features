{% extends "templates/base.html.twig" %}

{% block body %}

<div class="breadcrumb">
    <a href="{{ url('streamer.dashboard') }}">Dashboard</a>
    <span class="separator">›</span>
    <a href="{{ url('streamer.dashboard.shows') }}">TV Shows</a>
    <span class="separator">›</span>
    <a href="{{ url('streamer.dashboard.seasons', {show_id: show.id}) }}">{{ show.title }} - Seasons</a>
</div>

<div class="card">
    <h2>🎬 {{ show.title }} - Seasons Management</h2>
    <div style="margin-bottom: 20px;">
        <a href="{{ url('streamer.dashboard.shows') }}" class="btn btn-secondary">← Back to Shows</a>
        <a href="{{ url('streamer.dashboard.seasons.add', {show_id: show.id}) }}" class="btn btn-primary">➕ Add New Season</a>
        <a href="{{ url('streamer.dashboard.shows.watch', {show_id: show.id, sid: seasons[0].id}) }}" class="btn btn-secondary">Watch</a>
    </div>

    <!-- Filters Section -->
    <div class="card" style="margin-bottom: 20px; background-color: #f8f9fa;">
        <h3>🔍 Filters</h3>
        <form method="GET" action="{{ url('streamer.dashboard.seasons', {show_id: show.id}) }}" style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
            <div style="flex: 1; min-width: 200px;">
                <label for="season_number" style="display: block; margin-bottom: 5px; font-weight: bold;">Season Number:</label>
                <input type="number" id="season_number" name="season_number" value="{{ filters.season_number|default('') }}" placeholder="Filter by season number..." min="1" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            
            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary">🔍 Apply Filters</button>
                <a href="{{ url('streamer.dashboard.seasons', {show_id: show.id}) }}" class="btn btn-secondary">🔄 Clear</a>
            </div>
        </form>
    </div>

    <div class="table-container">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Season</th>
                <th>Title</th>
                <th>Episodes</th>
                <th>Rating</th>
                <th>Air Date</th>
                <th>Poster</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for season in seasons %}
            <tr>
                <td>{{ season.id }}</td>
                <td>
                    <span style="background-color: #007bff; color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold;">
                        Season {{ season.season_number }}
                    </span>
                </td>
                <td>{{ season.title }}</td>
                <td>{{ season.episode_count }}</td>
                <td>⭐ {{ season.vote_average|default('N/A') }}</td>
                <td>{{ season.air_date ? season.air_date|date("M d, Y") : 'N/A' }}</td>
                <td>
                    {% if season.poster %}
                        {% if season.poster starts with 'public://' %}
                            <img src="/sites/default/{{ season.poster|replace({'public://': ''}) }}" alt="{{ season.title }}" style="width: 40px; height: 60px; object-fit: cover; border-radius: 4px;">
                        {% else %}
                            <img src="https://image.tmdb.org/t/p/w185{{ season.poster }}" alt="{{ season.title }}" style="width: 40px; height: 60px; object-fit: cover; border-radius: 4px;">
                        {% endif %}
                    {% else %}
                        <div style="width: 40px; height: 60px; background-color: #e9ecef; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #6c757d; font-size: 12px;">No Poster</div>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ url('streamer.dashboard.episodes', {show_id: show.id, season_id: season.id}) }}" class="btn btn-primary" style="padding: 5px 10px; font-size: 12px;">Episodes</a>
                    <a href="{{ url('streamer.dashboard.seasons.delete', {show_id: show.id, season_id: season.id}) }}" class="btn btn-danger" style="padding: 5px 10px; font-size: 12px;">Delete</a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" style="text-align: center; padding: 20px;">
                    {% if show %}
                        No seasons found for "{{ show.title }}".
                        <a href="{{ url('streamer.dashboard.seasons.add', {show_id: show.id}) }}" class="btn btn-primary" style="margin-left: 10px;">Add First Season</a>
                    {% else %}
                        TV Show not found.
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    {% if pagination.total > 0 %}
    <div style="margin-top: 20px; text-align: center;">
        <p>Showing {{ ((pagination.current_page - 1) * pagination.per_page) + 1 }}-{{ min(pagination.current_page * pagination.per_page, pagination.total) }} of {{ pagination.total }} seasons</p>
        
        {% set currentParams = filters|default({}) %}
        {% set baseUrl = url('streamer.dashboard.seasons', {show_id: show.id}) %}
        
        <div style="display: flex; justify-content: center; align-items: center; gap: 5px; flex-wrap: wrap;">
            <!-- Previous Button -->
            {% if pagination.has_prev %}
                {% set prevParams = currentParams|merge({'page': pagination.current_page - 1}) %}
                <a href="{{ baseUrl }}?{{ prevParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">← Previous</a>
            {% else %}
                <button class="btn btn-secondary" style="padding: 8px 15px; font-size: 14px;" disabled>← Previous</button>
            {% endif %}
            
            <!-- Page Numbers -->
            {% set startPage = max(1, pagination.current_page - 2) %}
            {% set endPage = min(pagination.total_pages, pagination.current_page + 2) %}
            
            {% if startPage > 1 %}
                {% set firstParams = currentParams|merge({'page': 1}) %}
                <a href="{{ baseUrl }}?{{ firstParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">1</a>
                {% if startPage > 2 %}
                    <span style="padding: 8px;">...</span>
                {% endif %}
            {% endif %}
            
            {% for page in range(startPage, endPage) %}
                {% set pageParams = currentParams|merge({'page': page}) %}
                {% if page == pagination.current_page %}
                    <button class="btn btn-primary" style="padding: 8px 15px; font-size: 14px; background-color: #007bff; border-color: #007bff;">{{ page }}</button>
                {% else %}
                    <a href="{{ baseUrl }}?{{ pageParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">{{ page }}</a>
                {% endif %}
            {% endfor %}
            
            {% if endPage < pagination.total_pages %}
                {% if endPage < pagination.total_pages - 1 %}
                    <span style="padding: 8px;">...</span>
                {% endif %}
                {% set lastParams = currentParams|merge({'page': pagination.total_pages}) %}
                <a href="{{ baseUrl }}?{{ lastParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">{{ pagination.total_pages }}</a>
            {% endif %}
            
            <!-- Next Button -->
            {% if pagination.has_next %}
                {% set nextParams = currentParams|merge({'page': pagination.current_page + 1}) %}
                <a href="{{ baseUrl }}?{{ nextParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">Next →</a>
            {% else %}
                <button class="btn btn-secondary" style="padding: 8px 15px; font-size: 14px;" disabled>Next →</button>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <!-- Quick Actions -->
    <div class="card" style="margin-top: 20px;">
        <h3>🎬 Quick Actions</h3>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="{{ url('streamer.dashboard.shows.edit', {show_id: show.id}) }}" class="btn btn-warning">✏️ Edit TV Show</a>
            <a href="{{ url('streamer.dashboard.shows') }}" class="btn btn-primary">📺 Browse Other Shows</a>
        </div>
    </div>
</div>

{% endblock %}