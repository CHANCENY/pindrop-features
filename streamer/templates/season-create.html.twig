{% extends "templates/base.html.twig" %}

{% block body %}
<div class="breadcrumb">
    <a href="{{ url('streamer.dashboard') }}">Dashboard</a>
    <span class="separator">›</span>
    <a href="{{ url('streamer.dashboard.shows') }}">TV Shows</a>
    <span class="separator">›</span>
    <a href="{{ url('streamer.dashboard.seasons', {show_id: show.id}) }}">Seasons</a>
    <span class="separator">›</span>
    <a href="{{ url('streamer.dashboard.seasons.add', {show_id: show.id}) }}">Create Season</a>
</div>

<div class="card">
    <h2>➕ Create New Season</h2>

    <form id="seasonCreateForm" method="post">
        <div class="grid">
            <div class="form-group">
                <label for="season_id">Season</label>
                <select id="season_id" name="season_id[]" multiple>
                    {% for season in seasons %}
                        <option value="{{ season.id }}">{{ season.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="all">Create all seasons</label>
                <input type="checkbox"  id="all" name="all"  min="1">
            </div>
        </div>
        <div style="margin-top: 30px; text-align: center;" id="last-component">
            <button type="submit" class="btn btn-success">💾 Create Season</button>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}

{% endblock %}