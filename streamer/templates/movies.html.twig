{% extends "templates/base.html.twig" %}

{% block body %}

    <div class="breadcrumb">
        <a href="{{ url('streamer.dashboard') }}">Dashboard</a>
        <span class="separator">›</span>
        <a href="{{ url('streamer.dashboard.movies') }}">Movies</a>
    </div>

    <div class="card">
        <h2>🎬 Movies Management</h2>
        <div style="margin-bottom: 20px;">
            <a href="{{ url('streamer.dashboard.add.movie') }}" class="btn btn-primary">➕ Add New Movie</a>
        </div>

        <!-- Filters Section -->
        <div class="card" style="margin-bottom: 20px; background-color: #f8f9fa;">
            <h3>🔍 Filters</h3>
            <form method="GET" action="{{ url('streamer.dashboard.movies') }}" style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
                <div style="flex: 1; min-width: 200px;">
                    <label for="title" style="display: block; margin-bottom: 5px; font-weight: bold;">Title:</label>
                    <input type="text" id="title" name="title" value="{{ filters.title|default('') }}" placeholder="Search by title..." style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                </div>
                
                <div style="flex: 1; min-width: 150px;">
                    <label for="genre" style="display: block; margin-bottom: 5px; font-weight: bold;">Genre:</label>
                    <select id="genre" name="genre" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                        <option value="">All Genres</option>
                        {% for list_filter in list_filters %}
                        <option value="{{ list_filter.name }}" {% if filters.genre == list_filter.name %}selected{% endif %}>{{ list_filter.name }}</option>
                        {% endfor %}

                    </select>
                </div>
                
                <div style="flex: 1; min-width: 120px;">
                    <label for="year_from" style="display: block; margin-bottom: 5px; font-weight: bold;">Year From:</label>
                    <input type="year" id="year_from" name="year_from" value="{{ filters.year_from|default('') }}" placeholder="From" min="1900" max="{{ "now"|date("Y") }}" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                </div>
                
                <div style="flex: 1; min-width: 120px;">
                    <label for="year_to" style="display: block; margin-bottom: 5px; font-weight: bold;">Year To:</label>
                    <input type="number" id="year_to" name="year_to" value="{{ filters.year_to|default('') }}" placeholder="To" min="1900" max="{{ "now"|date("Y") }}" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                </div>
                
                <div style="flex: 1; min-width: 120px;">
                    <label for="rating_min" style="display: block; margin-bottom: 5px; font-weight: bold;">Min Rating:</label>
                    <input type="number" id="rating_min" name="rating_min" value="{{ filters.rating_min|default('') }}" placeholder="0.0" min="0" max="10" step="0.1" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                </div>
                
                <div style="flex: 1; min-width: 120px;">
                    <label for="featured" style="display: block; margin-bottom: 5px; font-weight: bold;">Featured:</label>
                    <select id="featured" name="featured" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                        <option value="">All</option>
                        <option value="1" {% if filters.featured == '1' %}selected{% endif %}>Featured Only</option>
                        <option value="0" {% if filters.featured == '0' %}selected{% endif %}>Not Featured</option>
                    </select>
                </div>
                
                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn btn-primary">🔍 Apply Filters</button>
                    <a href="{{ url('streamer.dashboard.movies') }}" class="btn btn-secondary">🔄 Clear</a>
                </div>
            </form>
        </div>

        <div class="table-container">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Release Year</th>
                    <th>Duration</th>
                    <th>Rating</th>
                    <th>Featured</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for movie in movies %}
                <tr>
                    <td>{{ movie.id }}</td>
                    <td>
                        {% if movie.thumbnail_path %}
                            {% if movie.thumbnail_path starts with 'public://' %}
                                <img src="/sites/default/{{ movie.thumbnail_path|replace({'public://': ''}) }}" alt="{{ movie.title }}" style="width: 30px; height: 45px; object-fit: cover; margin-right: 10px; vertical-align: middle;">
                            {% else %}
                                <img src="https://image.tmdb.org/t/p/w185{{ movie.thumbnail_path }}" alt="{{ movie.title }}" style="width: 30px; height: 45px; object-fit: cover; margin-right: 10px; vertical-align: middle;">
                            {% endif %}
                        {% endif %}
                        {{ movie.title }}
                    </td>
                    <td>
                        {% if movie.genres is iterable %}
                            {{ movie.genres|map(g => g.value|default(g))|join(', ') }}
                        {% elseif movie.genres is not empty %}
                            {{ movie.genres }}
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                    <td>{{ movie.release_date|date("Y") }}</td>
                    <td>{{ movie.duration }} min</td>
                    <td>⭐ {{ movie.rating|default('N/A') }}</td>
                    <td>
                        {% if movie.featured %}
                            <span style="color: #28a745; font-weight: bold;">✓ Featured</span>
                        {% else %}
                            <span style="color: #6c757d;">-</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ url('streamer.dashboard.movie.watch', {movie_id: movie.id}) }}" class="btn btn-secondary">Watch</a>
                        <a href="{{ url('streamer.dashboard.edit.movie',{movie_id: movie.id}) }}" class="btn btn-warning" style="padding: 5px 10px; font-size: 12px;">Edit</a>
                        <a href="{{ url('streamer.dashboard.delete.movie',{movie_id: movie.id}) }}" class="btn btn-danger" style="padding: 5px 10px; font-size: 12px;">Delete</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" style="text-align: center; padding: 20px;">No movies found matching your criteria.</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if pagination.total > 0 %}
        <div style="margin-top: 20px; text-align: center;">
            <p>Showing {{ ((pagination.current_page - 1) * pagination.per_page) + 1 }}-{{ min(pagination.current_page * pagination.per_page, pagination.total) }} of {{ pagination.total }} movies</p>

            {% set currentParams = filters|default({}) %}
            {% set baseUrl = url('streamer.dashboard.movies') %}

            <div style="display: flex; justify-content: center; align-items: center; gap: 5px; flex-wrap: wrap;">
                <!-- Previous Button -->
                {% if pagination.has_prev %}
                    {% set prevParams = currentParams|merge({'page': pagination.current_page - 1}) %}
                    <a href="{{ baseUrl }}?{{ prevParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">← Previous</a>
                {% else %}
                    <button class="btn btn-secondary" style="padding: 8px 15px; font-size: 14px;" disabled>← Previous</button>
                {% endif %}

                <!-- Page Numbers -->
                {% set startPage = max(1, pagination.current_page - 2) %}
                {% set endPage = min(pagination.total_pages, pagination.current_page + 2) %}

                {% if startPage > 1 %}
                    {% set firstParams = currentParams|merge({'page': 1}) %}
                    <a href="{{ baseUrl }}?{{ firstParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">1</a>
                    {% if startPage > 2 %}
                        <span style="padding: 8px;">...</span>
                    {% endif %}
                {% endif %}

                {% for page in range(startPage, endPage) %}
                    {% set pageParams = currentParams|merge({'page': page}) %}
                    {% if page == pagination.current_page %}
                        <button class="btn btn-primary" style="padding: 8px 15px; font-size: 14px; background-color: #007bff; border-color: #007bff;">{{ page }}</button>
                    {% else %}
                        <a href="{{ baseUrl }}?{{ pageParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">{{ page }}</a>
                    {% endif %}
                {% endfor %}

                {% if endPage < pagination.total_pages %}
                    {% if endPage < pagination.total_pages - 1 %}
                        <span style="padding: 8px;">...</span>
                    {% endif %}
                    {% set lastParams = currentParams|merge({'page': pagination.total_pages}) %}
                    <a href="{{ baseUrl }}?{{ lastParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">{{ pagination.total_pages }}</a>
                {% endif %}

                <!-- Next Button -->
                {% if pagination.has_next %}
                    {% set nextParams = currentParams|merge({'page': pagination.current_page + 1}) %}
                    <a href="{{ baseUrl }}?{{ nextParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">Next →</a>
                {% else %}
                    <button class="btn btn-secondary" style="padding: 8px 15px; font-size: 14px;" disabled>Next →</button>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>

{% endblock %}