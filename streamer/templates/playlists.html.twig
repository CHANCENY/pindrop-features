{% extends "templates/base.html.twig" %}

{% block body %}

<div class="breadcrumb">
    <a href="{{ url('streamer.dashboard') }}">Dashboard</a>
    <span class="separator">›</span>
    <a href="{{ url('streamer.dashboard.playlists') }}">Playlists</a>
</div>

<div class="card">
    <h2>📋 Movie Playlists Management</h2>
    <div style="margin-bottom: 20px;">
        <a href="{{ url('streamer.dashboard.playlists.add') }}" class="btn btn-primary">➕ Create New Playlist</a>
    </div>

    <!-- Filters Section -->
    <div class="card" style="margin-bottom: 20px; background-color: #f8f9fa;">
        <h3>🔍 Filters</h3>
        <form method="GET" action="{{ url('streamer.dashboard.playlists') }}" style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
            <div style="flex: 1; min-width: 200px;">
                <label for="title" style="display: block; margin-bottom: 5px; font-weight: bold;">Playlist Name:</label>
                <input type="text" id="title" name="title" value="{{ filters.title|default('') }}" placeholder="Filter by playlist name..." style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            
            <div style="flex: 1; min-width: 200px;">
                <label for="is_public" style="display: block; margin-bottom: 5px; font-weight: bold;">Visibility:</label>
                <select id="is_public" name="is_public" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                    <option value="">All Playlists</option>
                    <option value="1" {{ filters.is_public == '1' ? 'selected' : '' }}>Public</option>
                    <option value="0" {{ filters.is_public == '0' ? 'selected' : '' }}>Private</option>
                </select>
            </div>
            
            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary">🔍 Apply Filters</button>
                <a href="{{ url('streamer.dashboard.playlists') }}" class="btn btn-secondary">🔄 Clear</a>
            </div>
        </form>
    </div>

    <div class="table-container">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Playlist Name</th>
                <th>Description</th>
                <th>Type</th>
                <th>Items</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for playlist in playlists %}
            <tr>
                <td>{{ playlist.id }}</td>
                <td>
                    <strong>{{ playlist.title }}</strong>
                    {% if playlist.is_public %}
                        <span style="background-color: #28a745; color: white; padding: 2px 6px; border-radius: 3px; font-size: 11px; margin-left: 5px;">Public</span>
                    {% else %}
                        <span style="background-color: #6c757d; color: white; padding: 2px 6px; border-radius: 3px; font-size: 11px; margin-left: 5px;">Private</span>
                    {% endif %}
                </td>
                <td>{{ playlist.description|default('No description')|slice(0, 100) }}{% if playlist.description and playlist.description|length > 100 %}...{% endif %}</td>
                <td>
                    <span style="background-color: #007bff; color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold;">
                        {{ playlist.session_token ? 'Manual' : 'Auto' }}
                    </span>
                </td>
                <td>
                    <span style="background-color: #17a2b8; color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold;">
                        {{ playlist.item_count|default(0) }} items
                    </span>
                </td>
                <td>{{ playlist.created_at ? playlist.created_at|date("M d, Y") : 'N/A' }}</td>
                <td>
                    <a href="{{ url('streamer.dashboard.playlist.watch', {session_token: playlist.session_token }) }}" class="btn btn-primary" style="padding: 5px 10px; font-size: 12px;">Watch</a>
                    <a href="{{ url('streamer.dashboard.playlists.delete', {playlist_id: playlist.id }) }}" class="btn btn-danger" style="padding: 5px 10px; font-size: 12px;">Delete</a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" style="text-align: center; padding: 20px;">
                    No playlists found.
                    <a href="{{ url('streamer.dashboard.playlists.add') }}" class="btn btn-primary" style="margin-left: 10px;">Create First Playlist</a>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    {% if pagination.total > 0 %}
    <div style="margin-top: 20px; text-align: center;">
        <p>Showing {{ ((pagination.current_page - 1) * pagination.per_page) + 1 }}-{{ min(pagination.current_page * pagination.per_page, pagination.total) }} of {{ pagination.total }} playlists</p>
        
        {% set currentParams = filters|default({}) %}
        {% set baseUrl = url('streamer.dashboard.playlists') %}
        
        <div style="display: flex; justify-content: center; align-items: center; gap: 5px; flex-wrap: wrap;">
            <!-- Previous Button -->
            {% if pagination.has_prev %}
                {% set prevParams = currentParams|merge({'page': pagination.current_page - 1}) %}
                <a href="{{ baseUrl }}?{{ prevParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">← Previous</a>
            {% else %}
                <button class="btn btn-secondary" style="padding: 8px 15px; font-size: 14px;" disabled>← Previous</button>
            {% endif %}
            
            <!-- Page Numbers -->
            {% set startPage = max(1, pagination.current_page - 2) %}
            {% set endPage = min(pagination.total_pages, pagination.current_page + 2) %}
            
            {% if startPage > 1 %}
                {% set firstParams = currentParams|merge({'page': 1}) %}
                <a href="{{ baseUrl }}?{{ firstParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">1</a>
                {% if startPage > 2 %}
                    <span style="padding: 8px;">...</span>
                {% endif %}
            {% endif %}
            
            {% for page in range(startPage, endPage) %}
                {% set pageParams = currentParams|merge({'page': page}) %}
                {% if page == pagination.current_page %}
                    <button class="btn btn-primary" style="padding: 8px 15px; font-size: 14px; background-color: #007bff; border-color: #007bff;">{{ page }}</button>
                {% else %}
                    <a href="{{ baseUrl }}?{{ pageParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">{{ page }}</a>
                {% endif %}
            {% endfor %}
            
            {% if endPage < pagination.total_pages %}
                {% if endPage < pagination.total_pages - 1 %}
                    <span style="padding: 8px;">...</span>
                {% endif %}
                {% set lastParams = currentParams|merge({'page': pagination.total_pages}) %}
                <a href="{{ baseUrl }}?{{ lastParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">{{ pagination.total_pages }}</a>
            {% endif %}
            
            <!-- Next Button -->
            {% if pagination.has_next %}
                {% set nextParams = currentParams|merge({'page': pagination.current_page + 1}) %}
                <a href="{{ baseUrl }}?{{ nextParams|url_encode }}" class="btn btn-primary" style="padding: 8px 15px; font-size: 14px;">Next →</a>
            {% else %}
                <button class="btn btn-secondary" style="padding: 8px 15px; font-size: 14px;" disabled>Next →</button>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

{% endblock %}