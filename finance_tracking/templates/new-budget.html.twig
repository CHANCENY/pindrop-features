{% extends '@finance_tracking/partials/html.html.twig' %}


{% block content %}

 <div class="content form-page">
                <section class="page-title">
                    <p class="eyebrow">Plan ahead</p>
                    <h1>Create a budget</h1>
                    <p>Give a category a clear limit and a little breathing room.</p>
                </section>
                <section class="panel form-card">
                    <form  method="post">
                        <details open>
                            <summary>Budget details</summary>
                            <div class="form-grid">
                                <div class="field"><label for="budget-name">Budget name</label><input id="budget-name"
                                        name="name" placeholder="e.g. Travel fund" required></div>
                                <div class="field"><label for="budget-limit">Monthly limit</label><input
                                        id="budget-limit" name="limit" type="number" step="0.01" placeholder="$ 0.00"
                                        required></div>
                                <div class="field"><label for="budget-category">Category</label><select
                                        id="budget-category" name="category">
                                        {% for category in categories %}
                                        <option>{{ category }}</option>
                                        {% endfor %}
                                    </select></div>
                                <div class="field"><label for="budget-month">Start month</label><input id="budget-month"
                                        name="month" type="date" value="2024-10"></div>
                                
                            </div>
                        </details>
                        <details>
                            <summary>Alerts and cadence</summary>
                            <div class="form-grid">
                                <div class="field"><label for="alert-threshold">Alert me at</label><select
                                        id="alert-threshold" name="alert">
                                        <option value="50">50% of limit</option>
                                        <option value="55">55% of limit</option>
                                        <option value="60">60% of limit</option>
                                        <option value="65">65% of limit</option>
                                        <option value="70">70% of limit</option>
                                        <option value="75">75% of limit</option>
                                        <option value="80">80% of limit</option>
                                        <option value="90">90% of limit</option>
                                        <option value="100">100% of limit</option>
                                    </select></div>
                                <div class="field"><label for="cadence">Reset cadence</label><select id="cadence"
                                        name="cadence">
                                        <option>Every month</option>
                                        <option>Every quarter</option>
                                        <option>Custom</option>
                                    </select></div>
                            </div>
                        </details>
                        <div class="review-card"><strong>Tip:</strong> Start with a limit you can meet consistently,
                            then adjust after two weeks of real spending.</div>
                        <div class="form-actions"><button class="button primary" type="submit"><b>✓</b> Create
                                budget</button><a class="cancel-link" href="/finances/budgets">Cancel and return</a></div>
                    </form>
                </section>
                <footer class="footer"><span>Ledgerly for thoughtful money management.</span><span>Sample data ·
                        2024</span></footer>
            </div>

{% endblock %}