{% extends '@finance_tracking/partials/html.html.twig' %}


{% block content %}

<div class="content form-page">
    <section class="page-title">
        <p class="eyebrow">Money movements</p>
        <h1>Add a transaction</h1>
        <p>Capture a purchase or income in a few calm steps. This will be added to <strong>Personal
                finances</strong>.</p>
    </section>
    <section class="panel form-card">
        <form method="post">
            <fieldset>
                <legend>Transaction type</legend>
                <div class="choice-row">
                    <div><input id="expense" name="type" type="radio" value="expense" checked><label
                            for="expense"><strong>Expense</strong><small>Money leaving an
                                account</small></label></div>
                    <div><input id="income" name="type" type="radio" value="income"><label
                            for="income"><strong>Income</strong><small>Money arriving in an
                                account</small></label></div>
                </div>
            </fieldset>
            <details open>
                <summary>Core details</summary>
                <div class="form-grid">
                    <div class="field"><label for="merchant">Merchant or source</label><input id="merchant"
                            name="merchant" placeholder="e.g. Whole Foods Market" required></div>
                    <div class="field"><label for="amount">Amount</label><input id="amount" name="amount" type="number"
                            step="0.01" placeholder="$ 0.00" required></div>
                    <div class="field"><label for="category">Category</label><select id="category" name="category">
                            {% for category in categories %}
                            <option>{{ category }}</option>
                            {% endfor %}
                        
                        </select></div>
                    <div class="field"><label for="date">Date</label><input id="date" name="date" type="date"
                            value=""></div>
                </div>
            </details>
            <details>
                <summary>Account and notes</summary>
                <div class="form-grid">
                    <div class="field"><label for="account">Account</label><select id="account" name="budget">
                           {% for budget in budgets %}
                            <option value="{{ budget.id }}">{{ budget.getName }}</option>
                           {% endfor %} 
                        </select></div>
                    <div class="field"><label for="reference">Reference</label><input id="reference" name="reference"
                            placeholder="Optional note"></div>
                    <div class="field full"><label for="notes">Notes</label><textarea id="notes" name="notes"
                            placeholder="Add context for future you..."></textarea></div>
                </div>
            </details>
            <div class="review-card"><strong>Quick check:</strong> You can edit categories and notes later
                from Transactions.</div>
            <div class="form-actions"><button class="button primary" type="submit"><b>✓</b> Save
                    transaction</button><a class="cancel-link" href="/finances/transactions">Cancel and
                    return</a></div>
        </form>
    </section>
    <footer class="footer"><span>Ledgerly for thoughtful money management.</span><span>Sample data ·
            2024</span></footer>
</div>

{% endblock %}