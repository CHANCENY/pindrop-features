{% extends "templates/base.twig" %}

{% block title %}Yt Links{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/modules/yt_dlp_downloader/assets/css/style.css">
{% endblock %}


{% block content %}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>yt-dlp Links</h1>
            <p>Manage YouTube and other yt-dlp download links.</p>
        </div>

        <a href="{{ url('YtController.addLink') }}" class="btn btn-primary">
            Add Link
        </a>
    </div>

    {% if links is empty %}

        <div class="empty-state">
            <h3>No links found</h3>
            <p>Add a link to start a new download.</p>

            <a href="{{ url('YtController.addLink') }}" class="btn btn-primary">
                Add Link
            </a>
        </div>

    {% else %}

        <div class="table-wrapper">
            <table class="links-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Link</th>
                        <th>Local Path</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                {% for link in links %}

                    <tr>

                        <td>
                            {{ link.id }}
                        </td>

                        <td>
                            <strong>{{ link.name }}</strong>
                        </td>

                        <td>
                            <a
                                href="{{ link.link }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="external-link"
                            >
                                {{ link.link }}
                            </a>
                        </td>

                        <td>
                            <code>{{ link.local_path }}</code>
                        </td>

                        <td>
                            {% if link.status == 'pending' %}
                                <span class="status status-pending">
                                    Pending
                                </span>

                            {% elseif link.status == 'downloading' %}
                                <span class="status status-downloading">
                                    Downloading
                                </span>

                            {% elseif link.status == 'completed' %}
                                <span class="status status-completed">
                                    Completed
                                </span>

                            {% elseif link.status == 'failed' %}
                                <span class="status status-failed">
                                    Failed
                                </span>
                            {% endif %}
                        </td>

                        <td>
                            {{ link.created_at|date('Y-m-d H:i') }}
                        </td>

                        <td>

                            <div class="actions">

                                <a
                                    href="{{ url('YtController.editLink', {id: link.id}) }}"
                                    class="btn btn-secondary btn-sm"
                                >
                                    Edit
                                </a>

                                <form
                                    method="post"
                                    action="{{ url('YtController.deleteLink', {id: link.id}) }}"
                                    onsubmit="return confirm('Are you sure you want to delete this link?');"
                                >

                                    

                                    <button
                                        type="submit"
                                        class="btn btn-danger btn-sm"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                {% endfor %}

                </tbody>
            </table>
        </div>

    {% endif %}

</div>

{% endblock %}