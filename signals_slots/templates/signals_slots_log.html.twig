{% extends 'templates/base.twig' %}
{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="ss-page">

  <div class="ss-header">
    <div>
      <h1>Delivery Log</h1>
      <p>{{ pagination.count }} total entries</p>
    </div>
    <a href="{{ url('signals_slots.dashboard') }}" class="ss-btn">← Dashboard</a>
  </div>

  <div class="ss-filters">
    <form method="get" class="ss-filter-form">
      <input type="text" name="signal_key" placeholder="Signal key" value="{{ filters.signal_key|default('') }}">
      <input type="text" name="slot_id"    placeholder="Slot id"    value="{{ filters.slot_id|default('') }}">
      <select name="success">
        <option value="">All results</option>
        <option value="1" {% if filters.success is defined and filters.success == '1' %}selected{% endif %}>Success</option>
        <option value="0" {% if filters.success is defined and filters.success == '0' %}selected{% endif %}>Failed</option>
      </select>
      <button type="submit" class="ss-btn">Filter</button>
      {% if filters is not empty %}
        <a href="{{ url('signals_slots.log') }}" class="ss-btn">Clear</a>
      {% endif %}
    </form>
  </div>

  <div class="ss-table-wrapper">
    <table class="ss-table">
      <thead>
        <tr>
          <th>Signal</th>
          <th>Slot</th>
          <th width="80">Mode</th>
          <th width="80">Result</th>
          <th>Error</th>
          <th width="160">Date</th>
        </tr>
      </thead>
      <tbody>
        {% if entries is not empty %}
          {% for entry in entries %}
            <tr>
              <td><code class="ss-key">{{ entry.signal_key }}</code></td>
              <td><code class="ss-key">{{ entry.slot_id }}</code></td>
              <td><span class="ss-mode ss-mode-{{ entry.mode }}">{{ entry.mode }}</span></td>
              <td>
                {% if entry.success %}
                  <span class="ss-badge ss-badge-active">ok</span>
                {% else %}
                  <span class="ss-badge ss-badge-fail">fail</span>
                {% endif %}
              </td>
              <td class="ss-meta">{{ entry.error ?? '—' }}</td>
              <td class="ss-meta">{{ entry.created_at|date('M d H:i:s') }}</td>
            </tr>
          {% endfor %}
        {% else %}
          <tr><td colspan="6"><div class="ss-empty">No log entries match your filters.</div></td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>

  {% if pagination.total > 1 %}
    <div class="ss-pagination">
      {% if pagination.current > 1 %}
        <a href="?page={{ pagination.current - 1 }}" class="ss-btn">← Prev</a>
      {% endif %}
      <span class="ss-meta">Page {{ pagination.current }} of {{ pagination.total }}</span>
      {% if pagination.current < pagination.total %}
        <a href="?page={{ pagination.current + 1 }}" class="ss-btn">Next →</a>
      {% endif %}
    </div>
  {% endif %}

</div>

<style>
.ss-page             { padding:2rem; }
.ss-header           { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem; }
.ss-header h1        { margin:0 0 .25rem; font-size:1.5rem; }
.ss-header p         { margin:0; color:#6b7280; font-size:.875rem; }
.ss-header-actions   { display:flex; gap:.5rem; }

.ss-stats            { display:flex; gap:1rem; margin-bottom:2rem; flex-wrap:wrap; }
.ss-stat             { background:#f9fafb; border:1px solid #e5e7eb; border-radius:.5rem; padding:1rem 1.5rem; min-width:120px; }
.ss-stat-warn        { border-color:#f59e0b; background:#fffbeb; }
.ss-stat-value       { display:block; font-size:1.75rem; font-weight:700; line-height:1; }
.ss-stat-label       { font-size:.75rem; color:#6b7280; margin-top:.25rem; display:block; }

.ss-section-title    { font-size:1rem; font-weight:600; margin:1.5rem 0 .75rem; }

.ss-table-wrapper    { overflow-x:auto; border:1px solid #e5e7eb; border-radius:.5rem; margin-bottom:2rem; }
.ss-table            { width:100%; border-collapse:collapse; font-size:.875rem; }
.ss-table thead th   { background:#f9fafb; padding:.75rem 1rem; text-align:left; font-weight:600; border-bottom:1px solid #e5e7eb; }
.ss-table tbody tr   { border-bottom:1px solid #f3f4f6; }
.ss-table td         { padding:.625rem 1rem; vertical-align:middle; }
.ss-row-paused       { opacity:.5; }

.ss-key              { font-family:monospace; background:#f3f4f6; padding:.1rem .4rem; border-radius:.2rem; font-size:.8rem; }
.ss-meta             { font-size:.75rem; color:#9ca3af; margin:.2rem 0 0; }
.ss-mode             { display:inline-block; padding:.125rem .5rem; border-radius:.25rem; font-size:.7rem; font-weight:600; text-transform:uppercase; }
.ss-mode-sync        { background:#dbeafe; color:#1d4ed8; }
.ss-mode-async       { background:#f3e8ff; color:#7c3aed; }

.ss-badge            { display:inline-block; padding:.125rem .5rem; border-radius:.25rem; font-size:.7rem; font-weight:600; text-transform:uppercase; }
.ss-badge-active     { background:#dcfce7; color:#16a34a; }
.ss-badge-paused     { background:#f3f4f6; color:#6b7280; }

.ss-actions          { display:flex; gap:.4rem; }
.ss-btn              { padding:.375rem .875rem; border-radius:.375rem; border:1px solid #d1d5db; background:#fff; cursor:pointer; font-size:.8125rem; text-decoration:none; color:#374151; }
.ss-btn:hover        { background:#f3f4f6; }
.ss-btn-primary      { background:#111827; color:#fff; border-color:#111827; }
.ss-btn-primary:hover{ background:#1f2937; }
.ss-btn-small        { padding:.25rem .625rem; font-size:.75rem; }
.ss-btn-danger       { border-color:#fca5a5; color:#dc2626; }
.ss-btn-danger:hover { background:#fee2e2; }

.ss-two-col          { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
.ss-card-list        { display:flex; flex-direction:column; gap:.5rem; }
.ss-card             { border:1px solid #e5e7eb; border-radius:.5rem; padding:.75rem 1rem; }
.ss-card-name        { margin:.25rem 0 .2rem; font-size:.875rem; font-weight:500; }
.ss-tag              { display:inline-block; background:#f3f4f6; border-radius:.25rem; padding:.1rem .4rem; font-size:.7rem; color:#6b7280; }

.ss-empty            { padding:3rem; text-align:center; color:#9ca3af; }

@media(max-width:768px) { .ss-two-col { grid-template-columns:1fr; } }
</style>
{% endblock %}
