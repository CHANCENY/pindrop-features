{% extends 'templates/base.twig' %}
{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="ss-page">

  {# ── Header ────────────────────────────────────────────────────── #}
  <div class="ss-header">
    <div>
      <h1>Signals &amp; Slots</h1>
      <p>Qt-style runtime connections between plugin events and handlers</p>
    </div>
    <div class="ss-header-actions">
      <a href="{{ url('signals_slots.log') }}" class="ss-btn">Delivery Log</a>
      <a href="{{ url('signals_slots.connect') }}" class="ss-btn ss-btn-primary">+ Connect</a>
    </div>
  </div>

  {# ── Stats strip ───────────────────────────────────────────────── #}
  <div class="ss-stats">
    <div class="ss-stat">
      <span class="ss-stat-value">{{ signals|length }}</span>
      <span class="ss-stat-label">Signals declared</span>
    </div>
    <div class="ss-stat">
      <span class="ss-stat-value">{{ slots|length }}</span>
      <span class="ss-stat-label">Slots declared</span>
    </div>
    <div class="ss-stat">
      <span class="ss-stat-value">{{ connections|length }}</span>
      <span class="ss-stat-label">Connections</span>
    </div>
    <div class="ss-stat {% if queue_depth > 0 %}ss-stat-warn{% endif %}">
      <span class="ss-stat-value">{{ queue_depth }}</span>
      <span class="ss-stat-label">Pending in queue</span>
    </div>
  </div>

  {# ── Active connections ─────────────────────────────────────────── #}
  <h2 class="ss-section-title">Connections</h2>

  <div class="ss-table-wrapper">
    <table class="ss-table">
      <thead>
        <tr>
          <th>Signal</th>
          <th>Slot</th>
          <th width="80">Mode</th>
          <th width="90">Status</th>
          <th width="200">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% if connections is not empty %}
          {% for conn in connections %}
            <tr class="{{ conn.active ? '' : 'ss-row-paused' }}">
              <td>
                <code class="ss-key">{{ conn.signal_key }}</code><br>
                <span class="ss-meta">{{ conn.signal_name }}</span>
              </td>
              <td>
                <code class="ss-key">{{ conn.slot_id }}</code><br>
                <span class="ss-meta">{{ conn.slot_name }}</span>
              </td>
              <td>
                <span class="ss-mode ss-mode-{{ conn.mode }}">{{ conn.mode }}</span>
              </td>
              <td>
                {% if conn.active %}
                  <span class="ss-badge ss-badge-active">active</span>
                {% else %}
                  <span class="ss-badge ss-badge-paused">paused</span>
                {% endif %}
              </td>
              <td class="ss-actions">
                <form method="post" action="{{ url('signals_slots.toggle', {id: conn.id}) }}" style="display:inline">
                  <button class="ss-btn ss-btn-small">{{ conn.active ? 'Pause' : 'Activate' }}</button>
                </form>
                <form method="post" action="{{ url('signals_slots.delete', {id: conn.id}) }}" style="display:inline"
                      onsubmit="return confirm('Delete this connection?')">
                  <button class="ss-btn ss-btn-small ss-btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="5">
              <div class="ss-empty">No connections yet. <a href="{{ url('signals_slots.connect') }}">Connect a signal to a slot.</a></div>
            </td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>

  {# ── Declared signals ───────────────────────────────────────────── #}
  <div class="ss-two-col">

    <div>
      <h2 class="ss-section-title">Declared Signals</h2>
      <div class="ss-card-list">
        {% if signals is not empty %}
          {% for key, sig in signals %}
            <div class="ss-card">
              <code class="ss-key">{{ key }}</code>
              <p class="ss-card-name">{{ sig.name }}</p>
              {% if sig.description is defined %}
                <p class="ss-meta">{{ sig.description }}</p>
              {% endif %}
              {% if sig.plugin is defined %}
                <span class="ss-tag">{{ sig.plugin }}</span>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <p class="ss-meta">No signals declared. Add a <code>signals.yml</code> to your plugin.</p>
        {% endif %}
      </div>
    </div>

    <div>
      <h2 class="ss-section-title">Declared Slots</h2>
      <div class="ss-card-list">
        {% if slots is not empty %}
          {% for id, slot in slots %}
            <div class="ss-card">
              <code class="ss-key">{{ id }}</code>
              <p class="ss-card-name">{{ slot.name }}</p>
              {% if slot.description is defined %}
                <p class="ss-meta">{{ slot.description }}</p>
              {% endif %}
              {% if slot.plugin is defined %}
                <span class="ss-tag">{{ slot.plugin }}</span>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <p class="ss-meta">No slots declared. Add a <code>slots.yml</code> to your plugin.</p>
        {% endif %}
      </div>
    </div>

  </div>

</div>

<style>
.ss-page             { padding:2rem; }
.ss-header           { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem; }
.ss-header h1        { margin:0 0 .25rem; font-size:1.5rem; }
.ss-header p         { margin:0; color:#6b7280; font-size:.875rem; }
.ss-header-actions   { display:flex; gap:.5rem; }

.ss-stats            { display:flex; gap:1rem; margin-bottom:2rem; flex-wrap:wrap; }
.ss-stat             { background:#f9fafb; border:1px solid #e5e7eb; border-radius:.5rem; padding:1rem 1.5rem; min-width:120px; }
.ss-stat-warn        { border-color:#f59e0b; background:#fffbeb; }
.ss-stat-value       { display:block; font-size:1.75rem; font-weight:700; line-height:1; }
.ss-stat-label       { font-size:.75rem; color:#6b7280; margin-top:.25rem; display:block; }

.ss-section-title    { font-size:1rem; font-weight:600; margin:1.5rem 0 .75rem; }

.ss-table-wrapper    { overflow-x:auto; border:1px solid #e5e7eb; border-radius:.5rem; margin-bottom:2rem; }
.ss-table            { width:100%; border-collapse:collapse; font-size:.875rem; }
.ss-table thead th   { background:#f9fafb; padding:.75rem 1rem; text-align:left; font-weight:600; border-bottom:1px solid #e5e7eb; }
.ss-table tbody tr   { border-bottom:1px solid #f3f4f6; }
.ss-table td         { padding:.625rem 1rem; vertical-align:middle; }
.ss-row-paused       { opacity:.5; }

.ss-key              { font-family:monospace; background:#f3f4f6; padding:.1rem .4rem; border-radius:.2rem; font-size:.8rem; }
.ss-meta             { font-size:.75rem; color:#9ca3af; margin:.2rem 0 0; }
.ss-mode             { display:inline-block; padding:.125rem .5rem; border-radius:.25rem; font-size:.7rem; font-weight:600; text-transform:uppercase; }
.ss-mode-sync        { background:#dbeafe; color:#1d4ed8; }
.ss-mode-async       { background:#f3e8ff; color:#7c3aed; }

.ss-badge            { display:inline-block; padding:.125rem .5rem; border-radius:.25rem; font-size:.7rem; font-weight:600; text-transform:uppercase; }
.ss-badge-active     { background:#dcfce7; color:#16a34a; }
.ss-badge-paused     { background:#f3f4f6; color:#6b7280; }

.ss-actions          { display:flex; gap:.4rem; }
.ss-btn              { padding:.375rem .875rem; border-radius:.375rem; border:1px solid #d1d5db; background:#fff; cursor:pointer; font-size:.8125rem; text-decoration:none; color:#374151; }
.ss-btn:hover        { background:#f3f4f6; }
.ss-btn-primary      { background:#111827; color:#fff; border-color:#111827; }
.ss-btn-primary:hover{ background:#1f2937; }
.ss-btn-small        { padding:.25rem .625rem; font-size:.75rem; }
.ss-btn-danger       { border-color:#fca5a5; color:#dc2626; }
.ss-btn-danger:hover { background:#fee2e2; }

.ss-two-col          { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
.ss-card-list        { display:flex; flex-direction:column; gap:.5rem; }
.ss-card             { border:1px solid #e5e7eb; border-radius:.5rem; padding:.75rem 1rem; }
.ss-card-name        { margin:.25rem 0 .2rem; font-size:.875rem; font-weight:500; }
.ss-tag              { display:inline-block; background:#f3f4f6; border-radius:.25rem; padding:.1rem .4rem; font-size:.7rem; color:#6b7280; }

.ss-empty            { padding:3rem; text-align:center; color:#9ca3af; }

@media(max-width:768px) { .ss-two-col { grid-template-columns:1fr; } }
</style>
{% endblock %}
