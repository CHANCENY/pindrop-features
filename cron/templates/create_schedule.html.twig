{% extends "templates/base.twig" %}


{% block head %}

    <link rel="stylesheet" href="/modules/cron/assets/cron.css">

{% endblock %}

{% block content %}

    <div class="form-shell">

        <!-- Form main -->
        <form method="post" class="form-main">
            <div class="form-card">
                <div class="form-card-title">Create new schedule</div>

                <!-- Basic info -->
                <div class="form-row">
                    <div class="field">
                        <label>Schedule name</label>
                        <input type="text" name="job_name" placeholder="e.g. daily_report_sync" />
                    </div>
                    <div class="field">
                        <label>Jobs</label>
                        <select name="job">
                            {% for job in jobs %}
                            <option value="{{ job.id }}">{{ job.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <!-- Schedule -->
                <div class="section-title">Schedule</div>

                <div class="field">
                    <label>Cron expression</label>
                    <input name="expression" type="text" class="mono-input" placeholder="* * * * *" value="0 * * * *" />
                    <div class="field-hint valid">→ Every hour at minute 0</div>
                    <div class="presets">
                        <span class="preset">* * * * *&nbsp; every min</span>
                        <span class="preset">0 * * * *&nbsp; hourly</span>
                        <span class="preset">0 0 * * *&nbsp; daily</span>
                        <span class="preset">0 0 * * 0&nbsp; weekly</span>
                        <span class="preset">0 0 1 * *&nbsp; monthly</span>
                        <span class="preset">*/5 * * * *&nbsp; every 5m</span>
                        <span class="preset">*/15 * * * *&nbsp; every 15m</span>
                        <span class="preset">0 9-17 * * 1-5&nbsp; business hrs</span>
                    </div>
                </div>

                <!-- Visual expression builder -->
                <div class="expr-parts">
                    <div class="expr-part">
                        <span>minute</span>
                        <input type="text" value="0" />
                    </div>
                    <div class="expr-part">
                        <span>hour</span>
                        <input type="text" value="*" />
                    </div>
                    <div class="expr-part">
                        <span>day (month)</span>
                        <input type="text" value="*" />
                    </div>
                    <div class="expr-part">
                        <span>month</span>
                        <input type="text" value="*" />
                    </div>
                    <div class="expr-part">
                        <span>day (week)</span>
                        <input type="text" value="*" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label>Subscriber</label>
                        <select name="subscriber">
                          {% for sub in subscribers %}
                              <option value="{{ sub.id() }}">{{ sub.name() }}</option>
                          {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="form-footer">
                    <button class="btn primary">Create schedule</button>
                </div>
            </div>
        </form>

    </div>

{% endblock %}

{% block scripts %}

    <script src="/modules/cron/assets/cron.js"></script>

{% endblock %}