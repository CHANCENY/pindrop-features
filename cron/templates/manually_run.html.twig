{% extends "templates/base.twig" %}


{% block head %}

    <link rel="stylesheet" href="/modules/cron/assets/cron.css">

{% endblock %}

{% block content %}

    <div class="form-shell">

        <!-- Form main -->
        <form method="post" class="form-main">
            <div class="form-card">
                <div class="form-card-title">Confirm manual cron run</div>
                <div class="form-footer">
                    <p>Are you sure you want to run this schedule now "{{ schedule.job_name }}" ?</p>
                    <button class="btn primary">Confirm</button>
                    <a href="{{ url('cron.dashboard') }}" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </form>

    </div>

{% endblock %}

{% block scripts %}

    <script src="/modules/cron/assets/cron.js"></script>

{% endblock %}