{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>New silo</h2>
        </div>
        <div class="header-right">
            <a href="{{ url('farm.erp.feeding') }}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Feeding Management
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post">
            <div class="card">
                <div class="card-header">
                    <h3>Silo Details</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">
                                Name</label>
                            <input type="text" name="name" placeholder="e.g. Silo 1"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">
                                Contents</label>
                            <input type="text" name="contents" placeholder="e.g. Corn"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                    
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Capacity</label>
                            <input type="number" name="capacity_tons" placeholder="e.g. 400"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Current level pct</label>
                            <input type="number" name="current_level_pct" placeholder="e.g. 400"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        
                    </div>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="{{ url('farm.erp.feeding') }}"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <button type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Save Formula
                </button>
            </div>
        </form>
    </div>
</main>

{% endblock %}