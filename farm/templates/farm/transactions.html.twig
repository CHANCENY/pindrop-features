{% extends 'templates/farm/base.html.twig' %}

{% block content %}


<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Financial Management</h2>
        </div>
        <div class="header-right">
            <a href="{{ url('farm.erp.transactions.add') }}"
                style="text-decoration:none; background: var(--secondary-color); color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-plus"></i> Add Income
            </a>
            <a href="{{ url('farm.erp.transactions.expense') }}"
                style="text-decoration:none; background: var(--danger); color: white; border: none; padding: 10px 20px; 
                border-radius: 5px; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-minus"></i> Add Expense
            </a>
            <a href="{{ url('farm.erp.transactions.export.ledger') }}"
                style="text-decoration:none; background: var(--primary-color); color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: 600;">
                <i class="fas fa-download"></i> Export Ledger
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <div class="stats-grid">
            <div class="stat-card">
                <span class="label">TOTAL REVENUE ({{statics.year_q}})</span>
                <span class="value">{{ statics.year_income|figure_to_currency }}</span>
            </div>
            <div class="stat-card">
                <span class="label">TOTAL EXPENSES ({{statics.year_q}})</span>
                <span class="value">{{ statics.year_expense|figure_to_currency }}</span>
            </div>
            <div class="stat-card">
                <span class="label">NET PROFIT ({{statics.year_q}})</span>
                <span class="value">{{ statics.net_profile|figure_to_currency }}</span>
            </div>
            <div class="stat-card">
                <span class="label">PENDING INVOICES ({{statics.year_q}})</span>
                <span class="value">{{ statics.pending_invoice|figure_to_currency }}</span>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Recent Transactions</h3>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Entity</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for transaction in  transactions %}
                        <tr>
                            <td>{{ transaction.created_at|date('F d, Y') }}</td>
                            <td><span style="color: var(--success);">{{ transaction.category }}</span></td>
                            <td>{{ transaction.description }}</td>
                            <td>{{ transaction.entity_name }}</td>
                            <td><strong>{% if transaction.transaction_type == 'Income' %}+{% else %}-{% endif %}
                                 {{ transaction.amount|figure_to_currency }}</strong></td>
                            <td><span class="status-pill {{ transactions.status|lower }}">{{ transaction.status }}</span></td>
                            <td>
                                <a href="{{ url('farm.erp.transactions.income.edit', {id: transaction.transaction_id}) }}"
                                    class="use-ajax" data-dialog-type="modal"
                                    data-dialog-options="{&quot;width&quot;:900}"
                                    data-link-system-path="{{ url('farm.erp.transactions.income.edit', {id: transaction.transaction_id}) }}"
                                    style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                                    <i class="fas fa-edit"></i> Edit
                                </a>

                                 <a href="{{ url('farm.erp.transactions.income.duplicate', {id: transaction.transaction_id}) }}"
                                    class="use-ajax" data-dialog-type="modal"
                                    data-dialog-options="{&quot;width&quot;:900}"
                                    data-link-system-path="{{ url('farm.erp.transactions.income.duplicate', {id: transaction.transaction_id}) }}"
                                    style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                                    <i class="fas fa-copy"></i> Duplicate
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

{% endblock %}