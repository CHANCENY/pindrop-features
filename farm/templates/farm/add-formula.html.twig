{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>New Feed Formula</h2>
        </div>
        <div class="header-right">
            <a href="{{ url('farm.erp.feeding')}}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Feeding Management
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post">
            <div class="card">
                <div class="card-header">
                    <h3>Formula Details</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Formula
                                Name</label>
                            <input type="text" name="name" placeholder="e.g. Starter Mix B"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Target
                                Group</label>
                            <select name="target"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option>Weaned Piglets</option>
                                <option>Pregnant Sows</option>
                                <option>Lactating Sows</option>
                                <option>Fattening Pigs</option>
                                <option>Boars</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Target
                                Cost / Ton</label>
                            <input type="number" name="cost" placeholder="e.g. 400"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Status</label>
                            <select name="status"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option>Active</option>
                                <option>Draft</option>
                                <option>Discontinued</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Ingredient Composition</h3>

                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th>Ingredient</th>
                                <th>Percentage (%)</th>
                                <th>Cost / Ton</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="ingredientTableBody">
                            <tr>
                                <td>

                                    <select name="ingredient[ingredient_name][]"
                                        style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                       
                                        {% for silo in  silos %}
                                        <option value="{{ silo.silo_id }}"> {{ silo.contents }}</option>
                                        {% endfor %}
                                    </select>



                                </td>
                                <td><input type="number" placeholder="45" name="ingredient[percentage][]"
                                        style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
                                </td>
                                <td><input type="number" placeholder="180" name="ingredient[cost_per_ton][]"
                                        style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
                                </td>
                                <td><i class="fas fa-trash" style="color: var(--danger); cursor:pointer;"></i></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" id="addIngredientRow"
                        style="margin-top: 15px; padding: 8px 16px; background: transparent; border: 1px dashed var(--primary-color); color: var(--primary-color); border-radius: 4px; cursor: pointer;">
                        <i class="fas fa-plus"></i> Add Ingredient Row
                    </button>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="{{ url('farm.erp.feeding')}}"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <buatton type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Save Formula
                </buatton>
            </div>
        </form>
    </div>
</main>

<script>
    const tbody = document.getElementById("ingredientTableBody");
    const addButton = document.getElementById("addIngredientRow");

    addButton.addEventListener("click", function () {
        const row = document.createElement("tr");

        row.innerHTML = `
        <td>
           <select name="ingredient[ingredient_name][]"
                                        style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                       
                                        {% for silo in  silos %}
                                        <option value="{{ silo.silo_id }}"> {{ silo.contents }}</option>
                                        {% endfor %}
                                    </select>

        </td>
        <td>
            <input type="number" placeholder="0" name="ingredient[percentage][]"
                style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
        </td>
        <td>
            <input type="number" placeholder="0" name="ingredient[cost_per_ton][]"
                style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
        </td>
        <td>
            <i class="fas fa-trash delete-row"
               style="color: var(--danger); cursor:pointer;"></i>
        </td>
    `;

        tbody.appendChild(row);
    });

    // Remove row
    tbody.addEventListener("click", function (e) {
        if (e.target.classList.contains("delete-row")) {
            e.target.closest("tr").remove();
        }
    });
</script>


{% endblock %}