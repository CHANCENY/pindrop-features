{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Add Purchase Order</h2>
        </div>
        <div class="header-right">
            <a href="{{ url(farm.erp.purchases) }}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Purchase Orders
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post">
            <div class="card">
                <div class="card-header">
                    <h3>Order Details</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">PO
                                Number</label>
                            <input type="text" name="po_number" placeholder="" value="PO-2026-0143" id="po_number"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <noscript autocomplete='true' style="display:none;">
                            {
                            "fieldId": "po_number",
                            "source": "autocomplete.pigs.po_number",
                            "placeholder": "Generate PO number..",
                            "minQueryLength": 0,
                            "limit": 10,
                            "displayField": "label",
                            "valueField": "value",
                            "searchFields": [
                            "title",
                            "id"
                            ],
                            "noResultsText": "No po number generated",
                            "loadingText": "generating...",
                            "name": "po_number",
                            "onSelect": null
                            }
                        </noscript>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Supplier</label>
                            <input type="text" name="supplier" placeholder="e.g. AgriFeed Ltd"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Order
                                Date</label>
                            <input type="date" name="order_date"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Expected
                                Delivery</label>
                            <input type="date" name="expected_delivery"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Delivery
                                Location</label>
                            <select name="delivery_location"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option>Pick up point</option>
                                <option>Customer location</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">
                                Purchase type</label>
                            <select name="purchase_type"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option>Income</option>
                                <option>Expense</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Status</label>
                            <select name="status"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option>Draft</option>
                                <option>Submitted</option>
                                <option>Awaiting Delivery</option>
                                <option>Received</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Order Items</h3>

                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Quantity</th>
                                <th>Unit</th>
                                <th>Unit Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="purchaseItemsTableBody">
                            <tr>
                                <td><input type="text" placeholder="e.g. Corn Mix" name="items[item_name][]"
                                        style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
                                </td>
                                <td><input type="number" placeholder="20" name="items[quantity][]"
                                        style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
                                </td>
                                <td><input type="text" placeholder="Tons" name="items[unit][]"
                                        style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
                                </td>
                                <td><input type="number" placeholder="360.00" name="items[unit_price][]"
                                        style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
                                </td>
                                <td><i class="fas fa-trash" style="color: var(--danger); cursor:pointer;"></i></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" id="addPurchaseItemRow"
                        style="margin-top: 15px; padding: 8px 16px; background: transparent; border: 1px dashed var(--primary-color); color: var(--primary-color); border-radius: 4px; cursor: pointer;">
                        <i class="fas fa-plus"></i> Add Item Row
                    </button>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Notes</h3>

                </div>
                <div class="card-body">
                    <div>
                        <label
                            style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Additional
                            Notes</label>
                        <textarea name="notes" placeholder="Payment terms, delivery instructions..." rows="4"
                            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;"></textarea>
                    </div>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="{{ url('farm.erp.purchases')}}"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <button type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Save Purchase Order
                </button>
            </div>
        </form>
    </div>
</main>

<script>
    const purchaseTableBody = document.getElementById("purchaseItemsTableBody");
const addPurchaseButton = document.getElementById("addPurchaseItemRow");

addPurchaseButton.addEventListener("click", function () {
    const row = document.createElement("tr");

    row.innerHTML = `
        <td>
            <input type="text" placeholder="Item" name="items[item_name][]"
                style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
        </td>
        <td>
            <input type="number" placeholder="0" name="items[quantity][]"
                style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
        </td>
        <td>
            <input type="text" placeholder="Unit" name="items[unit][]"
                style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
        </td>
        <td>
            <input type="number" placeholder="0.00" name="items[unit_price][]"
                style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:4px;">
        </td>
        <td>
            <i class="fas fa-trash delete-purchase-row"
               style="color: var(--danger); cursor:pointer;"></i>
        </td>
    `;

    purchaseTableBody.appendChild(row);
});

purchaseTableBody.addEventListener("click", function (e) {
    if (e.target.classList.contains("delete-purchase-row")) {
        e.target.closest("tr").remove();
    }
});
</script>


{% endblock %}