{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Edit Pig</h2>
        </div>
        <div class="header-right">
            <a href="livestock.html"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Livestock Registry
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post">
            <div class="card">
                <div class="card-header">
                    <h3>Pig Identification</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Tag
                                / ID Number</label>
                            <input type="text" name="tag" id="tag" placeholder="e.g. PIG-10296" value="{{ pig.pig_id }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <noscript autocomplete='true' style="display:none;">
                            {
                            "fieldId": "tag",
                            "source": "autocomplete.pigs.search.tag",
                            "placeholder": "Search tag..",
                            "minQueryLength": 0,
                            "limit": 10,
                            "displayField": "label",
                            "valueField": "value",
                            "searchFields": [
                            "title",
                            "id"
                            ],
                            "noResultsText": "No tag found",
                            "loadingText": "Searching...",
                            "name": "tag",
                            "onSelect": null
                            }
                        </noscript>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Breed</label>
                            <select name="breed"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option {% if pig.breed == 'Landrace' %} selected {% endif %}>Landrace</option>
                                <option {% if pig.breed == 'Yorkshire' %} selected {% endif %}>Yorkshire</option>
                                <option {% if pig.breed == 'Duroc' %} selected {% endif %}>Duroc</option>
                                <option {% if pig.breed == 'Hampshire' %} selected {% endif %}>Hampshire</option>
                                <option {% if pig.breed == 'Berkshire' %} selected {% endif %}>Berkshire</option>
                                <option {% if pig.breed == 'Mixed' %} selected {% endif %}>Mixed</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Sex</label>
                            <select name="sex"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option {% if pig.sex == 'Female (Sow)' %} selected {% endif %}>Female (Sow)</option>
                                <option {% if pig.sex == 'Male (Boar)' %} selected {% endif %}>Male (Boar)</option>
                                <option {% if pig.sex == 'Female (Gilt)' %} selected {% endif %}>Female (Gilt)</option>
                                <option {% if pig.sex == 'Male (Barrow)' %} selected {% endif %}>Male (Barrow)</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Date
                                of Birth</label>
                            <input type="date" name="dob" value="{{ pig.date_of_birth }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Lineage & Placement</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Sire
                                ID (Father)</label>
                            <input type="text" id="sire" name="sire" placeholder="e.g. PIG-10101" value="{{ pig.sire_id }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <noscript autocomplete='true' style="display:none;">
                            {
                            "fieldId": "sire",
                            "source": "autocomplete.pigs.search.sires",
                            "placeholder": "Search Sire..",
                            "minQueryLength": 2,
                            "limit": 10,
                            "displayField": "label",
                            "valueField": "value",
                            "searchFields": [
                            "title",
                            "id"
                            ],
                            "noResultsText": "No sires found",
                            "loadingText": "Searching...",
                            "name": "sire",
                            "onSelect": null
                            }
                        </noscript>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Dam
                                ID (Mother)</label>
                            <input type="text" id="dam" name="dam" placeholder="e.g. SOW-8842" value="{{ pig.dam_id }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <noscript autocomplete='true' style="display:none;">
                            {
                            "fieldId": "dam",
                            "source": "autocomplete.pigs.search.dams",
                            "placeholder": "Search Dam..",
                            "minQueryLength": 2,
                            "limit": 10,
                            "displayField": "label",
                            "valueField": "value",
                            "searchFields": [
                            "title",
                            "id"
                            ],
                            "noResultsText": "No dams found",
                            "loadingText": "Searching...",
                            "name": "dam",
                            "onSelect": null
                            }
                        </noscript>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Farm</label>
                            <select name="farm" id="farm"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                {% for facility in facilities %}
                                <option value="{{ facility.facility_id }}" {% if facility.facility_id == pig.facility_id %} selected {% endif %}>{{ facility.name }}</option>
                                {% endfor %}

                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Barn
                                / Pen</label>
                            <input type="text" id="location" name="location" placeholder="e.g. Barn 02, Pen 05" value="{{ pig.location_label }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <noscript autocomplete='true' style="display:none;">
                            {
                            "fieldId": "location",
                            "source": "autocomplete.pigs.search.location",
                            "placeholder": "Search location..",
                            "minQueryLength": 0,
                            "limit": 10,
                            "displayField": "label",
                            "valueField": "value",
                            "searchFields": [
                            "title",
                            "id"
                            ],
                            "noResultsText": "No location found",
                            "loadingText": "Searching...",
                            "name": "location",
                            "onSearch": "findBenAndPenInFacility"
                            }
                        </noscript>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Initial
                                Weight (kg)</label>
                            <input type="number" name="weight" placeholder="e.g. 1.4" value="{{ pig.current_weight_kg }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Health
                                Status</label>
                            <select name="status"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option {% if pig.health_status == 'Healthy' %} selected {% endif %}>Healthy</option>
                                <option {% if pig.health_status == 'Quarantine' %} selected {% endif %}>Quarantine</option>
                                <option {% if pig.health_status == 'Under Observation' %} selected {% endif %}>Under Observation</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Additional Notes</h3>

                </div>
                <div class="card-body">
                    <div>
                        <label
                            style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Notes</label>
                        <textarea name="notes" placeholder="Any additional observations..." rows="4"
                            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">{{ pig.notes }}</textarea>
                    </div>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="livestock.html"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <button type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Register Pig
                </button>
            </div>
        </form>
    </div>
</main>

<script>
    async function findBenAndPenInFacility(query, limit) {
   
        query = document.getElementById('farm').value;
        // Use backend autocomplete endpoint
        const response = await fetch(`/internal/autocomplete?source=${encodeURIComponent('autocomplete.pigs.search.location')}&q=${encodeURIComponent(query)}&limit=${limit}`);
        if (!response.ok) {
            throw new Error('Autocomplete request failed');
        }
        const data = await response.json();

        // Use standardized response format {results: [{value, label}]}
        return data.results || [];

    }
</script>

{% endblock %}