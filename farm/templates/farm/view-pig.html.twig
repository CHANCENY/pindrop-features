{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Pig Profile</h2>
        </div>
        <div class="header-right">
            <a href="livestock.html"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Livestock Registry
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <div class="card">
            <div class="card-header">
                <h3>#{{ pig.pig_id }} &mdash; Profile</h3>
                <span class="status-pill active">{{ pig.health_status }}</span>
            </div>
            <div class="card-body">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                    <div><span
                            style="font-size:0.8rem; color:var(--text-light);">Breed</span><br><strong>{{ pig.breed }}</strong>
                    </div>
                    <div><span style="font-size:0.8rem; color:var(--text-light);">Sex</span><br><strong>{{ pig.sex }}</strong></div>
                    <div><span style="font-size:0.8rem; color:var(--text-light);">Age</span><br><strong>{{ pig.date_of_birth|weeks_age }}
                            Weeks</strong></div>
                    <div><span style="font-size:0.8rem; color:var(--text-light);">Weight</span><br><strong>{{ pig.current_weight_kg }}
                            kg</strong></div>
                    <div><span style="font-size:0.8rem; color:var(--text-light);">Location</span><br><strong>{{ pig.location_label }}</strong></div>
                    <div><span style="font-size:0.8rem; color:var(--text-light);">Sire /
                            Dam</span><br><strong>{{ pig.sire_id }} / {{ pig.dam_id }}</strong></div>
                </div>
            </div>
        </div>
        <div class="tabs">
            <input type="radio" name="ptabs" id="ptab1" checked>
            <label for="ptab1">Breeding History</label>
            <div class="tab-content">
                <table>
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Boar / Semen</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for hist in history %}
                        <tr>
                            <td>{{ hist.event }}</td>
                            <td>{{ hist.date|date('F d, Y') }}</td>
                            <td>{{ hist.pig }}</td>
                            <td><span class="status-pill pending">{{ hist.outcome }}</span></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <input type="radio" name="ptabs" id="ptab2">
            <label for="ptab2">Health Records</label>
            <div class="tab-content">
                 <a 
                 style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;"
                 class="use-ajax"
                 data-dialog-type="modal" 
                 data-dialog-options="{&quot;width&quot;:900}" 
                 data-link-system-path="{{ url('farm.erp.health.add', {pid: pig.pig_id}) }}"
                 >Add Treatment</a>
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Diagnosis</th>
                            <th>Treatment</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for treatment in treatments %}
                        <tr>
                            <td>{{ treatment.diagnosis }}</td>
                            <td>{{ treatment.treatment  }}</td>
                            <td>{{ treatment.treatment_date|date('F d, Y')  }}</td>
                            <td><span class="status-pill {{ treatmentoutcome|lower|replace({' ': '-'}) }}">{{ treatment.outcome }}</span></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <input type="radio" name="ptabs" id="ptab3">
            <label for="ptab3">Weight History</label>
            <div class="tab-content">
                <a 
                 style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;"
                 class="use-ajax"
                 data-dialog-type="modal" 
                 data-dialog-options="{&quot;width&quot;:900}" 
                 data-link-system-path="{{ url('farm.erp.livestock.pigs.weight.add', {'id': pig.pig_id}) }}"
                 >Add Weight</a>
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Weight (kg)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for weight in weights %}
                        <tr>
                            <td>{{ weight.recorded_date|date('F d, Y') }}</td>
                            <td>{{ weight.weight_kg }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

{% endblock %}