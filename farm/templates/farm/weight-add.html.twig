{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Add Pig weight ({{ pig.pig_id }})</h2>
        </div>
        <div class="header-right">
            <a href="{{ url('farm.erp.livestock.pigs.view',{id: pig.pig_id}) }}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Pig
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post" action="{{ url('farm.erp.livestock.pigs.weight.add', {'id': pig.pig_id}) }}">
            <div class="card">
                <div class="card-header">
                    <h3>Weight</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Weight</label>
                            <input type="number" name="weight_kg" max="400" min="1" step="1.0" placeholder="e.g. 20" value="{{ barn.capacity }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                         <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Record Date</label>
                            <input type="date" name="recorded_date"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                    </div>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="{{ url('farm.erp.facilities') }}"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <button type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Save Weight
                </button>
                <input type="hidden" name="pig_id" value="{{ pig.pig_id }}">
            </div>
        </form>
    </div>
</main>

{% endblock %}