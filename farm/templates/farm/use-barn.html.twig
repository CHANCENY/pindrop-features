{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Add New Facility Barn</h2>
        </div>
        <div class="header-right">
            <a href="{{ url('farm.erp.facilities') }}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Farm Assets
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post" action="{{ url('farm.erp.facilities.barns.use',{facility_id: facility_id}) }}">
            <div class="card">
                <div class="card-header">
                    <h3>New Barn Details</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Facility
                                Name</label>
                            <input type="text" name="name" placeholder="e.g. West Ridge Farm"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Pen Count</label>
                            <input type="text" name="pens_count" placeholder="e.g. 2"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Total
                                Capacity (Pigs)</label>
                            <input type="number" name="capacity" placeholder="e.g. 4000"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Operational
                                Status</label>
                            <select name="status"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option>Operational</option>                            
                                <option>Maintenance</option>
                                <option>Decommissioned</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="{{ url('farm.erp.facilities') }}"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <button type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Save Barn
                </button>
                <input type="hidden" name="facility_id" value="{{ facility_id }}">
            </div>
        </form>
    </div>
</main>

{% endblock %}