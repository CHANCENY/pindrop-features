{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Scan Item</h2>
        </div>
        <div class="header-right">
            <a href="{{ url(farm.erp.inventory)}}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Inventory & Stock
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <div class="card">
            <div class="card-header">
                <h3>Item Details</h3>

            </div>
            <div class="card-body">
                <form method="post" action="{{url('farm.erp.inventory.edit',{id: inventory.item_id})}}">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Item
                                Name</label>
                            <input type="text" name="name" placeholder="e.g. Ear Tags (Large)" value="{{ inventory.name }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Barcode
                                / SKU</label>
                            <input type="text" name="barcode" placeholder="e.g. 8901234567" value="{{ inventory.barcode }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Category</label>
                            <select name="category"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option {% if inventory.category == 'Ear Tags & ID' %} selected {% endif %}>Ear Tags & ID</option>
                                <option {% if inventory.category == 'Feed & Nutrition' %} selected {% endif %}>Feed & Nutrition</option>
                                <option {% if inventory.category == 'Medical & Vet Supplies' %} selected {% endif %}>Medical & Vet Supplies</option>
                                <option {% if inventory.category == 'Cleaning & Disinfectant' %} selected {% endif %}>Cleaning & Disinfectant</option>
                                <option {% if inventory.category == 'Equipment & Tools' %} selected {% endif %}>Equipment & Tools</option>
                                <option {% if inventory.category == 'Other' %} selected {% endif %}>Other</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Quantity
                                Change</label>
                            <input type="number" name="quantity" placeholder="e.g. 500 or -4" value="{{ inventory.quantity }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Unit</label>
                            <select name="unit"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                <option {% if inventory.unit == 'Units' %} selected {% endif %}>Units</option>
                                <option {% if inventory.unit == 'Boxes' %} selected {% endif %}>Boxes</option>
                                <option {% if inventory.unit == 'Bags' %} selected {% endif %}>Bags</option>
                                <option {% if inventory.unit == 'Liters' %} selected {% endif %}>Liters</option>
                                <option {% if inventory.unit == 'Kilograms' %} selected {% endif %}>Kilograms</option>
                                <option {% if inventory.unit == 'Tons' %} selected {% endif %}>Tons</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Location</label>
                            <select name="location"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                                {% for facility in facilities %}
                                <option {% if inventory.category == facility.name %} selected {% endif %}>{{ facility.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                       
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label
                            style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Notes</label>
                        <textarea name="notes" placeholder="Any additional details..." rows="3"
                            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">{{ inventory.notes }}</textarea>
                    </div>
                    <div
                        style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                        <a href="{{ url('farm.erp.inventory') }}"
                            style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                        <button type="submit"
                            style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                            <i class="fas fa-check"></i> Save Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>


{% endblock %}