 <div class="card-header">
                <h3>Pig Registry List</h3>
                <div style="font-size: 0.85rem; color: var(--text-light);">Showing {{ pigs|length }} of {{ pigs_total }} animals</div>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th>ID / Tag</th>
                            <th>Breed</th>
                            <th>Sex</th>
                            <th>Age (Weeks)</th>
                            <th>Weight (kg)</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pig in pigs %}
                        <tr>
                            <td><strong>#{{ pig.pig_id }}</strong></td>
                            <td>{{ pig.breed }}</td>
                            <td>{{ pig.sex }}</td>
                            <td>{{ pig.date_of_birth|weeks_age }}</td>
                            <td>{{ pig.current_weight_kg }}</td>
                            <td>{{ pig.location_label }}</td>
                            <td><span class="status-pill active">{{ pig.health_status }}</span></td>
                            <td>
                                <a href="{{ url('farm.erp.livestock.pigs.view',{id: pig.pig_id}) }}"
                                    style="margin-right: 10px;"><i class="fas fa-eye"
                                        style="color: var(--info); cursor: pointer;"></i></a>
                                <a href="{{ url('farm.erp.livestock.pigs.edit', {id: pig.pig_id} )}}"><i
                                        class="fas fa-edit" style="color: var(--text-light); cursor: pointer;"></i></a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>

