{% extends 'templates/farm/base.html.twig' %}

{% block content %}

<main class="main-content">
    <header>
        <div class="header-left">
            <h2>Log Forrowing</h2>
        </div>
        <div class="header-right">
            <a href="{{ url('farm.erp.inseminations') }}"
                style="text-decoration:none; color: var(--text-light); font-size: 0.9rem; display:flex; align-items:center; gap:6px;">
                <i class="fas fa-arrow-left"></i> Back to Breeding & Farrowing
            </a>
        </div>
    </header>

    <div class="content-wrapper">
        <form method="post" action="{{ url('farm.erp.inseminations.forrowing.add',{insemination_id: insemination.insemination_id}) }}">
            <div class="card">
                <div class="card-header">
                    <h3>Forrowing Details</h3>

                </div>
                <div class="card-body">
                    <div
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Sow
                                ID</label>
                            <input type="text" name="sow_id" id="sow_id" placeholder="e.g. SOW-8842" value="{{ insemination.sow_id }}"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Farrowing date</label>
                            <input type="date" name="farrowing_date"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Litter size</label>
                            <input type="number" name="litter_size" id="litter_size" placeholder="e.g. 7"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div>
                        
                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Piglets alive</label>
                            <input type="number" name="piglets_alive" placeholder="e.g. 5"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div> 

                        <div>
                            <label
                                style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Piglets stillborn</label>
                            <input type="number" name="piglets_stillborn" placeholder="e.g. 2"
                                style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;">
                        </div> 
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Notes</h3>

                </div>
                <div class="card-body">
                    <div>
                        <label
                            style="display: block; font-size: 0.8rem; color: var(--text-light); margin-bottom: 6px; font-weight: 600;">Additional
                            Notes</label>
                        <textarea name="notes" placeholder="Observations, piglets, etc..." rows="4"
                            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.9rem;"></textarea>
                    </div>
                </div>
            </div>
            <div
                style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
                <a href="{{ url('farm.erp.inseminations') }}"
                    style="text-decoration:none; padding: 10px 24px; border: 1px solid var(--border-color); color: var(--text-color); border-radius: 4px;">Cancel</a>
                <button type="submit"
                    style="padding: 10px 24px; background: var(--secondary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-check"></i> Log Forrowing
                </button>
            </div>
            <input type="hidden" name="insemination_id" value="{{ insemination.insemination_id }}">
        </form>
    </div>
</main>

<script>
    async function findBenAndPenInFacility(query, limit) {
   
        query = document.getElementById('farm').value;
        // Use backend autocomplete endpoint
        const response = await fetch(`/internal/autocomplete?source=${encodeURIComponent('autocomplete.pigs.search.location')}&q=${encodeURIComponent(query)}&limit=${limit}`);
        if (!response.ok) {
            throw new Error('Autocomplete request failed');
        }
        const data = await response.json();

        // Use standardized response format {results: [{value, label}]}
        return data.results || [];

    }
</script>


{% endblock %}