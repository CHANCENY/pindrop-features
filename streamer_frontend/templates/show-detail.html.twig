{% extends "templates/front.base.html.twig" %}

{% block hero %}

    <!-- TV Show Hero Section -->
    <section class="tv-show-hero">
        <div class="tv-show-hero-background">
            <img src="{% if tmdbShow.backdrop_path %}https://image.tmdb.org/t/p/original{{ tmdbShow.backdrop_path }}{% else %}https://image.tmdb.org/t/p/original{{ show.poster }}{% endif %}" alt="{{ tmdbShow.name|default(show.title) }}">
            <div class="tv-show-hero-overlay"></div>
        </div>
        <div class="tv-show-hero-content">
            <div class="tv-show-poster">
                <img src="{% if tmdbShow.poster_path %}https://image.tmdb.org/t/p/w500{{ tmdbShow.poster_path }}{% else %}https://image.tmdb.org/t/p/w500{{ show.poster }}{% endif %}" alt="{{ tmdbShow.name|default(show.title) }}">
            </div>
            <div class="tv-show-info">
                <h1 class="tv-show-title">{{ tmdbShow.name|default(show.title) }}</h1>
                <div class="tv-show-meta">
                    <span class="tv-show-year">{{ tmdbShow.first_air_date|date('Y')|default(show.start_year|date('Y')) }}</span>
                    <span class="tv-show-rating">⭐ {{ tmdbShow.vote_average|default(show.rating) }}</span>
                    <span class="tv-show-seasons">{{ tmdbShow.number_of_seasons|default(show.season_count) }} Seasons</span>
                    <span class="tv-show-episodes">{{ tmdbShow.number_of_episodes|default('--') }} Episodes</span>
                    <span class="tv-show-status">{{ tmdbShow.status|default(show.status) }}</span>
                    <span class="tv-show-quality">4K HDR</span>
                </div>
                <div class="tv-show-genres">
                    {% set displayGenres = tmdbShow.genres|default(show.genres) %}
                    {% if displayGenres is iterable %}
                        {% for genre in displayGenres %}
                            <span class="genre-tag">{{ genre.name|default(genre.value|default(genre)) }}</span>
                        {% endfor %}
                    {% endif %}
                </div>
                <p class="tv-show-description">{{ tmdbShow.overview|default(show.description) }}</p>
                {% if tmdbShow.tagline %}
                    <p class="tv-show-tagline">{{ tmdbShow.tagline }}</p>
                {% endif %}
                <div class="tv-show-actions">
                    <a href="{{ url('streamer.dashboard.shows.watch', {show_id: show.id}) }}" class="btn-primary play-first-episode-btn">▶ Play First Episode</a>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block main %}

    <!-- Main Content -->
    <main class="main-content">
        <!-- Episodes Section -->
        <section class="episodes-section">
            <div class="episodes-header">
                <h2 class="section-title">Episodes</h2>
                <div class="episodes-controls">
                    <select class="season-selector" id="seasonSelector">
                        {% if seasons %}
                            {% for season in seasons %}
                                <option value="{{ season.id }}">{{ season.title }} ({{ season.episode_count }} episodes)</option>
                            {% endfor %}
                        {% else %}
                            <option value="1">Season 1 ({{ show.season_count }} episodes)</option>
                        {% endif %}
                    </select>
                    <button class="btn-secondary play-season-btn" id="playSeasonBtn">▶ Play Season</button>
                </div>
            </div>
            <div class="episodes-list" id="episodesList">
                <!-- Episodes will be dynamically added -->
            </div>
        </section>

        <!-- Cast & Crew -->
        <section class="cast-section">
            <h2 class="section-title">Cast & Crew</h2>
            <div class="cast-grid" id="castGrid">
                <!-- Cast will be dynamically added -->
            </div>
        </section>

        <!-- TV Show Details -->
        <section class="tv-show-details-section">
            <h2 class="section-title">Show Details</h2>
            <div class="details-grid">
                <div class="detail-item">
                    <span class="detail-label">Creators:</span>
                    <span class="detail-value">
                        {% if tmdbShow.created_by %}
                            {% for creator in tmdbShow.created_by %}
                                {{ creator.name }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            --
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Network:</span>
                    <span class="detail-value">
                        {% if tmdbShow.networks %}
                            {% for network in tmdbShow.networks %}
                                {{ network.name }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            --
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">First Aired:</span>
                    <span class="detail-value">{{ tmdbShow.first_air_date|date('F j, Y')|default(show.start_year|date('F j, Y')) }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Last Aired:</span>
                    <span class="detail-value">{{ tmdbShow.last_air_date|date('F j, Y')|default(show.end_year|date('F j, Y')) }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Type:</span>
                    <span class="detail-value">{{ tmdbShow.type|default('TV Series') }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Episode Runtime:</span>
                    <span class="detail-value">
                        {% if tmdbShow.episode_run_time %}
                            {{ tmdbShow.episode_run_time|join(', ') }} minutes
                        {% else %}
                            --
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Original Language:</span>
                    <span class="detail-value">{{ tmdbShow.original_language|default(show.country) }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Production Countries:</span>
                    <span class="detail-value">
                        {% if tmdbShow.production_countries %}
                            {% for country in tmdbShow.production_countries %}
                                {{ country.name }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            {{ show.language }}
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Production Companies:</span>
                    <span class="detail-value">
                        {% if tmdbShow.production_companies %}
                            {% for company in tmdbShow.production_companies %}
                                {{ company.name }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            --
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Spoken Languages:</span>
                    <span class="detail-value">
                        {% if tmdbShow.spoken_languages %}
                            {% for language in tmdbShow.spoken_languages %}
                                {{ language.english_name }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            --
                        {% endif %}
                    </span>
                </div>
                {% if tmdbShow.homepage %}
                <div class="detail-item">
                    <span class="detail-label">Homepage:</span>
                    <span class="detail-value">
                        <a href="{{ tmdbShow.homepage }}" target="_blank">{{ tmdbShow.homepage }}</a>
                    </span>
                </div>
                {% endif %}
            </div>
        </section>

        <!-- Seasons Overview -->
        <section class="seasons-overview-section">
            <h2 class="section-title">Seasons Overview</h2>
            <div class="seasons-grid" id="seasonsGrid">
                {% if tmdbShow.seasons %}
                    {% for season in tmdbShow.seasons %}
                        <div class="season-card" data-season="{{ season.season_number }}">
                            <img src="https://image.tmdb.org/t/p/w300{{ season.poster_path }}" alt="{{ season.name }}">
                            <div class="season-info">
                                <h3>{{ season.name }}</h3>
                                <p>{{ season.episode_count }} episodes</p>
                                <p>{{ season.air_date|date('Y') }}</p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="season-card">
                        <img src="https://image.tmdb.org/t/p/w300{{ show.poster }}" alt="Season 1">
                        <div class="season-info">
                            <h3>Season 1</h3>
                            <p>{{ show.season_count }} episodes</p>
                            <p>{{ show.start_year|date('Y') }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>

        <!-- Similar TV Shows -->
        <section class="similar-shows-section">
            <h2 class="section-title">Similar TV Shows</h2>
            <div class="tv-shows-grid" id="similarShows">
                <!-- Similar shows will be dynamically added -->
            </div>
        </section>

        <!-- Reviews Section -->
        <section class="reviews-section">
            <h2 class="section-title">Reviews & Ratings</h2>
            <div class="reviews-summary">
                <div class="rating-overview">
                    <div class="rating-score">
                        <span class="score-number">{{ tmdbShow.vote_average|default(show.rating) }}</span>
                        <span class="score-stars">⭐⭐⭐⭐</span>
                        <span class="score-count">Based on {{ tmdbShow.vote_count|default('user') }} reviews</span>
                    </div>
                    <div class="rating-breakdown">
                        <div class="rating-bar">
                            <span>5 stars</span>
                            <div class="bar-container">
                                <div class="bar-fill" style="width: 72%"></div>
                            </div>
                            <span>72%</span>
                        </div>
                        <div class="rating-bar">
                            <span>4 stars</span>
                            <div class="bar-container">
                                <div class="bar-fill" style="width: 18%"></div>
                            </div>
                            <span>18%</span>
                        </div>
                        <div class="rating-bar">
                            <span>3 stars</span>
                            <div class="bar-container">
                                <div class="bar-fill" style="width: 7%"></div>
                            </div>
                            <span>7%</span>
                        </div>
                        <div class="rating-bar">
                            <span>2 stars</span>
                            <div class="bar-container">
                                <div class="bar-fill" style="width: 2%"></div>
                            </div>
                            <span>2%</span>
                        </div>
                        <div class="rating-bar">
                            <span>1 star</span>
                            <div class="bar-container">
                                <div class="bar-fill" style="width: 1%"></div>
                            </div>
                            <span>1%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="user-reviews">
                <h3>User Reviews</h3>
                <div class="review-form">
                    <div class="rating-input">
                        <label>Rate this show:</label>
                        <div class="star-rating" id="userStarRating">
                            <button class="star-btn" data-rating="1">⭐</button>
                            <button class="star-btn" data-rating="2">⭐</button>
                            <button class="star-btn" data-rating="3">⭐</button>
                            <button class="star-btn" data-rating="4">⭐</button>
                            <button class="star-btn" data-rating="5">⭐</button>
                        </div>
                    </div>
                    <textarea class="review-textarea" placeholder="Write your review..." id="userReview"></textarea>
                    <button class="btn-primary submit-review-btn" id="submitReviewBtn">Submit Review</button>
                </div>

                <div class="reviews-list" id="reviewsList">
                    <!-- Reviews will be dynamically added -->
                </div>
            </div>
        </section>
    </main>

    <!-- Add to Playlist Modal -->
    <div class="playlist-modal" id="addToPlaylistModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Add to Playlist</h3>
                <button class="close-btn" id="closeAddToPlaylistModal">&times;</button>
            </div>
            <div class="playlist-list" id="playlistList">
                <!-- Playlists will be dynamically added -->
            </div>
        </div>
    </div>

    <!-- Share Modal -->
    <div class="share-modal" id="shareModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Share TV Show</h3>
                <button class="close-btn" id="closeShareModal">&times;</button>
            </div>
            <div class="share-content">
                <div class="share-link">
                    <input type="text" id="shareLink" readonly value="{{ url('streamer_frontend.front.show.detail', {show_id: show.id}) }}">
                    <button class="btn-primary copy-link-btn" id="copyLinkBtn">Copy Link</button>
                </div>
                <div class="share-options">
                    <button class="share-btn" data-platform="facebook">Facebook</button>
                    <button class="share-btn" data-platform="twitter">Twitter</button>
                    <button class="share-btn" data-platform="whatsapp">WhatsApp</button>
                    <button class="share-btn" data-platform="email">Email</button>
                </div>
            </div>
        </div>
    </div>

{% endblock %}


{% block scripts %}

    <script>
        document.addEventListener("DOMContentLoaded",()=>{

            document.querySelector("#playSeasonBtn").addEventListener('click',()=>{
                const seasonNumber = document.querySelector("#seasonSelector");
                window.location.href = "{{ url('streamer.dashboard.shows.watch',{show_id: show.id}) }}?sid=" + seasonNumber.value;
            })


        })
    </script>





{% endblock %}
