
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
<style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

    :root{
        --bg:#f0f0f5;
        --sidebar:#1a1a2e;
        --sidebar2:#16213e;
        --panel:#ffffff;
        --panel2:#f7f7fc;
        --border:#e2e2ee;
        --accent:#5b4fcf;
        --accent2:#7c6fef;
        --accent-light:#ede9ff;
        --green:#22c55e;
        --green-bg:#dcfce7;
        --yellow:#f59e0b;
        --yellow-bg:#fef3c7;
        --red:#ef4444;
        --red-bg:#fee2e2;
        --blue:#3b82f6;
        --blue-bg:#dbeafe;
        --text:#1a1a2e;
        --text2:#4a4a6a;
        --muted:#9090b0;
        --white:#ffffff;
        --shadow:0 1px 3px rgba(26,26,46,0.08), 0 4px 16px rgba(26,26,46,0.04);
        --shadow-lg:0 8px 32px rgba(26,26,46,0.12);
    }

    html,body{height:100%;overflow:hidden;}
    body{font-family:'Lato',sans-serif;background:var(--bg);color:var(--text);display:flex;}

    /* ── SIDEBAR ── */
    .sidebar{
        width:64px;background:var(--sidebar);
        display:flex;flex-direction:column;align-items:center;
        padding:20px 0;gap:6px;flex-shrink:0;z-index:10;
    }
    .sidebar-logo{
        width:36px;height:36px;border-radius:10px;
        background:linear-gradient(135deg,var(--accent2),var(--accent));
        display:flex;align-items:center;justify-content:center;
        margin-bottom:20px;
    }
    .sidebar-logo svg{color:#fff;}
    .sib-btn{
        width:44px;height:44px;border-radius:12px;border:none;
        background:transparent;color:#6b6b9b;cursor:pointer;
        display:flex;align-items:center;justify-content:center;
        transition:background 0.2s,color 0.2s;position:relative;
    }
    .sib-btn:hover{background:rgba(255,255,255,0.08);color:#fff;}
    .sib-btn.active{background:rgba(91,79,207,0.3);color:var(--accent2);}
    .sib-btn .badge{
        position:absolute;top:6px;right:6px;
        width:8px;height:8px;border-radius:50%;
        background:var(--red);border:2px solid var(--sidebar);
    }
    .sidebar-bottom{margin-top:auto;display:flex;flex-direction:column;align-items:center;gap:8px;}
    .avatar-sm{
        width:34px;height:34px;border-radius:50%;
        background:linear-gradient(135deg,#f59e0b,#ef4444);
        display:flex;align-items:center;justify-content:center;
        font-size:0.75rem;font-weight:700;color:#fff;font-family:'Syne',sans-serif;
        cursor:pointer;
    }

    /* ── CONVERSATION LIST ── */
    .conv-panel{
        width:300px;background:var(--panel);
        border-right:1px solid var(--border);
        display:flex;flex-direction:column;flex-shrink:0;
    }
    .conv-header{
        padding:20px 16px 12px;border-bottom:1px solid var(--border);
    }
    .conv-header h2{
        font-family:'Syne',sans-serif;font-size:1rem;font-weight:700;
        color:var(--text);margin-bottom:12px;
    }
    .search-box{
        display:flex;align-items:center;gap:8px;
        background:var(--panel2);border:1px solid var(--border);
        border-radius:10px;padding:8px 12px;
        transition:border-color 0.2s,box-shadow 0.2s;
    }
    .search-box:focus-within{border-color:var(--accent2);box-shadow:0 0 0 3px rgba(124,111,239,0.1);}
    .search-box input{
        border:none;background:transparent;font-family:inherit;
        font-size:0.83rem;color:var(--text);outline:none;width:100%;
    }
    .search-box input::placeholder{color:var(--muted);}
    .search-box svg{color:var(--muted);flex-shrink:0;}

    .conv-filters{
        display:flex;gap:4px;padding:10px 16px;border-bottom:1px solid var(--border);
    }
    .filter-tab{
        padding:4px 10px;border-radius:20px;border:none;background:transparent;
        font-family:inherit;font-size:0.75rem;font-weight:600;color:var(--muted);
        cursor:pointer;transition:background 0.2s,color 0.2s;
    }
    .filter-tab.active{background:var(--accent-light);color:var(--accent);}
    .filter-tab:hover:not(.active){background:var(--bg);}

    .conv-list{flex:1;overflow-y:auto;}
    .conv-list::-webkit-scrollbar{width:3px;}
    .conv-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}

    .conv-item{
        padding:14px 16px;border-bottom:1px solid var(--border);
        cursor:pointer;transition:background 0.15s;position:relative;
        display:flex;flex-direction:column;gap:6px;
    }
    .conv-item:hover{background:var(--panel2);}
    .conv-item.active{background:var(--accent-light);}
    .conv-item.unread::before{
        content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);
        width:3px;height:32px;border-radius:0 3px 3px 0;
        background:var(--accent);
    }

    .conv-item-top{display:flex;align-items:center;gap:10px;}
    .conv-avatar{
        width:36px;height:36px;border-radius:50%;flex-shrink:0;
        display:flex;align-items:center;justify-content:center;
        font-size:0.78rem;font-weight:700;font-family:'Syne',sans-serif;color:#fff;
    }
    .conv-meta{flex:1;min-width:0;}
    .conv-name{
        font-size:0.85rem;font-weight:700;color:var(--text);
        white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    }
    .conv-time{font-size:0.7rem;color:var(--muted);white-space:nowrap;}
    .conv-preview{
        font-size:0.78rem;color:var(--text2);
        white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
        padding-left:46px;
    }
    .conv-tags{display:flex;gap:4px;padding-left:46px;}
    .tag{
        padding:2px 7px;border-radius:6px;font-size:0.68rem;font-weight:600;
        font-family:'Syne',sans-serif;
    }
    .tag-open{background:var(--blue-bg);color:var(--blue);}
    .tag-urgent{background:var(--red-bg);color:var(--red);}
    .tag-waiting{background:var(--yellow-bg);color:var(--yellow);}
    .tag-resolved{background:var(--green-bg);color:var(--green);}

    /* ── MAIN CHAT ── */
    .chat-main{flex:1;display:flex;flex-direction:column;overflow:hidden;}

    .chat-topbar{
        padding:0 24px;height:64px;min-height:64px;
        background:var(--panel);border-bottom:1px solid var(--border);
        display:flex;align-items:center;gap:16px;
    }
    .topbar-info{flex:1;display:flex;align-items:center;gap:12px;}
    .topbar-avatar{
        width:38px;height:38px;border-radius:50%;
        display:flex;align-items:center;justify-content:center;
        font-size:0.78rem;font-weight:700;font-family:'Syne',sans-serif;color:#fff;
    }
    .topbar-name{font-family:'Syne',sans-serif;font-size:0.95rem;font-weight:700;color:var(--text);}
    .topbar-sub{font-size:0.75rem;color:var(--muted);margin-top:1px;}
    .topbar-actions{display:flex;gap:6px;}
    .action-btn{
        display:flex;align-items:center;gap:6px;
        padding:7px 14px;border-radius:8px;border:1px solid var(--border);
        background:var(--panel);font-family:inherit;font-size:0.8rem;
        font-weight:600;color:var(--text2);cursor:pointer;
        transition:background 0.2s,border-color 0.2s,color 0.2s;
    }
    .action-btn:hover{background:var(--bg);border-color:var(--border);}
    .action-btn.primary{
        background:var(--accent);color:#fff;border-color:var(--accent);
    }
    .action-btn.primary:hover{background:var(--accent2);}
    .action-btn.danger{color:var(--red);border-color:var(--red-bg);}
    .action-btn.danger:hover{background:var(--red-bg);}

    /* Messages area */
    .messages-area{
        flex:1;overflow-y:auto;padding:24px;
        display:flex;flex-direction:column;gap:16px;
        background:var(--panel2);
    }
    .messages-area::-webkit-scrollbar{width:4px;}
    .messages-area::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

    .day-divider{
        display:flex;align-items:center;gap:12px;
        font-size:0.72rem;font-weight:700;color:var(--muted);
        font-family:'Syne',sans-serif;letter-spacing:0.05em;text-transform:uppercase;
    }
    .day-divider::before,.day-divider::after{
        content:'';flex:1;height:1px;background:var(--border);
    }

    .msg-row{display:flex;gap:10px;animation:fadeUp 0.25s ease;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
    .msg-row.agent{flex-direction:row-reverse;}

    .msg-ava{
        width:32px;height:32px;border-radius:50%;flex-shrink:0;
        display:flex;align-items:center;justify-content:center;
        font-size:0.72rem;font-weight:700;font-family:'Syne',sans-serif;
        color:#fff;align-self:flex-end;
    }
    .msg-body{max-width:62%;}
    .msg-sender{font-size:0.72rem;font-weight:700;color:var(--muted);margin-bottom:4px;font-family:'Syne',sans-serif;}
    .msg-row.agent .msg-sender{text-align:right;}
    .msg-bubble{
        padding:11px 15px;border-radius:16px;
        font-size:0.875rem;line-height:1.6;color:var(--text);
        background:var(--panel);border:1px solid var(--border);
        border-bottom-left-radius:4px;
    }
    .msg-row.agent .msg-bubble{
        background:var(--accent);color:#fff;border-color:var(--accent);
        border-bottom-right-radius:4px;border-bottom-left-radius:16px;
    }
    .msg-time-row{
        display:flex;align-items:center;gap:6px;margin-top:4px;
    }
    .msg-row.agent .msg-time-row{flex-direction:row-reverse;}
    .msg-time{font-size:0.68rem;color:var(--muted);}
    .msg-status{display:flex;align-items:center;color:var(--accent2);}

    .system-event{
        display:flex;align-items:center;justify-content:center;gap:8px;
        font-size:0.75rem;color:var(--muted);font-style:italic;
    }
    .system-event span{
        background:var(--border);padding:3px 10px;border-radius:20px;
        font-family:'Syne',sans-serif;font-size:0.72rem;font-style:normal;font-weight:600;
    }

    /* Reply area */
    .reply-area{
        background:var(--panel);border-top:1px solid var(--border);
        padding:16px 24px 20px;
    }
    .reply-tabs{display:flex;gap:0;margin-bottom:12px;}
    .reply-tab{
        padding:6px 14px;font-family:inherit;font-size:0.8rem;font-weight:600;
        border:1px solid var(--border);background:var(--bg);color:var(--muted);
        cursor:pointer;transition:all 0.15s;
    }
    .reply-tab:first-child{border-radius:8px 0 0 8px;}
    .reply-tab:last-child{border-radius:0 8px 8px 0;border-left:none;}
    .reply-tab.active{background:var(--accent);color:#fff;border-color:var(--accent);z-index:1;}
    .reply-toolbar{
        display:flex;gap:4px;padding:8px 12px;
        background:var(--panel2);border:1px solid var(--border);
        border-radius:10px 10px 0 0;border-bottom:none;
    }
    .tool-btn{
        width:28px;height:28px;border-radius:6px;border:none;
        background:transparent;color:var(--muted);cursor:pointer;
        display:flex;align-items:center;justify-content:center;
        transition:background 0.15s,color 0.15s;font-weight:700;font-size:0.85rem;
    }
    .tool-btn:hover{background:var(--border);color:var(--text);}
    .tool-sep{width:1px;background:var(--border);margin:4px 4px;}
    .reply-input-wrap{
        border:1px solid var(--border);border-radius:0 0 10px 10px;
        background:var(--panel);transition:border-color 0.2s,box-shadow 0.2s;
    }
    .reply-input-wrap:focus-within{border-color:var(--accent2);box-shadow:0 0 0 3px rgba(124,111,239,0.08);}
    #reply-input{
        width:100%;min-height:80px;max-height:160px;padding:12px 14px;
        border:none;background:transparent;outline:none;resize:none;
        font-family:inherit;font-size:0.875rem;color:var(--text);line-height:1.6;
    }
    #reply-input::placeholder{color:var(--muted);}
    .reply-actions{
        display:flex;align-items:center;justify-content:space-between;
        padding:10px 14px;border-top:1px solid var(--border);
    }
    .reply-left{display:flex;gap:6px;}
    .reply-action-btn{
        width:32px;height:32px;border-radius:8px;border:1px solid var(--border);
        background:transparent;color:var(--muted);cursor:pointer;
        display:flex;align-items:center;justify-content:center;
        transition:background 0.15s,color 0.15s,border-color 0.15s;
    }
    .reply-action-btn:hover{background:var(--bg);color:var(--text);}
    .send-group{display:flex;gap:0;}
    .send-btn{
        display:flex;align-items:center;gap:8px;
        padding:9px 20px;background:var(--accent);color:#fff;
        border:none;border-radius:8px 0 0 8px;font-family:inherit;font-size:0.85rem;
        font-weight:700;cursor:pointer;transition:background 0.2s;
    }
    .send-btn:hover{background:var(--accent2);}
    .send-dropdown{
        width:34px;background:var(--accent2);color:#fff;border:none;
        border-radius:0 8px 8px 0;border-left:1px solid rgba(255,255,255,0.2);
        cursor:pointer;display:flex;align-items:center;justify-content:center;
        transition:background 0.2s;
    }
    .send-dropdown:hover{background:#6b5fe0;}

    /* ── RIGHT PANEL ── */
    .right-panel{
        width:280px;background:var(--panel);border-left:1px solid var(--border);
        display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0;
    }
    .right-panel::-webkit-scrollbar{width:3px;}
    .right-panel::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px;}

    .rp-section{border-bottom:1px solid var(--border);padding:20px 20px 16px;}
    .rp-section-title{
        font-family:'Syne',sans-serif;font-size:0.72rem;font-weight:700;
        color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;
        margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;
    }
    .rp-section-title button{
        background:none;border:none;color:var(--muted);cursor:pointer;
        font-size:0.75rem;font-family:inherit;transition:color 0.15s;
    }
    .rp-section-title button:hover{color:var(--accent);}

    .customer-card{display:flex;flex-direction:column;align-items:center;gap:10px;}
    .customer-ava{
        width:56px;height:56px;border-radius:50%;
        display:flex;align-items:center;justify-content:center;
        font-size:1.1rem;font-weight:700;font-family:'Syne',sans-serif;color:#fff;
    }
    .customer-name{font-family:'Syne',sans-serif;font-size:0.95rem;font-weight:700;color:var(--text);}
    .customer-email{font-size:0.78rem;color:var(--muted);}
    .customer-stats{display:flex;gap:16px;margin-top:4px;}
    .cstat{text-align:center;}
    .cstat-val{font-family:'Syne',sans-serif;font-size:1rem;font-weight:700;color:var(--text);}
    .cstat-label{font-size:0.68rem;color:var(--muted);margin-top:1px;}

    .info-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
    .info-label{font-size:0.78rem;color:var(--muted);}
    .info-val{font-size:0.8rem;font-weight:600;color:var(--text);text-align:right;}
    .info-val.green{color:var(--green);}
    .info-val.yellow{color:var(--yellow);}
    .info-val.red{color:var(--red);}

    .tag-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
    .tag-editable{
        display:flex;align-items:center;gap:4px;
        padding:3px 9px;border-radius:6px;font-size:0.72rem;font-weight:700;
        background:var(--accent-light);color:var(--accent);font-family:'Syne',sans-serif;
    }
    .tag-add{
        padding:3px 9px;border-radius:6px;font-size:0.72rem;font-weight:700;
        background:var(--bg);color:var(--muted);border:1px dashed var(--border);
        cursor:pointer;transition:background 0.15s;font-family:'Syne',sans-serif;
    }
    .tag-add:hover{background:var(--border);}

    .assign-select{
        width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;
        background:var(--panel2);font-family:inherit;font-size:0.82rem;color:var(--text);
        outline:none;cursor:pointer;
    }
    .assign-select:focus{border-color:var(--accent2);}

    .prev-ticket{
        padding:10px 12px;border:1px solid var(--border);border-radius:10px;
        margin-bottom:8px;cursor:pointer;transition:background 0.15s;
    }
    .prev-ticket:hover{background:var(--panel2);}
    .pt-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;}
    .pt-id{font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--muted);}
    .pt-preview{font-size:0.78rem;color:var(--text2);}

    .notes-input{
        width:100%;min-height:70px;padding:10px 12px;
        border:1px solid var(--border);border-radius:10px;
        background:var(--panel2);font-family:inherit;font-size:0.82rem;color:var(--text);
        outline:none;resize:none;transition:border-color 0.2s;
    }
    .notes-input:focus{border-color:var(--accent2);}
    .notes-input::placeholder{color:var(--muted);}

    /* Topbar stats */
    .stat-chips{display:flex;gap:8px;margin-left:auto;margin-right:16px;}
    .stat-chip{
        display:flex;align-items:center;gap:6px;
        padding:5px 12px;border-radius:8px;border:1px solid var(--border);
        background:var(--panel2);font-size:0.78rem;font-weight:600;color:var(--text2);
    }
    .stat-chip .dot{width:7px;height:7px;border-radius:50%;}
</style>

<!-- SIDEBAR -->
<nav class="sidebar">
    <div class="sidebar-logo">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
    </div>

    <button class="sib-btn active" title="Inbox">
        <div class="badge"></div>
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/></svg>
    </button>
    <button class="sib-btn" title="All Conversations">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    </button>
    <button class="sib-btn" title="Customers">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
    </button>
    <button class="sib-btn" title="Reports">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
    </button>
    <button class="sib-btn" title="Settings">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
    </button>

    <div class="sidebar-bottom">
        <div class="avatar-sm">JK</div>
    </div>
</nav>

<!-- CONVERSATION LIST -->
<div class="conv-panel">
    <div class="conv-header">
        <h2>Inbox</h2>
        <div class="search-box">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="Search conversations…"/>
        </div>
    </div>

    <div class="conv-filters">
        <button class="filter-tab active">All</button>
        <button class="filter-tab">Mine</button>
        <button class="filter-tab">Open</button>
        <button class="filter-tab">Waiting</button>
    </div>

    <div class="conv-list" id="conv-list"></div>
</div>

<!-- CHAT MAIN -->
<div class="chat-main">
    <div class="chat-topbar">
        <div class="topbar-info">
            <div class="topbar-avatar" id="tb-avatar" style="background:linear-gradient(135deg,#f59e0b,#ef4444)"></div>
            <div>
                <div class="topbar-name" id="tb-name">Sarah Mitchell</div>
                <div class="topbar-sub" id="tb-sub">#4821 · Opened 2h ago · Billing</div>
            </div>
        </div>

        <div class="stat-chips">
            <div class="stat-chip" id="tb-status"><div class="dot" style="background:#22c55e"></div>Online</div>
            <div class="stat-chip" id="tb-tickets"><div class="dot" style="background:#f59e0b"></div>14 open tickets</div>
        </div>

        <div class="topbar-actions">
            <button class="action-btn" id="resolved-ticket">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Resolve
            </button>
            <button class="action-btn danger" id="close-con">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                Close
            </button>
        </div>
    </div>

    <div class="messages-area" id="messages-area"></div>

    <div class="reply-area">
        <div class="reply-tabs">
            <button class="reply-tab active" onclick="setTab(this,'reply')">Reply</button>
            <button class="reply-tab" onclick="setTab(this,'note')">Internal Note</button>
            <button class="reply-tab" onclick="setTab(this,'email')">Email</button>
        </div>
        <div class="reply-toolbar">
            <button class="tool-btn" title="Bold"><b>B</b></button>
            <button class="tool-btn" title="Italic"><i>I</i></button>
            <button class="tool-btn" title="Underline"><u>U</u></button>
            <div class="tool-sep"></div>
            <button class="tool-btn" title="Link">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
            </button>
            <button class="tool-btn" title="Image">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </button>
            <button class="tool-btn" title="Code">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </button>
            <div class="tool-sep"></div>
            <button class="tool-btn" title="Canned Response" style="font-size:0.7rem;font-weight:700;font-family:'Syne',sans-serif;">/#</button>
        </div>
        <div class="reply-input-wrap">
            <textarea id="reply-input" placeholder="Type your reply… (use /# for canned responses)"></textarea>
            <div class="reply-actions">
                <div class="reply-left">
                    <button class="reply-action-btn" title="Attach file">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
                    </button>
                    <button class="reply-action-btn" title="Emoji">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                    </button>
                    <button class="reply-action-btn" title="AI Assist" style="color:var(--accent)">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    </button>
                </div>
                <div class="send-group">
                    <button class="send-btn" id="send-reply">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Send Reply
                    </button>
                    <button class="send-dropdown">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RIGHT PANEL -->
<div class="right-panel">
    <div class="rp-section">
        <div class="rp-section-title">Customer <button>Edit</button></div>
        <div class="customer-card">
            <div class="customer-ava" id="rp-avatar" style="background:linear-gradient(135deg,#f59e0b,#ef4444)">SM</div>
            <div class="customer-name" id="rp-name">Sarah Mitchell</div>
            <div class="customer-email" id="rp-email">sarah.m@example.com</div>
            <div class="customer-stats">
                <div class="cstat"><div class="cstat-val" id="ct-count">7</div><div class="cstat-label">Tickets</div></div>
                <div class="cstat"><div class="cstat-val">4.2</div><div class="cstat-label">Avg CSAT</div></div>
                <div class="cstat"><div class="cstat-val" id="ct-joined">2y</div><div class="cstat-label">Customer</div></div>
            </div>
        </div>
    </div>

    <div class="rp-section">
        <div class="rp-section-title">Conversation Info</div>
        <div class="info-row"><span class="info-label">Status</span><span class="info-val green" id="cs-tag">Open</span></div>
        <div class="info-row"><span class="info-label">Priority</span><span class="info-val yellow">High</span></div>
        <div class="info-row"><span class="info-label">Channel</span><span class="info-val">Live Chat</span></div>
        <div class="info-row"><span class="info-label">Ticket ID</span><span class="info-val" style="font-family:'JetBrains Mono',monospace;font-size:0.75rem" id="cs-ticket">#4821</span></div>
    </div>

    <div class="rp-section">
        <div class="rp-section-title">Assign To</div>
        <select class="assign-select" id="assign-agent">
            <option value="0">Assign agent</option>
            {% for agentt in agents %}
            <option value="{{ agentt.id }}">{{ agentt.first_name }} {{ agentt.last_name }} {% if agent.id == agentt.id %} (You) {% endif %}</option>
            {% endfor %}
            <option value="0">Unassigned</option>
        </select>
    </div>

    <div class="rp-section">
        <div class="rp-section-title">Tags</div>
        <div class="tag-list">
            <span class="tag-editable">billing</span>
            <span class="tag-editable">pro-plan</span>
            <span class="tag-editable">refund</span>
            <button class="tag-add">+ Add</button>
        </div>
    </div>

    <div class="rp-section">
        <div class="rp-section-title">Previous Tickets</div>
        <div class="prev-ticket">
            <div class="pt-top"><span class="pt-id">#4790</span><span class="tag tag-resolved">resolved</span></div>
            <div class="pt-preview">Issue with payment gateway timeout…</div>
        </div>
        <div class="prev-ticket">
            <div class="pt-top"><span class="pt-id">#4611</span><span class="tag tag-resolved">resolved</span></div>
            <div class="pt-preview">Can't access invoices from dashboard…</div>
        </div>
        <div class="prev-ticket">
            <div class="pt-top"><span class="pt-id">#4203</span><span class="tag tag-resolved">resolved</span></div>
            <div class="pt-preview">Upgrade from Basic to Pro plan…</div>
        </div>
    </div>

    <div class="rp-section">
        <div class="rp-section-title">Internal Notes</div>
        <textarea class="notes-input" placeholder="Add a private note visible only to agents…"></textarea>
    </div>
</div>

<noscript id="agent" style="display: none;">
    {{ agent|json_encode|raw }}
</noscript>

<noscript id="conversations-list-data" style="display: none;">
    {{ tickets|json_encode|raw }}
</noscript>

<script src="/modules/chat_window/assets/support.js"></script>