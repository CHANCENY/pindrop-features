{% extends '@music/base.html.twig' %}
{% block title %}Music Admin Dashboard{% endblock %}
{% block content %}
<h1 style="font-size:1.4rem;">Music Admin Dashboard</h1>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin-bottom:28px;">
    <div class="mp-card" style="padding:16px;"><div class="mp-help">Artists</div><h2 style="margin:4px 0;">{{ total_artists }}</h2></div>
    <div class="mp-card" style="padding:16px;"><div class="mp-help">Albums</div><h2 style="margin:4px 0;">{{ total_albums }}</h2></div>
    <div class="mp-card" style="padding:16px;"><div class="mp-help">Tracks</div><h2 style="margin:4px 0;">{{ total_tracks }}</h2></div>
    <div class="mp-card" style="padding:16px;"><div class="mp-help">Pending Reports</div><h2 style="margin:4px 0; color:var(--mp-primary);">{{ pending_reports }}</h2></div>
</div>

<h2 style="font-size:1.1rem;">Recently Added Tracks</h2>
<div class="mp-card-list">
    {% for track in recent_tracks %}
        <div class="mp-track-row" style="cursor:default;">
            <img src="" alt="" width="44" height="44">
            <div class="mp-track-row__meta">
                <div class="mp-track-row__title">{{ track.title }}</div>
                <div class="mp-track-row__artist">{{ track.uploaded_by_username }}</div>
            </div>
        </div>
    {% else %}
        <p class="mp-empty-state">No tracks yet.</p>
    {% endfor %}
</div>

<div class="mp-help" style="margin-top:20px;">
    <a href="/admin/music/tracks">Manage Tracks</a> ·
    <a href="/admin/music/artists">Manage Artists</a> ·
    <a href="/admin/music/reports">Reports</a>
</div>
{% endblock %}
