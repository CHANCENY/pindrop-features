{% extends '@music/base.html.twig' %}
{% block title %}Upload — Music{% endblock %}
{% block content %}
<div class="mp-card" style="max-width:560px; margin:0 auto; padding:24px;">
    <h1 style="font-size:1.3rem; margin-top:0;">Upload a track</h1>

    {% if errors.form %}<div style="color:var(--mp-primary); font-size:.85rem; margin-bottom:10px;">{{ errors.form }}</div>{% endif %}
    {% if errors.title %}<div style="color:var(--mp-primary); font-size:.85rem; margin-bottom:10px;">{{ errors.title }}</div>{% endif %}

    <form method="post" action="/music/upload" enctype="multipart/form-data" id="mp-upload-form" data-albums-by-artist="{{ albums_by_artist_json }}">
        {% if my_artists|length > 1 %}
            <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Artist</label>
            <select name="artist_id" id="mp-upload-artist"
                    style="width:100%; padding:9px 12px; border:1px solid var(--mp-border); border-radius:8px; background:#121212; color:var(--mp-text);">
                {% for a in my_artists %}
                    <option value="{{ a.id }}" {{ a.id == preselect_artist_id ? 'selected' : '' }}>{{ a.name }}</option>
                {% endfor %}
            </select>
        {% else %}
            <input type="hidden" name="artist_id" value="{{ my_artists[0].id }}">
        {% endif %}

        <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Track title</label>
        <input type="text" name="title" value="{{ old.title|default('') }}" required
               style="width:100%; padding:9px 12px; border:1px solid var(--mp-border); border-radius:8px; background:#121212; color:var(--mp-text);">

        <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Album (optional — type a new or existing album name)</label>
        <input type="text" name="album_title" id="mp-upload-album" list="mp-album-suggestions" value="{{ old.album_title|default('') }}"
               placeholder="Leave blank for a standalone single"
               style="width:100%; padding:9px 12px; border:1px solid var(--mp-border); border-radius:8px; background:#121212; color:var(--mp-text);">
        <datalist id="mp-album-suggestions"></datalist>

        <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Genre (optional)</label>
        <input type="text" name="genre" value="{{ old.genre|default('') }}"
               style="width:100%; padding:9px 12px; border:1px solid var(--mp-border); border-radius:8px; background:#121212; color:var(--mp-text);">

        <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Lyrics (optional)</label>
        <textarea name="lyrics" rows="5"
                  style="width:100%; padding:9px 12px; border:1px solid var(--mp-border); border-radius:8px; background:#121212; color:var(--mp-text); font-family:inherit;">{{ old.lyrics|default('') }}</textarea>

        <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Audio file</label>
        <input type="file" name="audio_file" id="mp-upload-audio" accept="audio/mpeg,audio/mp3,audio/wav,audio/ogg,audio/flac,audio/mp4,audio/aac,.mp3,.wav,.ogg,.flac,.m4a,.aac" required
               style="width:100%; padding:9px 0; color:var(--mp-text);">
        <div id="mp-upload-duration-status" class="mp-help" style="margin-top:6px;">Choose a file to detect its length automatically.</div>
        <input type="hidden" name="duration_seconds" id="mp-upload-duration" value="0">

        <label style="display:block; font-weight:600; font-size:.85rem; margin:14px 0 6px;">Cover image (optional)</label>
        <input type="file" name="cover_image" accept="image/jpeg,image/png,image/webp"
               style="width:100%; padding:9px 0; color:var(--mp-text);">

        <button type="submit" class="mp-btn mp-btn--primary" id="mp-upload-submit" style="margin-top:18px;" disabled>
            Choose an audio file first
        </button>
    </form>
</div>

{% block scripts %}
<script>
(function () {
    var albumsByArtist = {};
    try {
        albumsByArtist = JSON.parse(document.getElementById('mp-upload-form').getAttribute('data-albums-by-artist') || '{}');
    } catch (e) { console.error('Invalid albums-by-artist payload', e); }

    function albumTitlesFor(artistId) {
        var list = albumsByArtist[artistId] || [];
        return list.map(function (a) { return a.title; });
    }

    function refreshAlbumSuggestions() {
        var artistSelect = document.getElementById('mp-upload-artist');
        var artistId = artistSelect ? artistSelect.value : '{{ preselect_artist_id }}';
        var datalist = document.getElementById('mp-album-suggestions');
        datalist.innerHTML = '';
        albumTitlesFor(artistId).forEach(function (title) {
            var opt = document.createElement('option');
            opt.value = title;
            datalist.appendChild(opt);
        });
    }
    refreshAlbumSuggestions();
    var artistSelect = document.getElementById('mp-upload-artist');
    if (artistSelect) artistSelect.addEventListener('change', refreshAlbumSuggestions);

    // Client-side duration extraction — see UploadService docblock for why
    // this happens in the browser rather than via a server-side audio
    // parsing library. Submit stays disabled until this succeeds so we
    // never send duration_seconds=0.
    var audioInput = document.getElementById('mp-upload-audio');
    var durationField = document.getElementById('mp-upload-duration');
    var status = document.getElementById('mp-upload-duration-status');
    var submitBtn = document.getElementById('mp-upload-submit');

    audioInput.addEventListener('change', function () {
        var file = audioInput.files[0];
        if (!file) return;

        status.textContent = 'Reading file…';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Reading file…';

        var probe = new Audio();
        var objectUrl = URL.createObjectURL(file);
        probe.preload = 'metadata';

        probe.addEventListener('loadedmetadata', function () {
            var seconds = Math.round(probe.duration || 0);
            URL.revokeObjectURL(objectUrl);

            if (!seconds || !isFinite(seconds)) {
                status.textContent = 'Could not read this file\'s length — try a different file.';
                submitBtn.disabled = true;
                submitBtn.textContent = 'Choose an audio file first';
                return;
            }

            durationField.value = String(seconds);
            var m = Math.floor(seconds / 60), s = seconds % 60;
            status.textContent = 'Detected length: ' + m + ':' + String(s).padStart(2, '0');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Upload';
        });

        probe.addEventListener('error', function () {
            URL.revokeObjectURL(objectUrl);
            status.textContent = 'Could not read this file — is it a valid audio file?';
            submitBtn.disabled = true;
            submitBtn.textContent = 'Choose an audio file first';
        });

        probe.src = objectUrl;
    });
})();
</script>
{% endblock %}

{% endblock %}
