{% extends '@music/base.html.twig' %}
{% block title %}{{ album.title }} — {{ artist.name }}{% endblock %}
{% block content %}

<div style="display:flex; gap:24px; align-items:flex-end; margin-bottom:28px; flex-wrap:wrap;">
    {% if cover %}
        <img src="{{ cover }}" alt="{{ album.title }}" style="width:200px;height:200px;border-radius:8px;object-fit:cover;box-shadow:0 8px 24px rgba(0,0,0,.4);">
    {% else %}
        <div style="width:200px;height:200px;border-radius:8px;background:var(--mp-surface-hover);display:flex;align-items:center;justify-content:center;">
            <i class="fa-solid fa-compact-disc" style="font-size:2.4rem;color:var(--mp-text-muted);"></i>
        </div>
    {% endif %}
    <div>
        <div class="mp-help">{{ album.type|capitalize }}</div>
        <h1 style="margin:4px 0; font-size:2rem;">{{ album.title }}</h1>
        <div class="mp-help">
            <a href="/music/artist/{{ artist.slug }}">{{ artist.name }}</a>
            {% if album.release_date %} · {{ album.release_date|date('Y') }}{% endif %}
            · {{ tracks|length }} songs, {{ (total_duration // 60) }} min
        </div>
        <div style="margin-top:14px;">
            <button class="mp-btn mp-btn--primary" type="button" id="mp-play-album-btn" data-tracks="{{ play_all_json|raw }}">
                <i class="fa-solid fa-play"></i> Play
            </button>
        </div>
    </div>
</div>

<div class="mp-card-list">
    {% for track in tracks %}
        {% include '@music/partials/track_row.html.twig' with { track: track, show_artist: false } %}
    {% else %}
        <p class="mp-empty-state">No tracks in this album yet.</p>
    {% endfor %}
</div>

{% block scripts %}
<script>
    (function () {
        var btn = document.getElementById('mp-play-album-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
            try {
                var tracks = JSON.parse(btn.getAttribute('data-tracks') || '[]');
                if (tracks.length > 0) {
                    window.MusicPlayer.playQueue(tracks, 0);
                }
            } catch (e) { console.error('Invalid album track payload', e); }
        });
    })();
</script>
{% endblock %}

{% endblock %}
