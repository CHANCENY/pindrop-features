{% extends "templates/base.twig" %}

{% block title %}Add Bulk Feeding Log{% endblock %}

{% block content %}
    <div class="pf-content">
        <div class="add-feeding-log-form">
            <h1>Add Bulk Feeding Log</h1>
            <form method="post">
                <label for="feed_type">Feed Type:</label>
                <input type="text" id="feed_type" name="feed_type" required>

                <label for="quantity">Quantity (kg):</label>
                <input type="number" id="quantity" name="quantity" step="0.01" required>

                <label for="feed_date">Feed Date:</label>
                <input type="date" id="feed_date" name="feed_date" required>

                <label for="pigs">Pigs</label>
                <select name="pigs[]" id="pigs" multiple>
                    {% for pig in pigs %}
                        <option value="{{ pig.id }}" selected>{{ pig.tag_number }}</option>
                    {% endfor %}
                </select>

                <button type="submit">Add Feeding Log</button>
            </form>
            <p><a href="{{ url("pig_farmer.admin_feeding_logs", {pigId: pig.id}) }}">Back to Feeding Logs</a></p>
        </div>
    </div>
{% endblock %}
