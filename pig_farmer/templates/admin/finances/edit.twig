{% extends "templates/base.twig" %}

{% block title %}Edit Financial Record{% endblock %}

{% block content %}
    <div class="edit-finance-record-form">
        <h1>Edit Financial Record</h1>
        <form action="{{ url("pig_farmer.admin_finance_edit", {id: finance.id}) }}" method="post">
            <label for="transaction_date">Transaction Date:</label>
            <input type="date" id="transaction_date" name="transaction_date" value="{{ finance.transaction_date|date("Y-m-d") }}" required>

            <label for="type">Type:</label>
            <select id="type" name="type" required>
                <option value="Income" {% if finance.type == "Income" %}selected{% endif %}>Income</option>
                <option value="Expense" {% if finance.type == "Expense" %}selected{% endif %}>Expense</option>
            </select>

            <label for="category">Category:</label>
            <input type="text" id="category" name="category" value="{{ finance.category }}" required>

            <label for="amount">Amount:</label>
            <input type="number" id="amount" name="amount" step="0.01" value="{{ finance.amount }}" required>

            <label for="description">Description:</label>
            <textarea id="description" name="description">{{ finance.description }}</textarea>

            <label for="pig_id">Related Pig (Optional):</label>
            <select id="pig_id" name="pig_id">
                <option value="">-- Select a Pig --</option>
                {% for pig in pigs %}
                    <option value="{{ pig.id }}" {% if finance.pig_id == pig.id %}selected{% endif %}>{{ pig.tag_number }} ({{ pig.breed }})</option>
                {% endfor %}
            </select>

            <button type="submit">Update Record</button>
        </form>
        <p><a href="{{ url("pig_farmer.admin_finances") }}">Back to Farm Finances</a></p>
    </div>
{% endblock %}
