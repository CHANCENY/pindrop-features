{% extends "templates/base.twig" %}

{% block title %}Add Financial Record{% endblock %}

{% block content %}
   <div class="pf-content">
       <div class="add-finance-record-form">
           <h1>Add Financial Record</h1>
           <form action="{{ url("pig_farmer.admin_finance_add") }}" method="post">
               <label for="transaction_date">Transaction Date:</label>
               <input type="date" id="transaction_date" name="transaction_date" required>

               <label for="type">Type:</label>
               <select id="type" name="type" required>
                   <option value="Income">Income</option>
                   <option value="Expense">Expense</option>
               </select>

               <label for="category">Category:</label>
               <input type="text" id="category" name="category" required>

               <label for="amount">Amount:</label>
               <input type="number" id="amount" name="amount" step="0.01" required>

               <label for="description">Description:</label>
               <textarea id="description" name="description"></textarea>

               <label for="pig_id">Related Pig (Optional):</label>
               <select id="pig_id" name="pig_id">
                   <option value="">-- Select a Pig --</option>
                   {% for pig in pigs %}
                       <option value="{{ pig.id }}">{{ pig.tag_number }} ({{ pig.breed }})</option>
                   {% endfor %}
               </select>

               <button type="submit">Add Record</button>
           </form>
           <p><a href="{{ url("pig_farmer.admin_finances") }}">Back to Farm Finances</a></p>
       </div>
   </div>
{% endblock %}
