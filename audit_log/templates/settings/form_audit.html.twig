<div class="audit-settings-form">

    <div class="audit-setting-group">
        <label for="retention_days">Log Retention (days)</label>
        <input
            type="number"
            id="retention_days"
            name="retention_days"
            value="{{ retention_days }}"
            min="1"
            max="3650"
            style="width:120px"
        >
        <p class="audit-setting-hint">
            Entries older than this will be deleted when "Purge old entries" is
            triggered. Default: 90 days.
        </p>
    </div>

    <div class="audit-setting-group">
        <label>
            <input
                type="checkbox"
                name="enabled"
                value="1"
                {% if enabled %}checked{% endif %}
            >
            Enable audit logging
        </label>
        <p class="audit-setting-hint">
            Uncheck to suspend automatic logging. Manually fired
            <code>AUDIT_LOG_ENTRY</code> events will still be recorded.
        </p>
    </div>

</div>

<style>
.audit-settings-form       { max-width:480px; }
.audit-setting-group       { margin-bottom:1.5rem; }
.audit-setting-group label { display:block; font-weight:600; margin-bottom:.375rem; font-size:.875rem; }
.audit-setting-group input[type="number"] { padding:.375rem .75rem; border:1px solid #d1d5db; border-radius:.375rem; }
.audit-setting-hint        { margin:.375rem 0 0; font-size:.8rem; color:#6b7280; }
.audit-setting-hint code   { background:#f3f4f6; padding:.1rem .3rem; border-radius:.2rem; }
</style>
