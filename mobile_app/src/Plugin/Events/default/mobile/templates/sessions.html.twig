{# ============================================================
 # templates/sessions.html.twig
 # Route: mobile_app.settings.sessions  /mobile/settings/sessions
 # PHP variables: sessions (array from CurrentUser::getSessions())
 # ============================================================ #}
{% extends "templates/mobile.base.html.twig" %}

{% block title %}Active Sessions — {{ app_name }}{% endblock %}
{% block header_title %}Active Sessions{% endblock %}

{% block content %}
<div style="padding:0 0 48px">

  <p class="mobile-list-label">Your Devices</p>

  {% if sessions is defined and sessions is not empty %}
    <div class="mobile-list" style="margin-inline:16px">
      {% for session in sessions %}
        <div class="mobile-list-item" style="cursor:default;flex-wrap:wrap;gap:8px">

          {# Device icon #}
          <div class="mobile-list-item-icon"
               style="background:color-mix(in srgb,var(--pd-primary) 10%,transparent)">
            {% if 'Mobile' in session.user_agent or 'Android' in session.user_agent or 'iPhone' in session.user_agent %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="var(--pd-primary)" stroke-width="2" stroke-linecap="round">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                <line x1="12" y1="18" x2="12.01" y2="18"/>
              </svg>
            {% else %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="var(--pd-primary)" stroke-width="2" stroke-linecap="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            {% endif %}
          </div>

          <div class="mobile-list-item-body">
            <div class="mobile-list-item-title" style="display:flex;align-items:center;gap:6px">
              {{ session.user_agent|slice(0,40) }}{% if session.user_agent|length > 40 %}…{% endif %}
              {% if session.session_id == app_session_id %}
                <span class="mobile-tag mobile-tag-primary" style="font-size:10px">Current</span>
              {% endif %}
            </div>
            <div class="mobile-list-item-subtitle">
              {{ session.ip_address ?? 'Unknown IP' }}
              {% if session.created_at is defined and session.created_at %}
                · Started {{ session.created_at|date('d M Y, H:i') }}
              {% endif %}
              {% if session.expires_at is defined and session.expires_at %}
                · Expires {{ session.expires_at|date('d M Y') }}
              {% endif %}
            </div>
          </div>

          {# Revoke button — not shown for current session #}
          {% if session.session_id != app_session_id %}
            <form method="POST" action="{{ url('mobile_app.settings.sessions') }}"
                  style="flex-shrink:0">
              <input type="hidden" name="_csrf_token" value="{{ mobile_app.__csrf_token }}">
              <input type="hidden" name="revoke_session" value="{{ session.id }}">
              <button type="submit"
                      style="height:28px;padding:0 12px;border-radius:var(--pd-radius-full);
                             border:1.5px solid var(--pd-error);background:none;
                             color:var(--pd-error);font-size:12px;font-weight:600;cursor:pointer">
                Revoke
              </button>
            </form>
          {% endif %}

        </div>
      {% endfor %}
    </div>

    {# Revoke all other sessions #}
    <div style="padding:20px 16px">
      <form method="POST" action="{{ url('mobile_app.settings.sessions') }}">
        <input type="hidden" name="_csrf_token" value="{{ mobile_app.__csrf_token }}">
        <input type="hidden" name="revoke_all" value="1">
        <button type="submit"
                class="mobile-btn mobile-btn-block"
                style="border:1.5px solid var(--pd-error);color:var(--pd-error);
                       background:none;height:48px;border-radius:var(--pd-radius)">
          Sign Out All Other Devices
        </button>
      </form>
    </div>

  {% else %}
    <div class="mobile-empty">
      <div class="mobile-empty-icon">📱</div>
      <div class="mobile-empty-title">No active sessions</div>
      <p class="mobile-empty-text">Only your current session is active.</p>
    </div>
  {% endif %}

</div>
{% endblock %}
