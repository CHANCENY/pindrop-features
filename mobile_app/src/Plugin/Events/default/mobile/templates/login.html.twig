{# ============================================================
 # pages/login.html.twig
 # Route: /user/login
 #
 # PHP variables expected:
 #   errors          array   — validation errors keyed by field
 #   old             array   — previously submitted values
 #   redirect        string  — URL to go after login (optional)
 #   social_enabled  bool    — whether OAuth buttons are shown
 #   social_providers array  — e.g. ['google', 'github', 'facebook']
 # ============================================================ #}
{% extends 'templates/mobile.base.html.twig' %}

{% block title %}Log In — {{ app_name }}{% endblock %}

{% block header_title %}Log In{% endblock %}

{% block content %}

  <div style="padding:32px 16px 48px;max-width:400px;margin:0 auto">

    {# ── App icon / branding ── #}
    <div style="text-align:center;margin-bottom:32px">
      {% if app_icon is defined and app_icon %}
        <img src="{{ app_icon }}" alt="{{ app_name }}"
             style="width:72px;height:72px;border-radius:18px;
                    box-shadow:0 4px 20px rgba(0,0,0,0.12);margin-bottom:16px">
      {% else %}
        <div style="width:72px;height:72px;border-radius:18px;
                    background:var(--pd-primary);display:inline-flex;
                    align-items:center;justify-content:center;margin-bottom:16px;
                    box-shadow:0 4px 20px color-mix(in srgb,var(--pd-primary) 40%,transparent)">
          <span style="color:#fff;font-size:32px;font-weight:700">
            {{ app_name|first }}
          </span>
        </div>
      {% endif %}
      <h1 style="margin:0 0 6px;font-size:26px;font-weight:700">Welcome back</h1>
      <p style="margin:0;color:var(--pd-text-secondary);font-size:15px">
        Sign in to {{ app_name }}
      </p>
    </div>

    {# ── Social Login ── #}
    {% if social_enabled is defined and social_enabled and social_providers is defined %}
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px">

        {% for provider in social_providers %}
          {% set provider_meta = {
            google:   { label: 'Continue with Google',   color: '#fff',    bg: '#fff',    border: 'var(--pd-border)', text: '#3c4043', icon: 'google' },
            github:   { label: 'Continue with GitHub',   color: '#fff',    bg: '#24292f', border: '#24292f',          text: '#fff',    icon: 'github' },
            facebook: { label: 'Continue with Facebook', color: '#fff',    bg: '#1877f2', border: '#1877f2',          text: '#fff',    icon: 'facebook' },
            twitter:  { label: 'Continue with Twitter',  color: '#1da1f2', bg: '#fff',    border: 'var(--pd-border)', text: '#1da1f2', icon: 'twitter' },
          } %}
          {% set meta = provider_meta[provider] ?? { label: 'Continue with ' ~ provider|capitalize, bg: 'var(--pd-bg-2)', border: 'var(--pd-border)', text: 'var(--pd-text)', icon: provider } %}

          <a
            href="/auth/{{ provider }}"
            style="display:flex;align-items:center;justify-content:center;gap:10px;
                   height:48px;border-radius:var(--pd-radius);
                   background:{{ meta.bg }};color:{{ meta.text }};
                   border:1.5px solid {{ meta.border }};
                   text-decoration:none;font-weight:600;font-size:15px;
                   transition:opacity 0.15s"
          >
            <i class="fab fa-{{ meta.icon }}" style="font-size:18px"></i>
            {{ meta.label }}
          </a>
        {% endfor %}

      </div>

      {# Divider #}
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px">
        <div style="flex:1;height:1px;background:var(--pd-divider)"></div>
        <span style="font-size:13px;color:var(--pd-text-secondary);font-weight:500">or</span>
        <div style="flex:1;height:1px;background:var(--pd-divider)"></div>
      </div>
    {% endif %}

    {# ── Login Form ── #}
    <form id="login-form" method="POST" action="{{ url('mobile_app.user.login') }}">
      {% if redirect is defined and redirect %}
        <input type="hidden" name="redirect" value="{{ redirect }}">
      {% endif %}

      <input type="hidden" name="_csrf_token" value="{{ mobile_app.__csrf_token }}">

      {# Global error #}
      {% if errors._global is defined %}
        <div class="mobile-alert mobile-alert--error" style="margin-bottom:16px">
          {{ errors._global }}
        </div>
      {% endif %}

      {# Email / Username #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="identifier">Email or Username</label>
        <input
          type="text"
          id="identifier"
          name="email"
          class="mobile-input{% if errors.identifier is defined %} error{% endif %}"
          value="{{ old.identifier ?? '' }}"
          placeholder="you@example.com"
          autocomplete="username"
          autocapitalize="none"
          inputmode="email"
          autofocus
        >
        {% if errors.identifier is defined %}
          <div class="mobile-field-error">{{ errors.identifier }}</div>
        {% endif %}
      </div>

      {# Password #}
      <div class="mobile-form-group">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <label class="mobile-label" for="password" style="margin:0">Password</label>
          <a href="{{ url('mobile_app.user.forgot_password') }}"
             style="font-size:13px;color:var(--pd-primary);font-weight:500">
            Forgot?
          </a>
        </div>
        <div style="position:relative">
          <input
            type="password"
            id="password"
            name="password"
            class="mobile-input{% if errors.password is defined %} error{% endif %}"
            style="padding-right:48px"
            placeholder="••••••••"
            autocomplete="current-password"
          >
          {# Show/hide toggle #}
          <button
            type="button"
            onclick="togglePassword('password', this)"
            style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                   background:none;border:none;cursor:pointer;
                   color:var(--pd-text-secondary);padding:4px"
            aria-label="Toggle password visibility"
          >
            <svg id="eye-icon-password" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        {% if errors.password is defined %}
          <div class="mobile-field-error">{{ errors.password }}</div>
        {% endif %}
      </div>

      {# Remember me #}
      <div style="margin-bottom:20px">
        <label class="mobile-checkbox-wrap">
          <input type="checkbox" name="remember" value="1"
                 {% if old.remember is defined and old.remember %}checked{% endif %}>
          <span style="font-size:14px;color:var(--pd-text-secondary)">Keep me logged in</span>
        </label>
      </div>

      {# Submit #}
      <button
        type="submit"
        class="mobile-btn mobile-btn-primary mobile-btn-block"
        id="login-submit"
      >
        Log In
      </button>

    </form>

    {# ── Register link ── #}
    <p style="text-align:center;margin-top:24px;font-size:15px;color:var(--pd-text-secondary)">
      Don't have an account?
      <a href="{{ url('mobile_app.user.register') }}" style="color:var(--pd-primary);font-weight:600">Sign up</a>
    </p>

  </div>

{% endblock %}

{% block scripts %}
<script>
  function togglePassword(fieldId, btn) {
    var input = document.getElementById(fieldId);
    var icon  = document.getElementById('eye-icon-' + fieldId);
    var isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    // swap icon to eye-off when visible
    icon.innerHTML = isHidden
      ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }

  document.getElementById('login-form').addEventListener('submit', function () {
    var btn = document.getElementById('login-submit');
    btn.disabled = true;
    btn.textContent = 'Logging in...';
  });
</script>
{% endblock %}