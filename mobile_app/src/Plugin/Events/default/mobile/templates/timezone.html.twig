{# ============================================================
 # templates/timezone.html.twig
 # Route: mobile_app.settings.timezone  /mobile/settings/timezone
 # ============================================================ #}
{% extends "templates/mobile.base.html.twig" %}

{% block title %}Timezone — {{ app_name }}{% endblock %}
{% block header_title %}Timezone{% endblock %}

{% block content %}
<div style="padding:0 0 48px">

  {% set statusMessages = get_messages() %}
  {% if statusMessages is not empty %}
    <div style="padding:12px 16px 0">
      {% for message in statusMessages %}
        <div class="mobile-alert mobile-alert--{{ message.type }}">
          {{ message.text }}<button onclick="this.parentElement.remove()">✕</button>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# Search filter #}
  <div style="padding:12px 16px;border-bottom:1px solid var(--pd-divider);
              position:sticky;top:0;background:var(--pd-bg);z-index:10">
    <div class="mobile-search-wrap">
      <input type="search" id="tz-search" class="mobile-input"
             placeholder="Search timezone..." oninput="filterTz(this.value)">
    </div>
  </div>

  <form method="POST" action="{{ url('mobile_app.settings.timezone') }}" id="tz-form">
    <input type="hidden" name="_csrf_token" value="{{ mobile_app.__csrf_token }}">
    <input type="hidden" name="timezone" id="tz-value"
           value="{{ (user is defined and user and user.timezone) ? user.timezone : 'UTC' }}">

    <div class="mobile-list" style="margin-inline:16px;margin-top:12px" id="tz-list">
      
      {% set current_tz = (user is defined and user and user.timezone) ? user.timezone : 'UTC' %}
      {% for tz, label in timezones %}
        <div class="mobile-list-item tz-item" data-label="{{ label|lower }}" style="cursor:pointer"
             onclick="selectTz('{{ tz }}', this)">
          <div class="mobile-list-item-body">
            <div class="mobile-list-item-title">{{ tz }}</div>
            <div class="mobile-list-item-subtitle">{{ label }}</div>
          </div>
          {% if tz == current_tz %}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="var(--pd-primary)" stroke-width="2.5" stroke-linecap="round"
                 class="tz-check" style="flex-shrink:0">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          {% else %}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="transparent"
                 stroke-width="2.5" class="tz-check" style="flex-shrink:0">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div style="padding:20px 16px">
      <button type="submit" class="mobile-btn mobile-btn-primary mobile-btn-block">
        Save Timezone
      </button>
    </div>
  </form>

</div>
{% endblock %}

{% block scripts %}
<script>
  function selectTz(tz, el) {
    document.getElementById('tz-value').value = tz;
    document.querySelectorAll('.tz-check').forEach(function(svg) {
      svg.style.stroke = 'transparent';
    });
    el.querySelector('.tz-check').style.stroke = 'var(--pd-primary)';
  }
  function filterTz(q) {
    var items = document.querySelectorAll('.tz-item');
    q = q.toLowerCase();
    items.forEach(function(item) {
      item.style.display = item.dataset.label.includes(q) ? '' : 'none';
    });
  }
</script>
{% endblock %}
