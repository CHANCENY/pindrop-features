{# ============================================================
 # pages/register.html.twig
 # Route: /user/register
 #
 # PHP variables expected:
 #   errors           array  — validation errors keyed by field
 #   old              array  — previously submitted values
 #   social_enabled   bool   — whether OAuth buttons are shown
 #   social_providers array  — e.g. ['google', 'github', 'facebook']
 #   terms_url        string — link to terms of service page
 #   privacy_url      string — link to privacy policy page
 # ============================================================ #}
{% extends 'templates/mobile.base.html.twig' %}

{% block title %}Create Account — {{ app_name }}{% endblock %}

{% block header_title %}Create Account{% endblock %}

{% block content %}

  <div style="padding:32px 16px 48px;max-width:400px;margin:0 auto">

    {# ── Branding ── #}
    <div style="text-align:center;margin-bottom:32px">
      {% if app_icon is defined and app_icon %}
        <img src="{{ app_icon }}" alt="{{ app_name }}"
             style="width:72px;height:72px;border-radius:18px;
                    box-shadow:0 4px 20px rgba(0,0,0,0.12);margin-bottom:16px">
      {% else %}
        <div style="width:72px;height:72px;border-radius:18px;
                    background:var(--pd-primary);display:inline-flex;
                    align-items:center;justify-content:center;margin-bottom:16px;
                    box-shadow:0 4px 20px color-mix(in srgb,var(--pd-primary) 40%,transparent)">
          <span style="color:#fff;font-size:32px;font-weight:700">
            {{ app_name|first }}
          </span>
        </div>
      {% endif %}
      <h1 style="margin:0 0 6px;font-size:26px;font-weight:700">Join {{ app_name }}</h1>
      <p style="margin:0;color:var(--pd-text-secondary);font-size:15px">
        Create your free account
      </p>
    </div>

    {# ── Social Sign Up ── #}
    {% if social_enabled is defined and social_enabled and social_providers is defined %}
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px">

        {% for provider in social_providers %}
          {% set provider_meta = {
            google:   { label: 'Sign up with Google',   bg: '#fff',    border: 'var(--pd-border)', text: '#3c4043', icon: 'google' },
            github:   { label: 'Sign up with GitHub',   bg: '#24292f', border: '#24292f',          text: '#fff',    icon: 'github' },
            facebook: { label: 'Sign up with Facebook', bg: '#1877f2', border: '#1877f2',          text: '#fff',    icon: 'facebook' },
            twitter:  { label: 'Sign up with Twitter',  bg: '#fff',    border: 'var(--pd-border)', text: '#1da1f2', icon: 'twitter' },
          } %}
          {% set meta = provider_meta[provider] ?? { label: 'Sign up with ' ~ provider|capitalize, bg: 'var(--pd-bg-2)', border: 'var(--pd-border)', text: 'var(--pd-text)', icon: provider } %}

          <a
            href="{{ url('mobile_app.auth.' ~ provider) }}"
            style="display:flex;align-items:center;justify-content:center;gap:10px;
                   height:48px;border-radius:var(--pd-radius);
                   background:{{ meta.bg }};color:{{ meta.text }};
                   border:1.5px solid {{ meta.border }};
                   text-decoration:none;font-weight:600;font-size:15px;
                   transition:opacity 0.15s"
          >
            <i class="fab fa-{{ meta.icon }}" style="font-size:18px"></i>
            {{ meta.label }}
          </a>
        {% endfor %}

      </div>

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px">
        <div style="flex:1;height:1px;background:var(--pd-divider)"></div>
        <span style="font-size:13px;color:var(--pd-text-secondary);font-weight:500">or</span>
        <div style="flex:1;height:1px;background:var(--pd-divider)"></div>
      </div>
    {% endif %}

    {# ── Register Form ── #}
    <form id="register-form" method="POST" action="{{ url('mobile_app.user.register') }}">
     

      {# Global error #}
      {% if errors._global is defined %}
        <div class="mobile-alert mobile-alert--error" style="margin-bottom:16px">
          {{ errors._global }}
        </div>
      {% endif %}

      {# Display Name #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="display_name">Full Name</label>
        <input
          type="text"
          id="display_name"
          name="display_name"
          class="mobile-input{% if errors.display_name is defined %} error{% endif %}"
          value="{{ old.display_name ?? '' }}"
          placeholder="Jane Doe"
          autocomplete="name"
          autofocus
        >
        {% if errors.display_name is defined %}
          <div class="mobile-field-error">{{ errors.display_name }}</div>
        {% endif %}
      </div>

      {# Username #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="username">Username</label>
        <div style="position:relative">
          <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);
                       color:var(--pd-text-secondary);font-size:15px">@</span>
          <input
            type="text"
            id="username"
            name="username"
            class="mobile-input{% if errors.username is defined %} error{% endif %}"
            style="padding-left:28px"
            value="{{ old.username ?? '' }}"
            placeholder="janedoe"
            maxlength="30"
            autocomplete="username"
            autocapitalize="none"
            pattern="[a-zA-Z0-9_.]+"
            oninput="checkUsername(this)"
          >
          {# Availability indicator #}
          <span id="username-status"
                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                       font-size:13px;display:none"></span>
        </div>
        {% if errors.username is defined %}
          <div class="mobile-field-error">{{ errors.username }}</div>
        {% else %}
          <div style="font-size:12px;color:var(--pd-text-secondary);margin-top:4px">
            Letters, numbers, underscores and dots only.
          </div>
        {% endif %}
      </div>

      {# Email #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="mobile-input{% if errors.email is defined %} error{% endif %}"
          value="{{ old.email ?? '' }}"
          placeholder="you@example.com"
          autocomplete="email"
          inputmode="email"
        >
        {% if errors.email is defined %}
          <div class="mobile-field-error">{{ errors.email }}</div>
        {% endif %}
      </div>

      {# Password #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="password">Password</label>
        <div style="position:relative">
          <input
            type="password"
            id="password"
            name="password"
            class="mobile-input{% if errors.password is defined %} error{% endif %}"
            style="padding-right:48px"
            placeholder="Min. 8 characters"
            autocomplete="new-password"
            minlength="8"
            oninput="updateStrength(this.value)"
          >
          <button
            type="button"
            onclick="togglePassword('password', this)"
            style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                   background:none;border:none;cursor:pointer;
                   color:var(--pd-text-secondary);padding:4px"
            aria-label="Toggle password visibility"
          >
            <svg id="eye-icon-password" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>

        {# Password strength bar #}
        <div style="margin-top:8px">
          <div style="display:flex;gap:4px;margin-bottom:4px">
            {% for i in 1..4 %}
              <div class="strength-bar"
                   style="flex:1;height:3px;border-radius:2px;background:var(--pd-bg-3);
                          transition:background 0.3s ease"
                   id="bar-{{ i }}"></div>
            {% endfor %}
          </div>
          <span id="strength-label"
                style="font-size:12px;color:var(--pd-text-secondary)"></span>
        </div>

        {% if errors.password is defined %}
          <div class="mobile-field-error">{{ errors.password }}</div>
        {% endif %}
      </div>

      {# Confirm Password #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="password_confirmation">Confirm Password</label>
        <div style="position:relative">
          <input
            type="password"
            id="password_confirmation"
            name="password_confirmation"
            class="mobile-input{% if errors.password_confirmation is defined %} error{% endif %}"
            style="padding-right:48px"
            placeholder="••••••••"
            autocomplete="new-password"
            oninput="checkMatch()"
          >
          <button
            type="button"
            onclick="togglePassword('password_confirmation', this)"
            style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                   background:none;border:none;cursor:pointer;
                   color:var(--pd-text-secondary);padding:4px"
            aria-label="Toggle password visibility"
          >
            <svg id="eye-icon-password_confirmation" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <div id="match-msg" style="font-size:12px;margin-top:4px"></div>
        {% if errors.password_confirmation is defined %}
          <div class="mobile-field-error">{{ errors.password_confirmation }}</div>
        {% endif %}
      </div>

      {# Terms checkbox #}
      <div style="margin-bottom:24px">
        <label class="mobile-checkbox-wrap" style="align-items:flex-start;gap:10px">
          <input
            type="checkbox"
            name="terms"
            id="terms"
            value="1"
            {% if old.terms is defined and old.terms %}checked{% endif %}
            required
            style="margin-top:2px"
          >
          <span style="font-size:14px;color:var(--pd-text-secondary);line-height:1.5">
            I agree to the
            <a href="{{ terms_url|default('/terms') }}"
               style="color:var(--pd-primary);font-weight:500">Terms of Service</a>
            and
            <a href="{{ privacy_url|default('/privacy') }}"
               style="color:var(--pd-primary);font-weight:500">Privacy Policy</a>
          </span>
        </label>
        {% if errors.terms is defined %}
          <div class="mobile-field-error" style="margin-top:4px">{{ errors.terms }}</div>
        {% endif %}
      </div>

      {# Submit #}
      <button
        type="submit"
        class="mobile-btn mobile-btn-primary mobile-btn-block"
        id="register-submit"
      >
        Create Account
      </button>

    </form>

    {# ── Login link ── #}
    <p style="text-align:center;margin-top:24px;font-size:15px;color:var(--pd-text-secondary)">
      Already have an account?
      <a href="{{ url('mobile_app.user.login') }}" style="color:var(--pd-primary);font-weight:600">Log in</a>
    </p>

  </div>

{% endblock %}

{% block scripts %}
<script>
  // ── Password show/hide ──────────────────────────────────────
  function togglePassword(fieldId, btn) {
    var input = document.getElementById(fieldId);
    var icon  = document.getElementById('eye-icon-' + fieldId);
    var isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    icon.innerHTML = isHidden
      ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }

  // ── Password strength ───────────────────────────────────────
  function updateStrength(val) {
    var score = 0;
    if (val.length >= 8)                          score++;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val))  score++;
    if (/[0-9]/.test(val))                        score++;
    if (/[^A-Za-z0-9]/.test(val))                score++;

    var colors = ['', '#e53935', '#ff9800', '#fdd835', '#43a047'];
    var labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];

    for (var i = 1; i <= 4; i++) {
      var bar = document.getElementById('bar-' + i);
      bar.style.background = i <= score ? colors[score] : 'var(--pd-bg-3)';
    }
    var lbl = document.getElementById('strength-label');
    lbl.textContent = val.length ? labels[score] : '';
    lbl.style.color = colors[score] || 'var(--pd-text-secondary)';
  }

  // ── Password match ──────────────────────────────────────────
  function checkMatch() {
    var pw   = document.getElementById('password').value;
    var conf = document.getElementById('password_confirmation').value;
    var msg  = document.getElementById('match-msg');
    if (!conf) { msg.textContent = ''; return; }
    if (pw === conf) {
      msg.textContent = '✓ Passwords match';
      msg.style.color = 'var(--pd-success, #43a047)';
    } else {
      msg.textContent = 'Passwords do not match';
      msg.style.color = 'var(--pd-error)';
    }
  }

  // ── Username availability check (debounced) ─────────────────
  var usernameTimer;
  function checkUsername(input) {
    clearTimeout(usernameTimer);
    var status = document.getElementById('username-status');
    var val = input.value.trim();
    if (!val || val.length < 3) { status.style.display = 'none'; return; }

    status.style.display = 'inline';
    status.textContent = '…';
    status.style.color = 'var(--pd-text-secondary)';

    usernameTimer = setTimeout(function () {
      fetch('/user/check-username?username=' + encodeURIComponent(val), {
        headers: { 'X-Pindrop-Engine': '1' }
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.available) {
            status.textContent = '✓';
            status.style.color = 'var(--pd-success, #43a047)';
          } else {
            status.textContent = '✗ Taken';
            status.style.color = 'var(--pd-error)';
          }
        })
        .catch(function () { status.style.display = 'none'; });
    }, 500);
  }

  // ── Submit state ────────────────────────────────────────────
  document.getElementById('register-form').addEventListener('submit', function () {
    var btn = document.getElementById('register-submit');
    btn.disabled = true;
    btn.textContent = 'Creating account...';
  });
</script>
{% endblock %}