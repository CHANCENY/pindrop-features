{# ============================================================
 # pages/profile_edit.html.twig
 # Route: /profile/edit
 #
 # PHP variables expected:
 #   user         object  — current user (display_name, username, email, bio, avatar)
 #   errors       array   — validation errors keyed by field name
 #   old          array   — previously submitted values (on failed validation)
 # ============================================================ #}
{% extends 'templates/mobile.base.html.twig' %}

{% block title %}Edit Profile — {{ app_name }}{% endblock %}

{% block header_title %}Edit Profile{% endblock %}

{% block header_actions %}
  {# Save button in header — submits the form #}
  <button
    class="mobile-btn mobile-btn-ghost"
    style="height:36px;padding:0 12px;font-size:15px;color:var(--pd-primary)"
    onclick="document.getElementById('profile-edit-form').dispatchEvent(new Event('submit'))"
  >
    Save
  </button>
{% endblock %}

{% block content %}

  <div style="padding:20px 16px 40px">

    {# ── Avatar Upload ── #}
    <div style="display:flex;flex-direction:column;align-items:center;margin-bottom:28px">

      <div style="position:relative;margin-bottom:12px">
        {% if user.avatar_url is defined and user.avatar_url %}
          <img
            src="{{ user.avatar_url }}"
            alt="Avatar"
            id="avatar-preview"
            class="mobile-avatar mobile-avatar-xl"
          >
        {% else %}
          <div
            class="mobile-avatar mobile-avatar-xl"
            id="avatar-preview-initials"
            style="font-size:32px"
          >
            {{ (user.display_name ?? user.username)|first|upper }}
          </div>
        {% endif %}

        {# Camera overlay button #}
        <label
          for="avatar-input"
          style="position:absolute;bottom:0;right:0;
                 width:30px;height:30px;border-radius:50%;
                 background:var(--pd-primary);color:#fff;
                 display:flex;align-items:center;justify-content:center;
                 cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.25)"
          aria-label="Change avatar"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8
                     a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
        </label>
        <input
          type="file"
          id="avatar-input"
          accept="image/*"
          style="display:none"
          onchange="previewAvatar(this)"
        >
      </div>

      <button
        type="button"
        onclick="document.getElementById('avatar-input').click()"
        class="mobile-btn mobile-btn-ghost"
        style="height:32px;font-size:14px;padding:0 12px"
      >
        Change Photo
      </button>
    </div>

    {# ── Form ── #}
    <form
      id="profile-edit-form"
      method="POST"
      action="{{ url('mobile_app.profile.edit') }}"
      enctype="multipart/form-data"
    >
      {# CSRF token — Pindrop provides csrf_token() #}
      <input type="hidden" name="_csrf_token" value="{{ mobile_app.__csrf_token }}">
      <input type="hidden" name="_avatar_data" id="avatar-data-input">

      {# ── Display Name ── #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="display_name">Display Name</label>
        <input
          type="text"
          id="display_name"
          name="display_name"
          class="mobile-input{% if errors.display_name is defined %} error{% endif %}"
          value="{{ old.display_name ?? user.display_name }}"
          placeholder="Your full name"
          maxlength="60"
          autocomplete="name"
        >
        {% if errors.display_name is defined %}
          <div class="mobile-field-error">{{ errors.display_name }}</div>
        {% endif %}
      </div>

      {# ── Username ── #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="username">Username</label>
        <div style="position:relative">
          <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);
                       color:var(--pd-text-secondary);font-size:15px">@</span>
          <input
            type="text"
            id="username"
            name="username"
            class="mobile-input{% if errors.username is defined %} error{% endif %}"
            style="padding-left:28px"
            value="{{ old.username ?? user.username }}"
            placeholder="username"
            maxlength="30"
            autocomplete="username"
            autocapitalize="none"
            pattern="[a-zA-Z0-9_.]+"
          >
        </div>
        {% if errors.username is defined %}
          <div class="mobile-field-error">{{ errors.username }}</div>
        {% else %}
          <div style="font-size:12px;color:var(--pd-text-secondary);margin-top:4px">
            Letters, numbers, underscores and dots only.
          </div>
        {% endif %}
      </div>

      {# ── Bio ── #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="bio">Bio</label>
        <textarea
          id="bio"
          name="bio"
          class="mobile-textarea{% if errors.bio is defined %} error{% endif %}"
          placeholder="Tell people a little about yourself..."
          maxlength="160"
          rows="3"
          oninput="updateBioCount(this)"
        >{{ old.bio ?? user.bio }}</textarea>
        <div style="display:flex;justify-content:space-between;margin-top:4px">
          {% if errors.bio is defined %}
            <div class="mobile-field-error">{{ errors.bio }}</div>
          {% else %}
            <span></span>
          {% endif %}
          <span id="bio-count" style="font-size:12px;color:var(--pd-text-secondary)">
            {{ (old.bio ?? user.bio)|length }}/160
          </span>
        </div>
      </div>

      {# ── Email ── #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="mobile-input{% if errors.email is defined %} error{% endif %}"
          value="{{ old.email ?? user.email }}"
          placeholder="you@example.com"
          autocomplete="email"
          inputmode="email"
        >
        {% if errors.email is defined %}
          <div class="mobile-field-error">{{ errors.email }}</div>
        {% endif %}
      </div>

      {# ── Website ── #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="website">Website</label>
        <input
          type="url"
          id="website"
          name="website"
          class="mobile-input{% if errors.website is defined %} error{% endif %}"
          value="{{ old.website ?? user.website }}"
          placeholder="https://yoursite.com"
          autocomplete="url"
          inputmode="url"
        >
        {% if errors.website is defined %}
          <div class="mobile-field-error">{{ errors.website }}</div>
        {% endif %}
      </div>

      {# ── Location ── #}
      <div class="mobile-form-group">
        <label class="mobile-label" for="location">Location</label>
        <input
          type="text"
          id="location"
          name="location"
          class="mobile-input{% if errors.location is defined %} error{% endif %}"
          value="{{ old.location ?? user.location }}"
          placeholder="City, Country"
          maxlength="60"
        >
        {% if errors.location is defined %}
          <div class="mobile-field-error">{{ errors.location }}</div>
        {% endif %}
      </div>

      {# ── Save Button (bottom) ── #}
      <button
        type="submit"
        class="mobile-btn mobile-btn-primary mobile-btn-block"
        style="margin-top:8px"
      >
        Save Changes
      </button>

      {# ── Cancel ── #}
      <a
        href="{{ url('mobile_app.profile') }}"
        class="mobile-btn mobile-btn-ghost mobile-btn-block"
        style="margin-top:8px;color:var(--pd-text-secondary)"
      >
        Cancel
      </a>

    </form>

  </div>

{% endblock %}

{% block scripts %}
<script>
  // Bio character counter
  function updateBioCount(el) {
    document.getElementById('bio-count').textContent = el.value.length + '/160';
  }

  // Avatar preview before upload
  function previewAvatar(input) {
    if (!input.files || !input.files[0]) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      // Update visible preview
      var img = document.getElementById('avatar-preview');
      var initials = document.getElementById('avatar-preview-initials');
      if (img) {
        img.src = e.target.result;
      } else if (initials) {
        // Replace initials div with an img
        var newImg = document.createElement('img');
        newImg.id = 'avatar-preview';
        newImg.src = e.target.result;
        newImg.alt = 'Avatar';
        newImg.className = initials.className;
        initials.replaceWith(newImg);
      }
      // Store base64 for form submission if needed
      document.getElementById('avatar-data-input').value = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }

  // Intercept form submit — engine.js handles the navigation after POST
  document.getElementById('profile-edit-form').addEventListener('submit', function (e) {
    var btn = this.querySelector('button[type="submit"]');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Saving...';
    }
  });
</script>
{% endblock %}