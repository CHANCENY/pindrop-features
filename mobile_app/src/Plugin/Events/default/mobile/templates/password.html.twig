{# ============================================================
 # templates/password.html.twig
 # Route: mobile_app.settings.password  /mobile/settings/password
 # ============================================================ #}
{% extends "templates/mobile.base.html.twig" %}

{% block title %}Change Password — {{ app_name }}{% endblock %}
{% block header_title %}Change Password{% endblock %}

{% block content %}
<div style="padding:24px 16px 48px;max-width:400px;margin:0 auto">

  {% set statusMessages = get_messages() %}
  {% if statusMessages is not empty %}
    <div class="mobile-flash-messages" style="margin-bottom:16px">
      {% for message in statusMessages %}
        <div class="mobile-alert mobile-alert--{{ message.type }}">
          {{ message.text }}
          <button onclick="this.parentElement.remove()" aria-label="Dismiss">✕</button>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <form id="password-form" method="POST" action="{{ url('mobile_app.settings.password') }}">
    <input type="hidden" name="_csrf_token" value="{{ mobile_app.__csrf_token }}">

    <div class="mobile-form-group">
      <label class="mobile-label" for="current_password">Current Password</label>
      <div style="position:relative">
        <input type="password" id="current_password" name="current_password"
               class="mobile-input" style="padding-right:48px"
               placeholder="••••••••" autocomplete="current-password" autofocus>
        <button type="button" onclick="togglePw('current_password')"
                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                       background:none;border:none;cursor:pointer;color:var(--pd-text-secondary);padding:4px"
                aria-label="Toggle visibility">
          <svg id="eye-current_password" width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-form-group">
      <label class="mobile-label" for="new_password">New Password</label>
      <div style="position:relative">
        <input type="password" id="new_password" name="new_password"
               class="mobile-input" style="padding-right:48px"
               placeholder="Min. 8 characters" autocomplete="new-password"
               minlength="8" oninput="updateStrength(this.value)">
        <button type="button" onclick="togglePw('new_password')"
                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                       background:none;border:none;cursor:pointer;color:var(--pd-text-secondary);padding:4px"
                aria-label="Toggle visibility">
          <svg id="eye-new_password" width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
      <div style="margin-top:8px">
        <div style="display:flex;gap:4px;margin-bottom:4px">
          {% for i in 1..4 %}
            <div id="bar-{{ i }}" style="flex:1;height:3px;border-radius:2px;
                 background:var(--pd-bg-3);transition:background 0.3s"></div>
          {% endfor %}
        </div>
        <span id="strength-label" style="font-size:12px;color:var(--pd-text-secondary)"></span>
      </div>
    </div>

    <div class="mobile-form-group">
      <label class="mobile-label" for="confirm_password">Confirm New Password</label>
      <div style="position:relative">
        <input type="password" id="confirm_password" name="confirm_password"
               class="mobile-input" style="padding-right:48px"
               placeholder="••••••••" autocomplete="new-password"
               oninput="checkMatch()">
        <button type="button" onclick="togglePw('confirm_password')"
                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                       background:none;border:none;cursor:pointer;color:var(--pd-text-secondary);padding:4px"
                aria-label="Toggle visibility">
          <svg id="eye-confirm_password" width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
      <div id="match-msg" style="font-size:12px;margin-top:4px"></div>
    </div>

    <button type="submit" id="pw-submit"
            class="mobile-btn mobile-btn-primary mobile-btn-block" style="margin-top:8px">
      Update Password
    </button>
    <a href="{{ url('mobile_app.settings') }}"
       class="mobile-btn mobile-btn-ghost mobile-btn-block"
       style="margin-top:8px;color:var(--pd-text-secondary)">Cancel</a>
  </form>
</div>
{% endblock %}

{% block scripts %}
<script>
  function togglePw(id) {
    var input = document.getElementById(id);
    var icon  = document.getElementById('eye-' + id);
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.innerHTML = input.type === 'text'
      ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }
  function updateStrength(val) {
    var score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    var colors = ['','#e53935','#ff9800','#fdd835','#43a047'];
    var labels = ['','Weak','Fair','Good','Strong'];
    for (var i = 1; i <= 4; i++)
      document.getElementById('bar-' + i).style.background = i <= score ? colors[score] : 'var(--pd-bg-3)';
    var lbl = document.getElementById('strength-label');
    lbl.textContent = val.length ? labels[score] : '';
    lbl.style.color = colors[score] || 'var(--pd-text-secondary)';
  }
  function checkMatch() {
    var pw = document.getElementById('new_password').value;
    var cf = document.getElementById('confirm_password').value;
    var msg = document.getElementById('match-msg');
    if (!cf) { msg.textContent = ''; return; }
    msg.textContent = pw === cf ? '✓ Passwords match' : 'Passwords do not match';
    msg.style.color = pw === cf ? 'var(--pd-success,#43a047)' : 'var(--pd-error)';
  }
  document.getElementById('password-form').addEventListener('submit', function() {
    var btn = document.getElementById('pw-submit');
    btn.disabled = true; btn.textContent = 'Updating...';
  });
</script>
{% endblock %}
