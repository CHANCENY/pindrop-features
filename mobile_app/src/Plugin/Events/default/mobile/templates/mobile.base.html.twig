{# ============================================================
 # mobile.base.html.twig
 # Mobile-only app shell — extend this for all mobile pages.
 # Only loaded when MOBILE=TRUE in .env
 #
 # Available blocks:
 #   {% block title %}        — page <title> text
 #   {% block head %}         — extra <head> tags
 #   {% block header_title %} — text shown in the top app bar
 #   {% block header_actions %}— icon buttons on the right of app bar
 #   {% block content %}      — page body (goes inside #app-content)
 #   {% block scripts %}      — page-specific JS at bottom of body
 #   {% block assets %}       — extra css/js links
 #
 # Twig globals expected:
 #   app_name              string  — site/app name
 #   app_version           string  — cache busting
 #   user                  object  — current user or null
 #   asset_handler         object  — renderCss() / renderJs()
 #   mobile_settings       string  — raw JSON from MobileSettingsService
 # ============================================================ #}

{% set _ms = mobile_settings()|raw %}
{% set app_version = mobile_app.app_version %}
{% set user = mobile_app.user %}
{% set mobile_settings = mobile_app.mobile_settings %}
{% set app_name = mobile_app.app_name %}

<!DOCTYPE html>
<html
  lang="{{ language() }}"
  data-pd-theme="{{ _ms.theme.dark_mode|default('auto') }}"
>
<head>
  <meta charset="UTF-8">

  {# Full viewport — viewport-fit=cover handles iPhone notch / Android gestures #}
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">

  <title>{% block title %}{{ app_name }}{% endblock %}</title>

  {# ── PWA / native meta ── #}
  <meta name="theme-color" content="{{ _ms.theme.status_bar_color|default('#6200ea') }}">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="{{ _ms.pwa.short_name|default(app_name) }}">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="format-detection" content="telephone=no">

  {# PWA manifest #}
  {% if _ms.pwa.enabled is defined and _ms.pwa.enabled %}
    <link rel="manifest" href="/pwa/manifest.json">
  {% endif %}

  {# Touch icon #}
  {% if _ms.pwa.icon is defined %}
    <link rel="apple-touch-icon" href="{{ _ms.pwa.icon }}">
    <link rel="icon" type="image/png" href="{{ _ms.pwa.icon }}">
  {% endif %}

  {# ── Dynamic CSS from modules ── #}
  {{ asset_handler.renderCss() }}

  {# ── Extra assets / head from child templates ── #}
  {% block assets %}{% endblock %}
  {% block head %}{% endblock %}

  {# ── Feed settings to engine BEFORE engine.js boots ── #}
  <script>window.__PINDROP_MOBILE__ = {{ mobile_settings()|raw }};</script>

</head>

<body class="mobile-body">

  {# ══════════════════════════════════════════════════════
   # MOBILE APP SHELL
   # Layout:
   #
   #  ┌─────────────────────────┐
   #  │  .mobile-header  (fixed)│
   #  ├─────────────────────────┤
   #  │                         │
   #  │  #app-content (scrolls) │  ← only this swaps on nav
   #  │                         │
   #  ├─────────────────────────┤
   #  │  #pd-bottom-nav (fixed) │  ← engine.js appends this
   #  └─────────────────────────┘
   # ══════════════════════════════════════════════════════ #}

  {# ── Mobile App Bar ── #}
  <header class="mobile-header" id="mobile-header">

    {# Back button — engine.js toggles display based on history #}
    <button
      class="mobile-header-back"
      id="pd-back-btn"
      aria-label="Go back"
      style="display:none"
      onclick="history.back()"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    {# Page title — child templates override this per page #}
    <div class="mobile-header-title" id="mobile-header-title">
      {% block header_title %}{{ app_name }}{% endblock %}
    </div>

    {# Right-side action buttons — child templates put icons here #}
    <div class="mobile-header-actions" id="mobile-header-actions">
      {% block header_actions %}{% endblock %}
    </div>

  </header>

  {# ══════════════════════════════════════════════════
   # #app-content — engine.js morphs ONLY this element.
   # Must match engine.content_selector in mobile.settings.yml
   # ══════════════════════════════════════════════════ #}
  <main
    id="app-content"
    class="mobile-content"
    role="main"
    aria-live="polite"
    aria-atomic="false"
  >

    {# Flash / status messages #}
    {% set statusMessages = get_messages() %}
    {% if statusMessages is not empty %}
      <div class="mobile-flash-messages">
        {% for message in statusMessages %}
          <div class="mobile-alert mobile-alert--{{ message.type }}">
            {{ message.text }}
            <button onclick="this.parentElement.remove()" aria-label="Dismiss">✕</button>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ── Page content — child templates fill this ── #}
    {% block content %}{% endblock %}

  </main>

  {# engine.js appends #pd-bottom-nav here based on mobile.settings.yml #}

  {# ── Dynamic JS from modules ── #}
  {{ asset_handler.renderJs() }}

  {# ── Page-specific scripts from child templates ── #}
  {% block scripts %}{% endblock %}

  {# ── Back button visibility wired to engine history ── #}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var backBtn = document.getElementById('pd-back-btn');
      if (!backBtn) return;
      function updateBackBtn() {
        backBtn.style.display = window.history.length > 1 ? 'flex' : 'none';
      }
      window.addEventListener('popstate', updateBackBtn);
      document.addEventListener('click', function () { setTimeout(updateBackBtn, 60); });
      updateBackBtn();
    });
  </script>

</body>
</html>