{# ============================================================
 # pages/home.html.twig
 # Bottom nav: Home  /
 # ============================================================ #}
{% extends "templates/mobile.base.html.twig" %}

{% block title %}Home — {{ app_name }}{% endblock %}

{% block header_title %}{{ app_name }}{% endblock %}

{% block header_actions %}
  {# Notification bell — badge shows unread count if any #}
  <button class="mobile-icon-btn" aria-label="Notifications" onclick="PindropEngine.navigate('/notifications')">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
    </svg>
    {% if unread_count is defined and unread_count > 0 %}
      <span class="mobile-badge" style="position:absolute;top:6px;right:6px;width:16px;height:16px;font-size:9px;min-width:unset">
        {{ unread_count > 99 ? '99+' : unread_count }}
      </span>
    {% endif %}
  </button>
{% endblock %}

{% block content %}

  {# ── Hero / Welcome ── #}
  {% if user is defined and user %}
    <div class="mobile-section" style="padding-bottom:8px">
      <p class="mobile-subtitle" style="padding:0;margin:0">Good {{ greeting|default('day') }},</p>
      <h2 style="margin:2px 0 0;font-size:24px">{{ user.display_name ?? user.username }} 👋</h2>
    </div>
  {% endif %}

  {# ── Featured / Banner Card ── #}
  {% if featured is defined and featured %}
    <div style="padding-inline:16px;margin-bottom:4px">
      <a href="{{ featured.url }}" class="mobile-card mobile-card-link" style="border:none;overflow:hidden">
        {% if featured.image is defined %}
          <img src="{{ featured.image }}" alt="{{ featured.title }}" class="mobile-img-cover" style="border-radius:0">
        {% else %}
          <div style="height:160px;background:linear-gradient(135deg,var(--pd-primary),var(--pd-primary-light));display:flex;align-items:center;justify-content:center">
            <span style="color:#fff;font-size:40px">✦</span>
          </div>
        {% endif %}
        <div class="mobile-card-body">
          {% if featured.tag is defined %}
            <span class="mobile-tag mobile-tag-primary" style="margin-bottom:8px">{{ featured.tag }}</span>
          {% endif %}
          <h3 style="margin:4px 0 6px;font-size:18px">{{ featured.title }}</h3>
          <p style="margin:0;color:var(--pd-text-secondary);font-size:13px">{{ featured.excerpt }}</p>
        </div>
      </a>
    </div>
  {% endif %}

  {# ── Section: Recent Items ── #}
  {% if items is defined and items is not empty %}
    <p class="mobile-list-label">Recent</p>
    <div style="padding-inline:16px">
      {% for item in items %}
        <a href="{{ item.url }}" class="mobile-card mobile-card-link">
          <div class="mobile-card-body" style="display:flex;gap:12px;align-items:center">
            {% if item.image is defined %}
              <img src="{{ item.image }}" alt=""
                   style="width:56px;height:56px;border-radius:10px;object-fit:cover;flex-shrink:0">
            {% else %}
              <div style="width:56px;height:56px;border-radius:10px;background:var(--pd-bg-2);
                          display:flex;align-items:center;justify-content:center;flex-shrink:0;
                          color:var(--pd-primary);font-size:22px">
                {{ item.icon|default('📄') }}
              </div>
            {% endif %}
            <div style="flex:1;min-width:0">
              <div class="mobile-list-item-title">{{ item.title }}</div>
              {% if item.meta is defined %}
                <div class="mobile-list-item-subtitle">{{ item.meta }}</div>
              {% endif %}
            </div>
            <div class="mobile-list-item-chevron"></div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    {# Empty state #}
    <div class="mobile-empty">
      <div class="mobile-empty-icon">🏠</div>
      <div class="mobile-empty-title">Nothing here yet</div>
      <p class="mobile-empty-text">Content you create or follow will appear here.</p>
      <a href="/search" class="mobile-btn mobile-btn-primary" style="margin-top:8px">Explore</a>
    </div>
  {% endif %}

  {# ── Quick Actions Grid ── #}
  {% if quick_actions is defined and quick_actions is not empty %}
    <p class="mobile-list-label">Quick Actions</p>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding-inline:16px;margin-bottom:24px">
      {% for action in quick_actions %}
        <a href="{{ action.url }}" style="display:flex;flex-direction:column;align-items:center;gap:6px;
                                          text-decoration:none;color:var(--pd-text)">
          <div style="width:52px;height:52px;border-radius:14px;
                      background:color-mix(in srgb,var(--pd-primary) 10%,transparent);
                      display:flex;align-items:center;justify-content:center;font-size:22px">
            {{ action.icon|default('⚡') }}
          </div>
          <span style="font-size:11px;font-weight:500;text-align:center;color:var(--pd-text-secondary)">
            {{ action.label }}
          </span>
        </a>
      {% endfor %}
    </div>
  {% endif %}

{% endblock %}