{% extends '@stockflow/layout.twig' %}

{% block content %}
<div class="heading"><div><div class="eyebrow">Payment management</div><h1>Reconcile gateway payment</h1><p class="sub">Order payment #{{ payment.id }} · {{ payment.provider|replace({'_':' '})|title }} · {{ payment.display_amount }} {{ payment.currency_code }}</p></div><div class="heading-actions"><a class="button" href="/stockflow/orders/view?id={{ payment.order_id }}">Cancel</a></div></div>
<section class="panel form-panel" style="margin-top:17px"><p>Use this only after checking the gateway dashboard and confirming the full transaction was captured or settled. This action records the transaction ID, confirms the order, and decrements reserved stock.</p>{{ form_html|raw }}</section>
{% endblock %}
