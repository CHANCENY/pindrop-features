{% extends '@stockflow/layout.twig' %}

{% block content %}
<div class="heading">
    <div><div class="eyebrow">Store setup</div><h1>Payment methods</h1><p class="sub">Discover supported gateways from Stockflow's payments.yml and configure their availability.</p></div>
</div>
{% if not encryption_key_configured %}
<section class="panel" style="margin-top:17px"><div class="kicker">Server setup required</div><p class="sub">Set PAYMENT_CONFIG_ENCRYPTION_KEY in the server environment before saving gateway credentials. Credentials are encrypted before being stored.</p></section>
{% endif %}
<section class="panel" style="margin-top:17px">
    <div class="panel-head"><div><div class="kicker">Payment providers</div><h2>Available methods</h2></div><span class="metric-label">{{ payment_methods|length }} discovered</span></div>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th>Method</th><th>Supported currency</th><th>Configuration</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
        {% for method in payment_methods %}
            <tr>
                <td><strong>{{ method.label }}</strong><div class="mono">{{ method.id }}</div></td>
                <td>{{ method.currencies|join(', ') }}</td>
                <td><span class="status-pill {{ method.configured ? 'healthy' : 'low' }}">{{ method.configured ? 'Credentials saved' : 'Needs credentials' }}</span></td>
                <td><span class="status-pill {{ method.enabled ? 'healthy' : 'low' }}">{{ method.enabled ? 'Enabled' : 'Disabled' }}</span></td>
                <td><a class="button small" href="/stockflow/payment-methods/configure?id={{ method.id }}">Configure</a></td>
            </tr>
        {% else %}
            <tr><td colspan="5">No payment methods are defined in payments.yml.</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
</section>
<section class="panel" style="margin-top:17px">
    <div class="kicker">Payment flow</div><h2>Gateway adapters</h2>
    <p class="sub">The supported adapters submit payment requests when called by an order checkout integration. This setup page does not itself charge customers or handle provider callbacks.</p>
</section>
{% endblock %}
