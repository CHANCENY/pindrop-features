<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Invoice {{ order.order_number }}</title>
    <style>
        body { margin: 0; padding: 24px 12px; background: #f3f5f8; color: #233044; font-family: Arial, Helvetica, sans-serif; }
        .invoice { width: 100%; max-width: 720px; margin: 0 auto; background: #ffffff; }
        .content { padding: 32px 36px; }
        .muted { color: #697586; }
        .items th { background: #f3f5f8; color: #536174; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; }
        .items th, .items td { padding: 12px 10px; border-bottom: 1px solid #e8ecf1; }
        .items tr:last-child td { border-bottom: 0; }
        @media only screen and (max-width: 600px) {
            body { padding: 0; }
            .content { padding: 24px 18px !important; }
            .invoice-meta, .bill-to { display: block; width: 100% !important; }
        }
    </style>
</head>
<body>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;background:#f3f5f8;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <table role="presentation" class="invoice" width="720" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:720px;border-collapse:collapse;background:#ffffff;border:1px solid #e5e9ef;">
                <tr>
                    <td style="padding:26px 36px;background:#1d3557;color:#ffffff;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                            <tr>
                                <td style="font-size:20px;font-weight:bold;letter-spacing:.02em;">{{ store_name }}</td>
                                <td align="right" style="font-size:12px;color:#d9e3f0;">ORDER INVOICE</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="content" style="padding:32px 36px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                            <tr>
                                <td class="invoice-meta" style="vertical-align:top;">
                                    <div style="font-size:12px;font-weight:bold;letter-spacing:.08em;color:#697586;text-transform:uppercase;">Invoice</div>
                                    <div style="margin-top:7px;font-size:28px;line-height:1.2;font-weight:bold;color:#1d3557;">{{ order.order_number }}</div>
                                    <div class="muted" style="margin-top:9px;font-size:13px;color:#697586;">Issued {{ order.placed_at|default(order.created_at|default('')) }}</div>
                                </td>
                                <td class="bill-to" align="right" style="vertical-align:top;">
                                    <div style="font-size:12px;font-weight:bold;letter-spacing:.08em;color:#697586;text-transform:uppercase;">Bill to</div>
                                    {% if order.billing_address %}
                                        <div style="margin-top:8px;font-size:14px;line-height:1.6;color:#233044;">
                                            <strong>{{ order.billing_address.first_name }} {{ order.billing_address.last_name }}</strong><br>
                                            {{ order.email }}<br>
                                            {{ order.billing_address.line1 }}{% if order.billing_address.line2 %}<br>{{ order.billing_address.line2 }}{% endif %}<br>
                                            {{ order.billing_address.city }}{% if order.billing_address.postal_code %}, {{ order.billing_address.postal_code }}{% endif %}<br>
                                            {{ order.billing_address.country_code }}
                                            {% if order.billing_address.phone %}<br>{{ order.billing_address.phone }}{% endif %}
                                        </div>
                                    {% else %}
                                        <div style="margin-top:8px;font-size:14px;line-height:1.6;color:#233044;">
                                            <strong>{{ order.email }}</strong>
                                        </div>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>

                        <p style="margin:26px 0 20px;font-size:14px;line-height:1.6;color:#536174;">
                            Thank you for your order. Your invoice is included below and attached as a PDF for your records.
                        </p>

                        <table class="items" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:13px;">
                            <thead>
                                <tr>
                                    <th align="left" style="padding:12px 10px;background:#f3f5f8;color:#536174;font-size:11px;text-transform:uppercase;letter-spacing:.06em;">Item</th>
                                    <th align="left" style="padding:12px 10px;background:#f3f5f8;color:#536174;font-size:11px;text-transform:uppercase;letter-spacing:.06em;">SKU</th>
                                    <th align="center" style="padding:12px 10px;background:#f3f5f8;color:#536174;font-size:11px;text-transform:uppercase;letter-spacing:.06em;">Qty</th>
                                    <th align="right" style="padding:12px 10px;background:#f3f5f8;color:#536174;font-size:11px;text-transform:uppercase;letter-spacing:.06em;">Unit price</th>
                                    <th align="right" style="padding:12px 10px;background:#f3f5f8;color:#536174;font-size:11px;text-transform:uppercase;letter-spacing:.06em;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in order.items %}
                                    <tr>
                                        <td style="padding:12px 10px;border-bottom:1px solid #e8ecf1;color:#233044;font-weight:bold;">{{ item.product_name }}</td>
                                        <td style="padding:12px 10px;border-bottom:1px solid #e8ecf1;color:#697586;">{{ item.sku }}</td>
                                        <td align="center" style="padding:12px 10px;border-bottom:1px solid #e8ecf1;color:#233044;">{{ item.quantity }}</td>
                                        <td align="right" style="padding:12px 10px;border-bottom:1px solid #e8ecf1;white-space:nowrap;color:#233044;">{{ item.display_unit_price }} {{ order.currency_code }}</td>
                                        <td align="right" style="padding:12px 10px;border-bottom:1px solid #e8ecf1;white-space:nowrap;color:#233044;font-weight:bold;">{{ item.display_line_total }} {{ order.currency_code }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5" style="padding:16px 10px;color:#697586;">No items recorded for this order.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>

                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;border-collapse:collapse;">
                            <tr>
                                <td style="width:55%;"></td>
                                <td style="width:45%;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:13px;">
                                        <tr>
                                            <td style="padding:6px 0;color:#697586;">Subtotal</td>
                                            <td align="right" style="padding:6px 0;color:#233044;white-space:nowrap;">{{ order.display_subtotal }} {{ order.currency_code }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 0;color:#697586;">Discount</td>
                                            <td align="right" style="padding:6px 0;color:#233044;white-space:nowrap;">{{ order.display_discount_total }} {{ order.currency_code }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 0;color:#697586;">Shipping</td>
                                            <td align="right" style="padding:6px 0;color:#233044;white-space:nowrap;">{{ order.display_shipping_total }} {{ order.currency_code }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 0;border-bottom:1px solid #e8ecf1;color:#697586;">Tax</td>
                                            <td align="right" style="padding:6px 0;border-bottom:1px solid #e8ecf1;color:#233044;white-space:nowrap;">{{ order.display_tax_total }} {{ order.currency_code }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:14px 0 5px;font-size:15px;font-weight:bold;color:#1d3557;">Total due</td>
                                            <td align="right" style="padding:14px 0 5px;font-size:17px;font-weight:bold;color:#1d3557;white-space:nowrap;">{{ order.display_grand_total }} {{ order.currency_code }}</td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding:20px 30px;background:#f8f9fb;border-top:1px solid #e8ecf1;font-size:12px;line-height:1.6;color:#697586;">
                        Questions about this invoice? Reply to this email and {{ store_name }} will be happy to help.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
