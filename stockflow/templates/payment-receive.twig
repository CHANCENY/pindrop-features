{% extends '@stockflow/layout.twig' %}

{% block content %}
<div class="heading"><div><div class="eyebrow">Payment management</div><h1>Confirm offline payment</h1><p class="sub">Payment #{{ payment.id }} · {{ payment.display_amount }} {{ payment.currency_code }}</p></div><div class="heading-actions"><a class="button" href="/stockflow/orders/view?id={{ payment.order_id }}">Cancel</a></div></div>
<section class="panel form-panel" style="margin-top:17px"><p>Confirm only after verifying that the full payment was received. This confirms the order and decrements reserved stock.</p>{{ form_html|raw }}</section>
{% endblock %}
