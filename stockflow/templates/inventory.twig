{% extends '@stockflow/layout.twig' %}

{% block content %}
<div class="heading"><div><div class="eyebrow">Live inventory</div><h1>Inventory</h1><p class="sub">Review variant quantities and record stock movements.</p></div><div class="heading-actions"><a class="button primary" href="/stockflow/inventory/adjust">＋ Adjust stock</a></div></div>
<section class="panel" style="margin-top:17px"><div class="panel-head"><div><div class="kicker">Catalog quantity</div><h2>Inventory ledger</h2></div></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>On hand</th><th>Reserved</th><th>Price</th><th>Status</th></tr></thead><tbody>
    {% for item in inventory %}
        <tr><td><div class="product"><div class="thumb">□</div><div><strong>{{ item.product_name }}</strong><span>{{ item.option_label|default('Default variant') }}</span></div></div></td><td><span class="mono">{{ item.sku }}</span></td><td>{{ item.category_name|default('Uncategorized') }}</td><td>{{ item.quantity_on_hand }}</td><td>{{ item.quantity_reserved }}</td><td><b>{{ item.display_price }}</b></td><td><span class="status-pill {{ item.quantity_on_hand <= item.reorder_point ? 'low' : 'healthy' }}">{{ item.quantity_on_hand <= item.reorder_point ? 'Low stock' : 'Healthy' }}</span></td></tr>
    {% else %}<tr><td colspan="7">No inventory records yet. Create a product with its first variant.</td></tr>{% endfor %}
    </tbody></table></div>
</section>
{% endblock %}
