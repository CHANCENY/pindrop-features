<section class="panel form-panel" style="margin-top:17px"><p>Delete pending manual payment #{{ payment.id }} for {{ payment.amount|number_format(2) }} {{ payment.currency_code }}?</p>{{ form_html|raw }}</section>
{% endblock %}
